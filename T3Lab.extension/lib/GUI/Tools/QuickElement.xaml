<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Select Manager - T3Lab"
        Width="1100" Height="700"
        MinWidth="900" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Inter"
        FontSize="12">
    
    <Window.Resources>
        <!-- ═══ T3LAB SHARED STYLES v2 — AUTO-SYNCED, DO NOT EDIT (edit lib/GUI/Resources/WPF_styles.xaml, then run dev/sync_wpf_styles.py) ═══ -->
        <!-- Central Color Brushes (Lumina / T3Lab Terra v2 System) -->
        <SolidColorBrush x:Key="T3SlateBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="T3AccentBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="T3SuccessBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="T3DangerBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="T3WarningBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="T3TextDarkBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="T3TextMutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="T3BorderLightBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="T3BgLightBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="T3LightBlueHighlightBrush" Color="#EBF5FB"/>

        <!-- Sleek Modern Input Field -->
        <Style x:Key="T3InputField" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium Modern GroupBox Card -->
        <Style x:Key="T3PremiumCard" TargetType="GroupBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Card Header -->
                                <Border Grid.Row="0" 
                                        Background="White"
                                        Padding="16,12"
                                        BorderBrush="#F1F5F9"
                                        BorderThickness="0,0,0,1">
                                    <ContentPresenter ContentSource="Header"
                                                      RecognizeAccessKey="True"
                                                      TextBlock.FontSize="12"
                                                      TextBlock.FontWeight="Bold"
                                                      TextBlock.Foreground="#0F172A"/>
                                </Border>
                                <!-- Card Content -->
                                <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top Navigation Tab Style -->
        <Style x:Key="T3TopNavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PRIMARY BUTTON - solid deep slate, white text -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#0F172A"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SECONDARY BUTTON - ghost style, border and text deep slate -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#0F172A"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#0F172A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SUCCESS BUTTON - emerald green -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#10B981"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#047857"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DANGER BUTTON - rose red -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EF4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ACCENT BUTTON - refined blue -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- WINDOW CONTROL BUTTON -->
        <Style x:Key="WinCtrlButton" TargetType="Button">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CLOSE BUTTON - rose red on hover, glyph flips to white -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WinCtrlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ═══ END T3LAB SHARED STYLES ═══ -->
    </Window.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>      <!-- Header -->
            <RowDefinition Height="Auto"/>      <!-- Summary Cards -->
            <RowDefinition Height="*"/>         <!-- Main Content -->
            <RowDefinition Height="Auto"/>      <!-- Action Buttons -->
            <RowDefinition Height="Auto"/>      <!-- Footer -->
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="6" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="🔍 Quick Select Manager" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Find, select, and navigate to any element in your model" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Display:" FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium"/>
                    <ComboBox x:Name="cmbDisplay" Width="150" Height="32" SelectedIndex="0">
                        <ComboBoxItem Content="Active View"/>
                        <ComboBoxItem Content="Entire Project"/>
                        <ComboBoxItem Content="Current Selection"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TOTAL ELEMENTS" FontSize="10" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="txtTotal" Text="0" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="CHECKED" FontSize="10" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="txtChecked" Text="0" FontSize="26" FontWeight="Bold" Foreground="#F59E0B"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="CATEGORIES" FontSize="10" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="txtCategories" Text="0" FontSize="26" FontWeight="Bold" Foreground="#10B981"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="FAMILIES" FontSize="10" Foreground="#64748B" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="txtFamilies" Text="0" FontSize="26" FontWeight="Bold" Foreground="#3B82F6"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Panel - Filters -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Search -->
                    <TextBlock Grid.Row="0" Text="SEARCH" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                    <TextBox Grid.Row="1" x:Name="txtSearch" Style="{StaticResource T3InputField}" Margin="0,0,0,16" FontSize="12" Height="32"/>
                    
                    <!-- Filter by Family/Type -->
                    <TextBlock Grid.Row="2" Text="FILTER BY" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                    <ComboBox Grid.Row="3" x:Name="cmbFilter" Height="32" Margin="0,0,0,16" SelectedIndex="0">
                        <ComboBoxItem Content="All Elements"/>
                        <ComboBoxItem Content="Model Elements"/>
                        <ComboBoxItem Content="Annotation"/>
                        <ComboBoxItem Content="MEP Elements"/>
                        <ComboBoxItem Content="Structural"/>
                    </ComboBox>
                    
                    <!-- Category List -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="CATEGORY" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                        <ListBox Grid.Row="1" x:Name="lstCategories" 
                                 Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                                 SelectionMode="Extended" FontSize="12"/>
                    </Grid>
                </Grid>
            </Border>
            
            <!-- Right Panel - DataGrid -->
            <DataGrid Grid.Column="1" x:Name="dataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      Background="White"
                      BorderBrush="#E2E8F0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9"
                      RowBackground="White"
                      AlternatingRowBackground="#F8FAFC"
                      FontSize="12">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="☐" Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding is_checked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ID" Binding="{Binding element_id}" Width="85" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding category}" Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Family" Binding="{Binding family}" Width="160" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding type_name}" Width="160" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Name/Mark" Binding="{Binding name}" Width="*" MinWidth="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Level" Binding="{Binding level}" Width="100" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        
        <!-- Action Buttons -->
        <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left - Selection buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnCheckAll" Content="Check All" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                    <Button x:Name="btnCheckNone" Content="Uncheck All" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                    <Button x:Name="btnInvert" Content="Invert" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
                
                <!-- Center - Main actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnZoom" Content="🔍 Zoom To" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Width="100"/>
                    <Button x:Name="btnSelect" Content="✓ Select in Model" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Width="140"/>
                    <Button x:Name="btnIsolate" Content="👁 Isolate" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Width="100"/>
                    <Button x:Name="btnShow" Content="📍 Show Element" Style="{StaticResource PrimaryButton}" Width="135"/>
                </StackPanel>
                
                <!-- Right - Refresh -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnRefresh" Content="🔄 Refresh" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Width="95"/>
                    <Button x:Name="btnClose" Content="Close" Style="{StaticResource SecondaryButton}" Width="80"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="💡 Double-click to zoom | Shift+Click for range | Ctrl+Click for multi-select" 
                       FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Copyright © 2026 T3Lab &amp; DQT" 
                       FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
