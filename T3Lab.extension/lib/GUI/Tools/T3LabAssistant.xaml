<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       Title="T3Lab Assistant"
       Width="560" Height="720"
       MinWidth="480" MinHeight="580"
       WindowStartupLocation="CenterScreen"
       ResizeMode="CanResizeWithGrip"
       ShowInTaskbar="True"
       Background="White"
       FontFamily="Inter">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ═══ T3LAB SHARED STYLES v2 — AUTO-SYNCED, DO NOT EDIT (edit lib/GUI/Resources/WPF_styles.xaml, then run dev/sync_wpf_styles.py) ═══ -->
        <!-- PRIMARY BUTTON - teal, white text -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#0F766E"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#115E59"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0B4F4A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AEBFBC"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SECONDARY BUTTON - surface, ink text -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#F6F8F8"/>
            <Setter Property="Foreground"      Value="#1C2B33"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#C7D2D4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6EDEC"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#DDE5E7"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SUCCESS BUTTON - green -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#15803D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#166534"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#14532D"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AEBFBC"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DANGER BUTTON - red -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#991B1B"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AEBFBC"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ACCENT BUTTON - amber highlight -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F59E0B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D97706"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B45309"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AEBFBC"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- WINDOW CONTROL BUTTON -->
        <Style x:Key="WinCtrlButton" TargetType="Button">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#1C2B33"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6EDEC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CLOSE BUTTON - red on hover, glyph flips to white -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WinCtrlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ═══ END T3LAB SHARED STYLES ═══ -->

        <!-- ── Send button style (pill corner radius matching input) ── -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#0F766E"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="0,20,20,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#115E59"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#AEBFBC"/>
                                <Setter Property="Cursor"     Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Attachment chip button ── -->
        <Style x:Key="AttachChipBtn" TargetType="Button">
            <Setter Property="Background"      Value="#F6F8F8"/>
            <Setter Property="Foreground"      Value="#115E59"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#DDE5E7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="0,0,5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"  Value="#E6EDEC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0F766E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Icon-only button (attach) ── -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E6EDEC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>   <!-- Header   -->
            <RowDefinition Height="1"/>    <!-- Separator -->
            <RowDefinition Height="*"/>    <!-- Chat area -->
            <RowDefinition Height="Auto"/> <!-- Input bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             HEADER — T3Lab badge + title
        ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <StackPanel Grid.Column="0" Orientation="Vertical"
                        Margin="16,0,0,0" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="T3Lab" FontSize="11" FontWeight="Bold"
                               Foreground="#0F766E" VerticalAlignment="Bottom"
                               Margin="0,0,6,3"/>
                    <TextBlock Text="Assistant" FontSize="18" FontWeight="Bold"
                               Foreground="#1C2B33"/>
                    <!-- AI / LOCAL status badge -->
                    <Border x:Name="ai_status_badge"
                            CornerRadius="3" Padding="5,2"
                            Margin="8,2,0,0" VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ai_status_text"
                                   FontSize="9" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>
                <Separator Height="1" Background="#DDE5E7" Margin="0,2,0,2"/>
                <TextBlock Text="Chatbox AI cho T3Lab Tools — Tiếng Việt &amp; English"
                           FontSize="10" Foreground="#64748B" FontStyle="Italic"/>
            </StackPanel>

            <!-- Window control buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Top" Margin="0,0,5,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Undo -->
                <Button x:Name="btn_undo"
                        Style="{StaticResource WinCtrlButton}"
                        ToolTip="Hoàn tác (Undo)"
                        Click="undo_clicked"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="↶" FontSize="18" FontWeight="Bold" Foreground="#F59E0B"/>
                </Button>
                <!-- Reset -->
                <Button x:Name="btn_reset_chat"
                        Style="{StaticResource WinCtrlButton}"
                        ToolTip="Làm mới cuộc trò chuyện"
                        Click="reset_chat_clicked"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="↺" FontSize="15" FontWeight="Bold" Foreground="#64748B"/>
                </Button>
                <!-- Minimize -->
                <Button x:Name="btn_minimize"
                        Style="{StaticResource WinCtrlButton}"
                        ToolTip="Minimize" Click="minimize_clicked">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <!-- Close -->
                <Button x:Name="btn_close"
                        Style="{StaticResource CloseButton}"
                        ToolTip="Close" Click="close_clicked">
                    <TextBlock x:Name="close_text" Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Header separator -->
        <Border Grid.Row="1" Background="#DDE5E7"/>

        <!-- ═══════════════════════════════════════════════════════════
             CHAT AREA
        ═══════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" x:Name="chat_scroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="#F6F8F8"
                      Padding="16,12,16,8">
            <StackPanel x:Name="chat_history_panel" Margin="0,0,0,4">

                <!-- Welcome bubble (static, always shown) -->
                <Grid Margin="0,0,60,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- T3 Avatar -->
                    <Border Grid.Column="0" Width="34" Height="34"
                            CornerRadius="17" Background="#0F766E"
                            Margin="0,2,10,0" VerticalAlignment="Top">
                        <TextBlock Text="T3" FontSize="11" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Welcome message bubble -->
                    <Border Grid.Column="1" Background="White"
                            CornerRadius="3,10,10,10"
                            Padding="14,10"
                            BorderBrush="#DDE5E7" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="T3Lab Assistant" FontSize="10" FontWeight="Bold"
                                       Foreground="#0F766E" Margin="0,0,0,5"/>
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#1C2B33"
                                       LineHeight="20"
                                       Text="Xin chào! Tôi là T3Lab Assistant. Tôi có thể:"/>
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock FontSize="12" Foreground="#64748B"
                                           Text="• Mở BatchOut và xuất sheet PDF/DWG/DWF..."/>
                                <TextBlock FontSize="12" Foreground="#64748B" Margin="0,3,0,0"
                                           Text="• Chạy ParaSync, Load Family, và các công cụ khác"/>
                                <TextBlock FontSize="12" Foreground="#64748B" Margin="0,3,0,0"
                                           Text="• Phân tích tài liệu PDF và hình ảnh đính kèm (RAG)"/>
                                <TextBlock FontSize="12" Foreground="#64748B" Margin="0,3,0,0"
                                           Text="• Trả lời câu hỏi về T3Lab và Revit"/>
                            </StackPanel>
                            <Separator Height="1" Background="#DDE5E7" Margin="0,8,0,6"/>
                            <TextBlock FontSize="11" Foreground="#94A3B8" FontStyle="Italic"
                                       Text="Nhập lệnh bằng Tiếng Việt hoặc English — Enter để gửi. 📎 để đính kèm PDF/ảnh."/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════
             INPUT BAR & ACTION CENTER
        ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="#F6F8F8"
                BorderBrush="#DDE5E7" BorderThickness="0,1,0,0"
                Padding="16,8,16,10">
            <StackPanel>

                <!-- ── Suggested Actions Panel ── -->
                <StackPanel x:Name="suggested_actions_container" Margin="0,0,0,8">
                    <TextBlock Text="Suggested Actions" FontSize="10" FontWeight="SemiBold"
                               Foreground="#64748B" Margin="4,0,0,4"/>
                    <WrapPanel x:Name="suggested_actions_panel">
                        <!-- Chips will be added dynamically -->
                    </WrapPanel>
                </StackPanel>

                <!-- ── Attachment preview strip (hidden until files attached) ── -->
                <Border x:Name="attachment_preview_border"
                        Visibility="Collapsed"
                        Background="#F6F8F8"
                        BorderBrush="#DDE5E7" BorderThickness="1"
                        CornerRadius="3"
                        Padding="8,6"
                        Margin="0,0,0,6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="#115E59" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Đính kèm:" FontSize="10" FontWeight="Bold"
                                       Foreground="#115E59" VerticalAlignment="Center"/>
                            <Button x:Name="btn_clear_attachments"
                                    Style="{StaticResource IconButton}"
                                    Click="clear_attachments_clicked"
                                    ToolTip="Xóa tất cả đính kèm"
                                    Margin="6,0,0,0"
                                    Padding="3,1">
                                <TextBlock Text="✕ Xóa tất cả" FontSize="9" Foreground="#DC2626"/>
                            </Button>
                        </StackPanel>
                        <WrapPanel x:Name="attachment_chips_panel"/>
                    </StackPanel>
                </Border>

                <!-- ── Input row ── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>  <!-- Attach button -->
                        <ColumnDefinition Width="*"/>     <!-- Text input -->
                        <ColumnDefinition Width="Auto"/>  <!-- Send button -->
                    </Grid.ColumnDefinitions>

                    <!-- Attach button -->
                    <Button Grid.Column="0" x:Name="btn_attach"
                             Style="{StaticResource IconButton}"
                             Height="38" Width="38"
                             Click="attach_clicked"
                             ToolTip="Đính kèm hình ảnh hoặc PDF">
                        <TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                    Foreground="#1C2B33" VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Text input -->
                    <Border Grid.Column="1"
                            BorderBrush="#C7D2D4" BorderThickness="1,1,0,1"
                            CornerRadius="20,0,0,20" Background="White">
                        <TextBox x:Name="chat_input"
                                  Height="38"
                                  VerticalContentAlignment="Center"
                                  Padding="14,0"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  FontSize="13"
                                  Foreground="#1C2B33"
                                  CaretBrush="#0F766E"
                                  ToolTip="Nhập lệnh Tiếng Việt hoặc English (Enter để gửi)"
                                  KeyDown="input_keydown"/>
                    </Border>

                    <!-- Send button -->
                    <Button Grid.Column="2" x:Name="send_button"
                             Height="38"
                             Style="{StaticResource SendButtonStyle}"
                             Padding="18,0"
                             Click="send_clicked"
                             ToolTip="Gửi (Enter)">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Gửi" VerticalAlignment="Center" FontSize="13"/>
                                <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                            VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>

                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Copyright added automatically -->
        <TextBlock Text="© Copyright by T3Lab" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,8" Foreground="#F59E0B" FontSize="11" IsHitTestVisible="False" Panel.ZIndex="999"/>
    </Grid>
</Window>
