<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="T3Lab - Point Cloud to Wall"
        Width="520" Height="680"
        MinWidth="480" MinHeight="560"
        Background="White"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        FontFamily="Inter">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ═══ T3LAB SHARED STYLES v2 — AUTO-SYNCED, DO NOT EDIT (edit lib/GUI/Resources/WPF_styles.xaml, then run dev/sync_wpf_styles.py) ═══ -->
        <!-- PRIMARY BUTTON - teal, white text -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#0F766E"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#115E59"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0B4F4A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AEBFBC"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SECONDARY BUTTON - surface, ink text -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#F6F8F8"/>
            <Setter Property="Foreground"      Value="#1C2B33"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#C7D2D4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6EDEC"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#DDE5E7"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SUCCESS BUTTON - green -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#15803D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#166534"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#14532D"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AEBFBC"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DANGER BUTTON - red -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#991B1B"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AEBFBC"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ACCENT BUTTON - amber highlight -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F59E0B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D97706"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B45309"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AEBFBC"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- WINDOW CONTROL BUTTON -->
        <Style x:Key="WinCtrlButton" TargetType="Button">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#1C2B33"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6EDEC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CLOSE BUTTON - red on hover, glyph flips to white -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WinCtrlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ═══ END T3LAB SHARED STYLES ═══ -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>    <!-- Row 0: Title bar -->
            <RowDefinition Height="Auto"/>  <!-- Row 1: Detection summary -->
            <RowDefinition Height="Auto"/>  <!-- Row 2: Wall type selection -->
            <RowDefinition Height="Auto"/>  <!-- Row 3: Wall parameters -->
            <RowDefinition Height="Auto"/>  <!-- Row 4: Info tip box -->
            <RowDefinition Height="Auto"/>  <!-- Row 5: Action bar -->
            <RowDefinition Height="Auto"/>  <!-- Row 6: Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══ TITLE BAR ═══ -->
        <Grid Grid.Row="0" Height="64" Background="White">
            <StackPanel Orientation="Vertical" Margin="16,0,0,0" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="T3Lab" FontSize="11" FontWeight="Bold" Foreground="#0F766E"
                               VerticalAlignment="Bottom" Margin="0,0,6,3"/>
                    <TextBlock Text="Point Cloud to Wall" FontSize="18" FontWeight="Bold"
                               Foreground="#1C2B33"/>
                </StackPanel>
                <Separator Height="1" Background="#DDE5E7" Margin="0,2,0,2"/>
                <TextBlock Text="Review detected geometry before generating the wall element"
                           FontSize="10" Foreground="#64748B" FontStyle="Italic"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="btn_minimize" Style="{StaticResource WinCtrlButton}"
                        Click="minimize_button_clicked" ToolTip="Minimize">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Name="btn_maximize" Style="{StaticResource WinCtrlButton}"
                        Click="maximize_button_clicked" ToolTip="Maximize">
                    <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Name="btn_close" Style="{StaticResource CloseButton}"
                        Click="close_button_clicked" ToolTip="Close">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </StackPanel>

            <Border Height="1" VerticalAlignment="Bottom" Background="#DDE5E7"/>
        </Grid>

        <!-- ═══ ROW 1: DETECTION SUMMARY ═══ -->
        <Border Grid.Row="1" Background="#F6F8F8" BorderBrush="#DDE5E7"
                BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Detected Geometry" FontSize="11" FontWeight="SemiBold"
                           Foreground="#64748B" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row A: Thickness -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Thickness:"
                               VerticalAlignment="Center" Foreground="#1C2B33" FontSize="12"/>
                    <TextBlock x:Name="lbl_thickness" Grid.Row="0" Grid.Column="1"
                               Text="250 mm" FontWeight="SemiBold" Foreground="#0F766E"
                               FontSize="14" VerticalAlignment="Center"/>

                    <!-- Row B: Wall Angle -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Wall Angle:"
                               VerticalAlignment="Center" Foreground="#1C2B33" FontSize="12"/>
                    <TextBlock x:Name="lbl_angle" Grid.Row="2" Grid.Column="1"
                               Text="0.00°" Foreground="#1C2B33" FontSize="12"
                               VerticalAlignment="Center"/>

                    <!-- Row C: Snap Status -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Snap Status:"
                               VerticalAlignment="Center" Foreground="#1C2B33" FontSize="12"/>
                    <TextBlock x:Name="lbl_snap" Grid.Row="4" Grid.Column="1"
                               Text="Snapped" Foreground="#15803D" FontSize="12"
                               VerticalAlignment="Center"/>

                    <!-- Row D: Point Count -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Point Count:"
                               VerticalAlignment="Center" Foreground="#1C2B33" FontSize="12"/>
                    <TextBlock x:Name="lbl_points" Grid.Row="6" Grid.Column="1"
                               Text="12,453 pts" Foreground="#64748B" FontSize="12"
                               VerticalAlignment="Center"/>

                    <!-- Row E: Sample Zone -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Sample Zone:"
                               VerticalAlignment="Center" Foreground="#1C2B33" FontSize="12"/>
                    <TextBlock x:Name="lbl_zone" Grid.Row="8" Grid.Column="1"
                               Text="1000 × 1000 mm" Foreground="#64748B" FontSize="12"
                               VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══ ROW 2: WALL TYPE SELECTION ═══ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE5E7"
                BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Wall Type" FontSize="11" FontWeight="SemiBold"
                           Foreground="#64748B" Margin="0,0,0,8"/>
                <ComboBox x:Name="cmb_wall_type" HorizontalAlignment="Stretch"
                          FontFamily="Inter" FontSize="12" Padding="6,4"
                          BorderBrush="#C7D2D4"/>
                <TextBlock x:Name="lbl_type_warning"
                           Text="⚠ No matching type within 20mm tolerance — consider creating a custom type."
                           Foreground="#DC2626" FontSize="11" FontStyle="Italic"
                           Visibility="Collapsed" TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══ ROW 3: WALL PARAMETERS ═══ -->
        <Border Grid.Row="3" Background="White" BorderBrush="#DDE5E7"
                BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Wall Parameters" FontSize="11" FontWeight="SemiBold"
                           Foreground="#64748B" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Base Level -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Base Level:"
                               VerticalAlignment="Center" Foreground="#1C2B33" FontSize="12"/>
                    <ComboBox x:Name="cmb_base_level" Grid.Row="0" Grid.Column="1"
                              FontFamily="Inter" FontSize="12" Padding="6,4"
                              BorderBrush="#C7D2D4"/>

                    <!-- Row 1: Wall Height -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Wall Height (mm):"
                               VerticalAlignment="Center" Foreground="#1C2B33" FontSize="12"/>
                    <TextBox x:Name="txt_height" Grid.Row="2" Grid.Column="1"
                             Text="3000" FontFamily="Inter" FontSize="12"
                             Padding="6,4" BorderBrush="#C7D2D4"/>

                    <!-- Row 2: Structural -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Structural:"
                               VerticalAlignment="Center" Foreground="#1C2B33" FontSize="12"/>
                    <CheckBox x:Name="chk_structural" Grid.Row="4" Grid.Column="1"
                              IsChecked="False" VerticalAlignment="Center"
                              FontFamily="Inter" FontSize="12"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══ ROW 4: INFO TIP BOX ═══ -->
        <Border Grid.Row="4" Margin="16,10,16,10" BorderBrush="#BFDBD7" BorderThickness="1"
                Background="#EFF6F5" CornerRadius="4" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Tip:" FontWeight="Bold" Foreground="#115E59"
                           Margin="0,0,5,0"/>
                <TextBlock TextWrapping="Wrap" Foreground="#1C2B33"
                           Text="The wall centerline was fit via Least-Squares Regression on a 1m × 1m point cloud slice. Adjust Wall Height if the Z-range detection seems incorrect. Snap status shows if the angle was auto-orthogonalized."/>
            </StackPanel>
        </Border>

        <!-- ═══ ROW 5: ACTION BAR ═══ -->
        <Border Grid.Row="5" Background="White" BorderBrush="#DDE5E7"
                BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btn_cancel" Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Click="cancel_clicked" Margin="0,0,8,0"/>
                <Button x:Name="btn_generate" Content="Generate Wall"
                        Style="{StaticResource SuccessButton}"
                        Click="generate_clicked" Padding="20,8" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- ═══ ROW 6: STATUS BAR ═══ -->
        <Border Grid.Row="6" Background="#F6F8F8" BorderBrush="#DDE5E7"
                BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="status_text" Grid.Column="0"
                           FontSize="11" Foreground="#64748B" Text="Ready"/>
                <TextBlock x:Name="status_version" Grid.Column="1"
                           FontSize="11" Foreground="#94A3B8"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Copyright added automatically -->
        <TextBlock Text="© Copyright by T3Lab" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,8" Foreground="#F59E0B" FontSize="11" IsHitTestVisible="False" Panel.ZIndex="999"/>
    </Grid>
</Window>
