<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room to Floor - T3Lab"
        Width="750" Height="700"
        MinWidth="600" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Background="White"
        FontFamily="Inter"
        FontSize="12">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ═══ T3LAB SHARED STYLES v2 — AUTO-SYNCED, DO NOT EDIT (edit lib/GUI/Resources/WPF_styles.xaml, then run dev/sync_wpf_styles.py) ═══ -->
        <!-- PRIMARY BUTTON - teal, white text -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#0F766E"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#115E59"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0B4F4A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AEBFBC"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SECONDARY BUTTON - surface, ink text -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#F6F8F8"/>
            <Setter Property="Foreground"      Value="#1C2B33"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#C7D2D4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6EDEC"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#DDE5E7"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SUCCESS BUTTON - green -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#15803D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#166534"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#14532D"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AEBFBC"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DANGER BUTTON - red -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#991B1B"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AEBFBC"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ACCENT BUTTON - amber highlight -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F59E0B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D97706"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B45309"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AEBFBC"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- WINDOW CONTROL BUTTON -->
        <Style x:Key="WinCtrlButton" TargetType="Button">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#1C2B33"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6EDEC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CLOSE BUTTON - red on hover, glyph flips to white -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WinCtrlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ═══ END T3LAB SHARED STYLES ═══ -->


    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>     <!-- Title bar -->
            <RowDefinition Height="Auto"/>   <!-- Toolbar -->
            <RowDefinition Height="*"/>      <!-- Content -->
            <RowDefinition Height="Auto"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════ TITLE BAR ═══════════════════════════════ -->
        <Grid Grid.Row="0" Background="White" Height="64">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- T3Lab Title + Subtitle -->
            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="16,0,0,0" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="T3Lab" FontSize="11" FontWeight="Bold"
                               Foreground="#0F766E" VerticalAlignment="Bottom" Margin="0,0,6,3"/>
                    <TextBlock Text="Room to Floor" FontSize="18" FontWeight="Bold"
                               Foreground="#1C2B33"/>
                </StackPanel>
                <Separator Height="1" Background="#DDE5E7" Margin="0,2,0,2"/>
                <TextBlock Text="Create architectural floors from room boundaries"
                           FontSize="10" Foreground="#64748B" FontStyle="Italic"/>
            </StackPanel>

            <!-- Window control buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Top" Margin="0,0,5,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="btn_minimize"
                        Style="{StaticResource WinCtrlButton}"
                        ToolTip="Minimize"
                        Click="minimize_button_clicked">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Name="btn_maximize"
                        Style="{StaticResource WinCtrlButton}"
                        ToolTip="Maximize"
                        Click="maximize_button_clicked">
                    <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Name="btn_close"
                        Style="{StaticResource CloseButton}"
                        ToolTip="Close"
                        Click="close_button_clicked">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>

            <Border Height="1" VerticalAlignment="Bottom" Background="#DDE5E7"
                    Grid.ColumnSpan="3"/>
        </Grid>

        <!-- ═══════════════════════════════ TOOLBAR ═══════════════════════════════ -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE5E7" BorderThickness="0,0,0,1" Padding="12,8">
            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="btn_select_all" Content="Select All"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                        Click="select_all_clicked"/>
                <Button x:Name="btn_select_none" Content="Select None"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                        Click="select_none_clicked"/>
                <Rectangle Width="1" Fill="#DDE5E7" Margin="6,2,12,2"/>
                <TextBlock Text="Search Rooms:" VerticalAlignment="Center" Foreground="#64748B"
                           Margin="0,0,6,0"/>
                <TextBox x:Name="txt_search" Width="200" Height="28"
                         VerticalContentAlignment="Center" Padding="6,2"
                         BorderBrush="#C7D2D4" BorderThickness="1"
                         TextChanged="search_changed"/>
            </WrapPanel>
        </Border>

        <!-- ═══════════════════════════════ CONTENT ═══════════════════════════════ -->
        <Grid Grid.Row="2" Margin="12,8,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Room List -->
            <DataGrid x:Name="room_datagrid" Grid.Column="0"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Extended"
                      IsReadOnly="True"
                      Background="White"
                      BorderBrush="#DDE5E7"
                      BorderThickness="1"
                      AlternatingRowBackground="#F6F8F8"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F6F8F8"
                      Margin="0,0,10,0">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F6F8F8"/>
                        <Setter Property="Foreground" Value="#1C2B33"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderBrush" Value="#DDE5E7"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Height" Value="34"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F6F8F8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#D9EBE8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="35"/>
                    <DataGridTextColumn Header="Room Number" Binding="{Binding Number}" Width="100"/>
                    <DataGridTextColumn Header="Room Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Settings Panel -->
            <StackPanel Grid.Column="1">

                <!-- Floor Type Selection -->
                <Border BorderBrush="#DDE5E7" BorderThickness="1" CornerRadius="3"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Floor Settings" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1C2B33" Margin="0,0,0,10"/>

                        <TextBlock Text="Floor Type" FontSize="11"
                                   Foreground="#64748B" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmb_floor_type" Height="28"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="Height Offset (mm)" FontSize="11"
                                   Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox x:Name="txt_offset" Height="26"
                                 Text="0" VerticalContentAlignment="Center"
                                 Padding="6,2" BorderBrush="#C7D2D4"
                                 BorderThickness="1"/>
                    </StackPanel>
                </Border>

                <!-- Placement Options -->
                <Border BorderBrush="#DDE5E7" BorderThickness="1" CornerRadius="3"
                        Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Options" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1C2B33" Margin="0,0,0,8"/>
                        <CheckBox x:Name="chk_structural" Content="Structural Floor"
                                  Margin="0,0,0,6" Foreground="#1C2B33"/>
                        <CheckBox x:Name="chk_room_finish" Content="Use Room Finish Location"
                                  IsChecked="True" Margin="0,0,0,6"
                                  Foreground="#1C2B33"/>
                    </StackPanel>
                </Border>

                <!-- Tip Box -->
                <Border BorderBrush="#0F766E" BorderThickness="1" Background="#F6F8F8"
                        CornerRadius="2" Padding="10">
                    <StackPanel>
                        <TextBlock Text="How it works:" FontWeight="Bold" Foreground="#115E59"
                                   Margin="0,0,0,4" FontSize="11"/>
                        <TextBlock Text="Creates floors following the exact boundary of selected rooms. Useful for tiling, finishes, or slab creation."
                                   Foreground="#1C2B33" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button x:Name="btn_cancel" Content="Cancel"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Click="close_button_clicked" Width="80"/>
                    <Button x:Name="btn_create" Content="Create Floors"
                            Style="{StaticResource SuccessButton}"
                            Click="create_floors_clicked" Width="120"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════ STATUS BAR ═══════════════════════════════ -->
        <Border Grid.Row="3" Background="#F6F8F8" BorderBrush="#DDE5E7"
                BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="status_text" FontSize="11" Foreground="#64748B"
                           Text="Ready"/>
                <TextBlock Grid.Column="1" FontSize="11" Foreground="#64748B"
                           HorizontalAlignment="Right" x:Name="status_count"
                           Text="0 rooms"/>
            </Grid>
        </Border>
    
        <!-- Copyright added automatically -->
        <TextBlock Text="© Copyright by T3Lab" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,8" Foreground="#F59E0B" FontSize="11" IsHitTestVisible="False" Panel.ZIndex="999"/>
    </Grid>
</Window>
