<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Dimension"
        Width="520" Height="820"
        MinWidth="480" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Background="#E4E4E7"
        FontFamily="Hanken Grotesk">

        <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                       ResizeBorderThickness="5"
                       GlassFrameThickness="0"
                       CornerRadius="22"
                       UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ── Section Header ── -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- ── GroupBox override ── -->
        <Style x:Key="SectionGroup" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8,12,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- ═══ T3LAB SHARED STYLES v2 — AUTO-SYNCED, DO NOT EDIT (edit lib/GUI/Resources/WPF_styles.xaml, then run dev/sync_wpf_styles.py) ═══ -->
        <!-- Central Color Brushes (Lumina / T3Lab Terra v2 System) -->
        <SolidColorBrush x:Key="T3SlateBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="T3AccentBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="T3SuccessBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="T3DangerBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="T3WarningBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="T3TextDarkBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="T3TextMutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="T3BorderLightBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="T3BgLightBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="T3LightBlueHighlightBrush" Color="#EBF5FB"/>

        <!-- Sleek Modern Input Field -->
        <Style x:Key="T3InputField" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium Modern GroupBox Card -->
        <Style x:Key="T3PremiumCard" TargetType="GroupBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Card Header -->
                                <Border Grid.Row="0" 
                                        Background="White"
                                        Padding="16,12"
                                        BorderBrush="#F1F5F9"
                                        BorderThickness="0,0,0,1">
                                    <ContentPresenter ContentSource="Header"
                                                      TextBlock.FontSize="12"
                                                      TextBlock.FontWeight="Bold"
                                                      TextBlock.Foreground="#0F172A"/>
                                </Border>
                                <!-- Card Content -->
                                <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top Navigation Tab Style -->
        <Style x:Key="T3TopNavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PRIMARY BUTTON - solid deep slate, white text -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#0F172A"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SECONDARY BUTTON - ghost style, border and text deep slate -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#0F172A"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#0F172A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SUCCESS BUTTON - emerald green -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#10B981"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#047857"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DANGER BUTTON - rose red -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EF4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ACCENT BUTTON - refined blue -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- WINDOW CONTROL BUTTON -->
        <Style x:Key="WinCtrlButton" TargetType="Button">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CLOSE BUTTON - rose red on hover, glyph flips to white -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WinCtrlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ═══ END T3LAB SHARED STYLES ═══ -->


    </Window.Resources>

    
    <Border BorderBrush="#A1A1AA" BorderThickness="1.5" CornerRadius="22" ClipToBounds="True" Background="#E4E4E7">
<Grid>
        <Grid.RowDefinitions>
            <!-- Title bar -->
            <RowDefinition Height="64"/>
            <!-- Main content -->
            <RowDefinition Height="*"/>
            <!-- Action bar -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════ -->
        <!--  TITLE BAR                                      -->
        <!-- ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Background="White" Height="64">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo + Brand + Tool name + Subtitle -->
            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="16,0,0,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">



                <!-- Brand + Tool name + Subtitle stacked -->
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="T3Lab"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,8,2"/>
                        <TextBlock Text="Auto Dimension"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#0F172A"/>
                    </StackPanel>
                    <Separator Height="1" Background="#E2E8F0" Margin="0,2,0,2"/>
                    <TextBlock Text="Shop drawing string dimensions — walls, columns, doors, lifts &amp; grids"
                               FontSize="10" Foreground="#64748B" FontStyle="Italic"/>
                </StackPanel>
            </StackPanel>

            <!-- Window control buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="0,0,5,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">

                <!-- Minimize -->
                <Button x:Name="btn_minimize"
                        Style="{StaticResource WinCtrlButton}"
                        ToolTip="Minimize"
                        Click="minimize_button_clicked">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>

                <!-- Maximize / Restore -->
                <Button x:Name="btn_maximize"
                        Style="{StaticResource WinCtrlButton}"
                        ToolTip="Maximize"
                        Click="maximize_button_clicked">
                    <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>

                <!-- Close -->
                <Button x:Name="btn_close_chrome"
                        Style="{StaticResource CloseButton}"
                        ToolTip="Close"
                        Click="close_button_clicked">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver,
                                                 RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>
            <Border Height="1" VerticalAlignment="Bottom" Background="#E2E8F0" Grid.ColumnSpan="3"/>
        </Grid>

        <!-- ═══════════════════════════════════════════════ -->
        <!--  MAIN CONTENT                                   -->
        <!-- ═══════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0">
            <StackPanel Margin="18,14,18,10">

                <!-- ─────────────────────────────────────── -->
                <!--  Section: Plan Views                    -->
                <!-- ─────────────────────────────────────── -->
                <GroupBox Header="Plan Views"
                          Style="{StaticResource SectionGroup}">
                    <StackPanel>
                        <TextBlock Text="Select views to dimension (leave empty to use active view):"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   Margin="0,0,0,4"/>
                        <ListBox x:Name="lst_views"
                                 Height="90"
                                 SelectionMode="Extended"
                                 BorderBrush="#E2E8F0"
                                 BorderThickness="1"
                                 FontSize="12"
                                 Foreground="#0F172A"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Select All"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="select_all_views_clicked"
                                    Padding="10,4"
                                    FontSize="11"
                                    Margin="0,0,6,0"/>
                            <Button Content="Clear"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="clear_views_clicked"
                                    Padding="10,4"
                                    FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ─────────────────────────────────────── -->
                <!--  Section 0: Checking Mode               -->
                <!-- ─────────────────────────────────────── -->
                <GroupBox Header="Checking Mode"
                          Style="{StaticResource SectionGroup}">
                    <StackPanel>
                        <CheckBox x:Name="chk_checking_mode"
                                  Content="Enable Checking Mode — align to nearest grid only"
                                  IsChecked="False"
                                  FontSize="13"
                                  Foreground="#0F172A"
                                  Margin="0,2,0,6"
                                  Checked="checking_mode_changed"
                                  Unchecked="checking_mode_changed"/>
                        <Grid x:Name="pnl_check_dim_type" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Check dim style:"
                                       FontSize="13"
                                       Foreground="#0F172A"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmb_check_dim_type"
                                      Grid.Column="1"
                                      Height="28"
                                      FontSize="12"
                                      Foreground="#0F172A"
                                      BorderBrush="#CBD5E1"
                                      BorderThickness="1"
                                      VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- ─────────────────────────────────────── -->
                <!--  Section 1: Element Types               -->
                <!-- ─────────────────────────────────────── -->
                <GroupBox Header="Element Types"
                          Style="{StaticResource SectionGroup}">
                    <StackPanel>
                        <CheckBox x:Name="chk_walls"
                                  Content="Walls (from core layer)"
                                  IsChecked="True"
                                  FontSize="13"
                                  Foreground="#0F172A"
                                  Margin="0,4,0,4"/>
                        <CheckBox x:Name="chk_struct_columns"
                                  Content="Structural Columns"
                                  IsChecked="True"
                                  FontSize="13"
                                  Foreground="#0F172A"
                                  Margin="0,4,0,4"/>
                        <CheckBox x:Name="chk_arch_columns"
                                  Content="Architectural Columns"
                                  IsChecked="True"
                                  FontSize="13"
                                  Foreground="#0F172A"
                                  Margin="0,4,0,4"/>
                        <CheckBox x:Name="chk_grids"
                                  Content="Grid-to-Grid Overall Chains"
                                  IsChecked="True"
                                  FontSize="13"
                                  Foreground="#0F172A"
                                  Margin="0,4,0,4"/>
                        <CheckBox x:Name="chk_windows"
                                  Content="Windows (opening width)"
                                  IsChecked="True"
                                  FontSize="13"
                                  Foreground="#0F172A"
                                  Margin="0,4,0,4"/>
                        <CheckBox x:Name="chk_doors"
                                  Content="Doors (opening width)"
                                  IsChecked="True"
                                  FontSize="13"
                                  Foreground="#0F172A"
                                  Margin="0,4,0,4"/>
                        <CheckBox x:Name="chk_lifts"
                                  Content="Lifts / Mechanical Equipment"
                                  IsChecked="True"
                                  FontSize="13"
                                  Foreground="#0F172A"
                                  Margin="0,4,0,0"/>
                        <CheckBox x:Name="chk_facade"
                                  Content="Facade Dimensions  (exterior walls — N / S / E / W)"
                                  IsChecked="False"
                                  FontSize="13"
                                  Foreground="#0F172A"
                                  Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- ─────────────────────────────────────── -->
                <!--  Section 2: Wall Reference Layer        -->
                <!-- ─────────────────────────────────────── -->
                <GroupBox x:Name="grp_wall_layer"
                          Header="Wall Reference Layer"
                          Style="{StaticResource SectionGroup}">
                    <StackPanel IsEnabled="{Binding IsChecked, ElementName=chk_walls}">
                        <TextBlock Text="Dimension walls to:"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,0,0,6"/>
                        <RadioButton x:Name="rad_wall_ext"
                                     Content="Exterior face"
                                     IsChecked="True"
                                     GroupName="WallLayer"
                                     FontSize="13"
                                     Foreground="#0F172A"
                                     Margin="0,3,0,3"/>
                        <RadioButton x:Name="rad_wall_int"
                                     Content="Interior face"
                                     GroupName="WallLayer"
                                     FontSize="13"
                                     Foreground="#0F172A"
                                     Margin="0,3,0,3"/>
                        <RadioButton x:Name="rad_wall_both"
                                     Content="Both faces  (dim string shows wall thickness)"
                                     GroupName="WallLayer"
                                     FontSize="13"
                                     Foreground="#0F172A"
                                     Margin="0,3,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- ─────────────────────────────────────── -->
                <!--  Section 3: Dimension Type              -->
                <!-- ─────────────────────────────────────── -->
                <GroupBox x:Name="grp_dim_type"
                          Header="Linear Dimension Type"
                          Style="{StaticResource SectionGroup}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Linear Dim Style:"
                                   FontSize="13"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center"/>

                        <ComboBox x:Name="cmb_dim_type"
                                  Grid.Column="1"
                                  Height="28"
                                  FontSize="12"
                                  Foreground="#0F172A"
                                  BorderBrush="#CBD5E1"
                                  BorderThickness="1"
                                  VerticalContentAlignment="Center">
                            <!-- Items are populated from code -->
                            <ComboBoxItem Content="Select dimension type..."
                                          IsEnabled="False"
                                          IsSelected="True"
                                          Foreground="#64748B"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <!-- ─────────────────────────────────────── -->
                <!--  Section 4: Dimension Settings          -->
                <!-- ─────────────────────────────────────── -->
                <GroupBox x:Name="grp_dim_settings"
                          Header="Dimension Settings"
                          Style="{StaticResource SectionGroup}">
                    <StackPanel>

                        <!-- Offset Mode row -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Offset mode:"
                                       FontSize="13"
                                       Foreground="#0F172A"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmb_offset_mode"
                                      Grid.Column="1"
                                      Height="28"
                                      FontSize="12"
                                      Foreground="#0F172A"
                                      BorderBrush="#CBD5E1"
                                      BorderThickness="1"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="offset_mode_changed">
                                <ComboBoxItem Content="Single offset" IsSelected="True"/>
                                <ComboBoxItem Content="3-Level auto (L1 / L2 / L3)"/>
                            </ComboBox>
                        </Grid>

                        <!-- Single offset panel -->
                        <Grid x:Name="pnl_single_offset" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Offset distance:"
                                       FontSize="13"
                                       Foreground="#0F172A"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_offset"
                                     Grid.Column="1"
                                     Text="1000"
                                     Height="28"
                                     FontSize="13"
                                     Foreground="#0F172A"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"
                                     VerticalContentAlignment="Center"
                                     Padding="6,0"
                                     Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="mm"
                                       FontSize="13"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 3-Level offsets panel -->
                        <StackPanel x:Name="pnl_3level_offsets"
                                    Visibility="Collapsed"
                                    Margin="0,0,0,8">
                            <!-- L1 -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="L1 — Openings:"
                                           FontSize="13"
                                           Foreground="#0F172A"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="txt_l1"
                                         Grid.Column="1"
                                         Text="500"
                                         Height="28"
                                         FontSize="13"
                                         Foreground="#0F172A"
                                         BorderBrush="#CBD5E1"
                                         BorderThickness="1"
                                         VerticalContentAlignment="Center"
                                         Padding="6,0"
                                         Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2"
                                           Text="mm"
                                           FontSize="13"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <!-- L2 -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="L2 — Columns/Walls:"
                                           FontSize="13"
                                           Foreground="#0F172A"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="txt_l2"
                                         Grid.Column="1"
                                         Text="1000"
                                         Height="28"
                                         FontSize="13"
                                         Foreground="#0F172A"
                                         BorderBrush="#CBD5E1"
                                         BorderThickness="1"
                                         VerticalContentAlignment="Center"
                                         Padding="6,0"
                                         Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2"
                                           Text="mm"
                                           FontSize="13"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <!-- L3 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="L3 — Grid overall:"
                                           FontSize="13"
                                           Foreground="#0F172A"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="txt_l3"
                                         Grid.Column="1"
                                         Text="1500"
                                         Height="28"
                                         FontSize="13"
                                         Foreground="#0F172A"
                                         BorderBrush="#CBD5E1"
                                         BorderThickness="1"
                                         VerticalContentAlignment="Center"
                                         Padding="6,0"
                                         Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2"
                                           Text="mm"
                                           FontSize="13"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Direction row -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Direction:"
                                       FontSize="13"
                                       Foreground="#0F172A"
                                       VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmb_direction"
                                      Grid.Column="1"
                                      Height="28"
                                      FontSize="12"
                                      Foreground="#0F172A"
                                      BorderBrush="#CBD5E1"
                                      BorderThickness="1"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Both X and Y" IsSelected="True"/>
                                <ComboBoxItem Content="X only (above / below)"/>
                                <ComboBoxItem Content="Y only (left / right)"/>
                            </ComboBox>
                        </Grid>

                        <!-- Both sides checkbox -->
                        <CheckBox x:Name="chk_both_sides"
                                  Content="Mirror dim strings to both sides of building"
                                  IsChecked="True"
                                  FontSize="13"
                                  Foreground="#0F172A"
                                  Margin="0,0,0,8"/>

                        <!-- Conflict warning row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="chk_min_seg"
                                      Grid.Column="0"
                                      Content="Warn if segment &lt; "
                                      IsChecked="True"
                                      FontSize="13"
                                      Foreground="#0F172A"
                                      VerticalAlignment="Center"
                                      Margin="0,0,4,0"/>
                            <TextBox x:Name="txt_min_seg"
                                     Grid.Column="1"
                                     Text="300"
                                     Height="28"
                                     Width="60"
                                     FontSize="13"
                                     Foreground="#0F172A"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"
                                     VerticalContentAlignment="Center"
                                     HorizontalAlignment="Left"
                                     Padding="6,0"
                                     Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="mm"
                                       FontSize="13"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Facade offset -->
                        <Grid Margin="0,10,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Facade offset:"
                                       FontSize="13"
                                       Foreground="#0F172A"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_facade_offset"
                                     Grid.Column="1"
                                     Text="1200"
                                     Height="28"
                                     FontSize="13"
                                     Foreground="#0F172A"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"
                                     VerticalContentAlignment="Center"
                                     Padding="6,0"
                                     Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="mm"
                                       FontSize="13"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Facade perimeter tolerance -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Perimeter tol.:"
                                       FontSize="13"
                                       Foreground="#0F172A"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_facade_tol"
                                     Grid.Column="1"
                                     Text="1800"
                                     Height="28"
                                     FontSize="13"
                                     Foreground="#0F172A"
                                     BorderBrush="#CBD5E1"
                                     BorderThickness="1"
                                     VerticalContentAlignment="Center"
                                     Padding="6,0"
                                     Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="2"
                                       Text="mm"
                                       FontSize="13"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"/>
                        </Grid>

                    </StackPanel>
                </GroupBox>

                <!-- ─────────────────────────────────────── -->
                <!--  Info box                               -->
                <!-- ─────────────────────────────────────── -->
                <Border x:Name="brd_info"
                        Background="#F8FAFC"
                        BorderBrush="#0F172A"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,10"
                        Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="#1E293B"
                                   VerticalAlignment="Top"
                                   Margin="0,1,10,0"/>
                        <TextBlock Text="3-level nested dims: ① Inner (L1) — windows + doors per row. ② Mid (L2) — columns &amp; walls per row. ③ Outer (L3) — grid-to-grid overall. Facade mode detects exterior walls (N/S/E/W) and creates dedicated facade string dims with opening references. Multi-view: select views above to process multiple plans in one run."
                                   FontSize="12"
                                   Foreground="#0F172A"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════ -->
        <!--  ACTION BAR                                     -->
        <!-- ═══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Run button -->
                <Button x:Name="btn_run"
                        Grid.Column="0"
                        Content="Run Auto Dimension"
                        Style="{StaticResource PrimaryButton}"
                        Click="run_clicked"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Stretch"/>

                <!-- Close button -->
                <Button x:Name="btn_close"
                        Grid.Column="1"
                        Content="Close"
                        Style="{StaticResource SecondaryButton}"
                        Click="close_clicked"
                        Width="90"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════ -->
        <!--  STATUS BAR                                     -->
        <!-- ═══════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="18,0">
            <TextBlock x:Name="status_text"
                       Text="Ready"
                       FontSize="11"
                       Foreground="#64748B"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Copyright: T3Lab -->
        <Border CornerRadius="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,8">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Right">
                <TextBlock Text="&#169; 2026 T3Lab" FontSize="10" Foreground="#9A9AA2" HorizontalAlignment="Right"/>
                <TextBlock Text="&#169; Copyright by T3Lab" FontSize="10" Foreground="#F59E0B" Margin="0,2,0,0" HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>
</Grid>

    </Border>

</Window>
