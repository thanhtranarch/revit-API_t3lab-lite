                        <StackPanel x:Name="rail_tiles">
                            <ToggleButton Style="{StaticResource T3.Rail.Tile}" Tag="0"
                                          IsChecked="True" ToolTip="Foundations — tokens, type, spacing"
                                          Margin="0,0,0,8" Click="rail_clicked">
                                <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource T3.Rail.Tile}" Tag="1"
                                          ToolTip="Controls — buttons, fields, choice"
                                          Margin="0,0,0,8" Click="rail_clicked">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource T3.Rail.Tile}" Tag="2"
                                          ToolTip="Data — lists, grid, summary"
                                          Margin="0,0,0,8" Click="rail_clicked">
