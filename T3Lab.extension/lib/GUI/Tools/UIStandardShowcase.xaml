                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════ FOOTER ══════════════════ -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource T3.FooterBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource T3.Copyright}"/>
                        <Border Width="1" Height="16" Margin="12,0"
                                Background="{StaticResource T3.Border}" VerticalAlignment="Center"/>
                        <Ellipse Style="{StaticResource T3.Dot}"
                                 Fill="{StaticResource T3.Success.Accent}"/>
                        <TextBlock Text="Reference window — nothing here touches the model"
                                   Style="{StaticResource T3.Body.Secondary}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Close" Style="{StaticResource T3.Button.Ghost}"
                                Margin="0,0,8,0" Click="close_button_clicked"/>
                        <Button Content="Primary action" IsDefault="True"
                                Style="{StaticResource T3.Button.Primary}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════ BODY ══════════════════
                 ScrollViewer chỉ bọc StackPanel. KHÔNG BAO GIỜ bọc list/grid —
                 mất virtualization là treo Revit trên model lớn. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="16">
                <StackPanel>

                    <!-- ─────────── P1 · PARAMETER INPUT FORM · size M ─────────── -->
                    <TextBlock Text="P1 · PARAMETER INPUT FORM · SIZE M"
                               Style="{StaticResource T3.Label}"/>
                    <TextBlock Text="One column. Label above control. Expander hides advanced settings. A callout states the consequence with a number, right above the footer."
                               Style="{StaticResource T3.Caption}" TextWrapping="Wrap" Margin="0,4,0,8"/>

                    <Border Style="{StaticResource T3.Panel}" Padding="0"
                            HorizontalAlignment="Left" Width="560" Margin="0,0,0,32">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource T3.TitleBar}">
                                <Grid>
                                    <TextBlock Text="Renumber Sheets" Style="{StaticResource T3.Title}"
                                               HorizontalAlignment="Left"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource T3.TextSecondary}"/>
                                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource T3.TextSecondary}"/>
                                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource T3.TextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border DockPanel.Dock="Bottom" Style="{StaticResource T3.FooterBar}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource T3.Dot}"
                                                 Fill="{StaticResource T3.Success.Accent}"/>
                                        <TextBlock Text="Ready · 245 sheets in scope"
                                                   Style="{StaticResource T3.Body.Secondary}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Cancel" Style="{StaticResource T3.Button.Secondary}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="Renumber" Style="{StaticResource T3.Button.Primary}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Margin="16">
                                <TextBlock Text="TARGET" Style="{StaticResource T3.Label}"/>
                                <Separator Style="{StaticResource T3.Rule}" Margin="0,4,0,12"/>

                                <TextBlock Text="SHEET SET" Style="{StaticResource T3.Label}" Margin="0,0,0,4"/>
                                <ComboBox Style="{StaticResource T3.ComboBox}"
                                          ItemContainerStyle="{StaticResource T3.ComboBoxItem}"
                                          SelectedIndex="0" Margin="0,0,0,12">
                                    <ComboBoxItem Content="All sheets in project (245)"/>
                                    <ComboBoxItem Content="Current selection"/>
                                </ComboBox>

                                <TextBlock Text="PREFIX" Style="{StaticResource T3.Label}" Margin="0,0,0,4"/>
                                <TextBox Text="A-1" Style="{StaticResource T3.TextBox}" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="START AT" Style="{StaticResource T3.Label}" Margin="0,0,0,4"/>
                                        <TextBox Text="01" Style="{StaticResource T3.TextBox.Mono}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="STEP" Style="{StaticResource T3.Label}" Margin="0,0,0,4"/>
                                        <TextBox Text="1" Style="{StaticResource T3.TextBox.Mono}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="PAD TO" Style="{StaticResource T3.Label}" Margin="0,0,0,4"/>
                                        <TextBox Text="2 digits" Style="{StaticResource T3.TextBox.Mono}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="OPTIONS" Style="{StaticResource T3.Label}" Margin="0,12,0,0"/>
                                <Separator Style="{StaticResource T3.Rule}" Margin="0,4,0,12"/>
                                <CheckBox Content="Skip sheets already matching the pattern"
                                          Style="{StaticResource T3.CheckBox}" IsChecked="True" Margin="0,0,0,8"/>
                                <CheckBox Content="Write a rollback log to the project folder"
                                          Style="{StaticResource T3.CheckBox}" Margin="0,0,0,12"/>

                                <Expander Style="{StaticResource T3.Expander}" Margin="0,0,0,12">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Advanced" Style="{StaticResource T3.BodyStrong}"/>
                                            <TextBlock Text="3 settings, defaults in use"
                                                       Style="{StaticResource T3.Caption}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Margin="0,8,0,0">
                                        <CheckBox Content="Renumber revision sheets too"
                                                  Style="{StaticResource T3.CheckBox}"/>
                                    </StackPanel>
                                </Expander>

                                <Border Style="{StaticResource T3.Callout}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;" Style="{StaticResource T3.Callout.Icon}"
                                                   Foreground="{StaticResource T3.TextSecondary}"/>
                                        <TextBlock TextWrapping="Wrap" Style="{StaticResource T3.Body}">
                                            <Run Text="245 sheets will be renumbered." FontWeight="SemiBold"/>
                                            <Run Text=" Existing numbers are overwritten and cannot be recovered without the rollback log."/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- ─────────── P2 · ELEMENT SELECTION LIST · size M ─────────── -->
                    <TextBlock Text="P2 · ELEMENT SELECTION LIST · SIZE M"
                               Style="{StaticResource T3.Label}"/>
                    <TextBlock Text="Filter pinned above the list. Header row names the columns. The primary carries the count, so the button says what will happen."
                               Style="{StaticResource T3.Caption}" TextWrapping="Wrap" Margin="0,4,0,8"/>

                    <Border Style="{StaticResource T3.Panel}" Padding="0"
                            HorizontalAlignment="Left" Width="640" Margin="0,0,0,32">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource T3.TitleBar}">
                                <TextBlock Text="Select Views to Export" Style="{StaticResource T3.Title}"
                                           HorizontalAlignment="Left"/>
                            </Border>

                            <Border DockPanel.Dock="Bottom" Style="{StaticResource T3.FooterBar}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="4 of 18 selected" Style="{StaticResource T3.BodyStrong}"/>
                                        <TextBlock Text="Shift-click for a range"
                                                   Style="{StaticResource T3.Caption}" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="None" Style="{StaticResource T3.Button.Ghost}" Margin="0,0,8,0"/>
                                        <Button Content="All" Style="{StaticResource T3.Button.Ghost}" Margin="0,0,8,0"/>
                                        <Button Content="Cancel" Style="{StaticResource T3.Button.Secondary}" Margin="0,0,8,0"/>
                                        <Button Content="Export 4" Style="{StaticResource T3.Button.Primary}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Margin="16">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource T3.Search}"
                                             Tag="Filter by name or ID..." Text=""/>
                                    <ComboBox Grid.Column="2" Style="{StaticResource T3.ComboBox}"
                                              ItemContainerStyle="{StaticResource T3.ComboBoxItem}"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="All categories"/>
                                        <ComboBoxItem Content="Floor Plan"/>
                                    </ComboBox>
                                </Grid>

                                <Border Style="{StaticResource T3.ListHeader}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Style="{StaticResource T3.CheckBox}"
                                                  IsThreeState="True" IsChecked="{x:Null}"/>
                                        <TextBlock Grid.Column="1" Text="NAME"
                                                   Style="{StaticResource T3.ListHeader.Label}"/>
                                        <TextBlock Grid.Column="2" Text="CATEGORY"
                                                   Style="{StaticResource T3.ListHeader.Label}"/>
                                        <TextBlock Grid.Column="3" Text="ID"
                                                   Style="{StaticResource T3.ListHeader.Label}"
                                                   TextAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <ListBox Style="{StaticResource T3.ListBox}" Height="208"
                                         SelectionMode="Extended" BorderThickness="0,0,0,1">
                                    <ListBoxItem IsSelected="True">
                                        <Grid Width="576">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Style="{StaticResource T3.CheckBox}" IsChecked="True"/>
                                            <TextBlock Grid.Column="1" Text="01_Plan_Column setting-out"
                                                       Style="{StaticResource T3.Body}"/>
                                            <TextBlock Grid.Column="2" Text="Floor Plan"
                                                       Style="{StaticResource T3.Body.Secondary}"/>
                                            <TextBlock Grid.Column="3" Text="104231"
                                                       Style="{StaticResource T3.Cell.Number}"/>
                                        </Grid>
                                    </ListBoxItem>
                                    <ListBoxItem>
                                        <Grid Width="576">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Style="{StaticResource T3.CheckBox}" IsChecked="True"/>
                                            <TextBlock Grid.Column="1" Text="02_Plan_Column dimensions"
                                                       Style="{StaticResource T3.Body}"/>
                                            <TextBlock Grid.Column="2" Text="Floor Plan"
                                                       Style="{StaticResource T3.Body.Secondary}"/>
                                            <TextBlock Grid.Column="3" Text="104232"
                                                       Style="{StaticResource T3.Cell.Number}"/>
                                        </Grid>
                                    </ListBoxItem>
                                    <ListBoxItem>
                                        <Grid Width="576">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Style="{StaticResource T3.CheckBox}"/>
                                            <TextBlock Grid.Column="1" Text="Detail_Column rebar splice"
                                                       Style="{StaticResource T3.Body.Secondary}"/>
                                            <TextBlock Grid.Column="2" Text="Detail View"
                                                       Style="{StaticResource T3.Body.Secondary}"/>
                                            <TextBlock Grid.Column="3" Text="104235"
                                                       Style="{StaticResource T3.Cell.Number}"/>
                                        </Grid>
                                    </ListBoxItem>
                                    <ListBoxItem>
                                        <Grid Width="576">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Style="{StaticResource T3.CheckBox}" IsChecked="True"/>
                                            <TextBlock Grid.Column="1" Text="3D_Overall perspective"
                                                       Style="{StaticResource T3.Body}"/>
                                            <TextBlock Grid.Column="2" Text="3D View"
                                                       Style="{StaticResource T3.Body.Secondary}"/>
                                            <TextBlock Grid.Column="3" Text="104240"
                                                       Style="{StaticResource T3.Cell.Number}"/>
                                        </Grid>
                                    </ListBoxItem>
                                    <ListBoxItem>
                                        <Grid Width="576">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Style="{StaticResource T3.CheckBox}"/>
                                            <TextBlock Grid.Column="1" Text="Section_Longitudinal section"
                                                       Style="{StaticResource T3.Body.Secondary}"/>
                                            <TextBlock Grid.Column="2" Text="Section"
                                                       Style="{StaticResource T3.Body.Secondary}"/>
                                            <TextBlock Grid.Column="3" Text="104245"
                                                       Style="{StaticResource T3.Cell.Number}"/>
                                        </Grid>
                                    </ListBoxItem>
                                </ListBox>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- ─────────── P3 · PROGRESS & LOG · size M ─────────── -->
                    <TextBlock Text="P3 · PROGRESS &amp; LOG · SIZE M"
                               Style="{StaticResource T3.Label}"/>
                    <TextBlock Text="Phase, n / total, and the item in flight. Severity is in the word, never in the colour alone. The footer says not to close Revit while a transaction is open."
                               Style="{StaticResource T3.Caption}" TextWrapping="Wrap" Margin="0,4,0,8"/>

                    <Border Style="{StaticResource T3.Panel}" Padding="0"
                            HorizontalAlignment="Left" Width="600" Margin="0,0,0,32">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource T3.TitleBar}">
                                <TextBlock Text="Renumbering Sheets" Style="{StaticResource T3.Title}"
                                           HorizontalAlignment="Left"/>
                            </Border>

                            <Border DockPanel.Dock="Bottom" Style="{StaticResource T3.FooterBar}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource T3.Dot}"
                                                 Fill="{StaticResource T3.Progress.Fill}"/>
                                        <TextBlock Text="Running · transaction open, do not close Revit"
                                                   Style="{StaticResource T3.Body.Secondary}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Copy log" Style="{StaticResource T3.Button.Ghost}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="Cancel" Style="{StaticResource T3.Button.Secondary}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Margin="16">
                                <Grid>
                                    <TextBlock Text="Writing sheet numbers" Style="{StaticResource T3.BodyStrong}"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource T3.BodyStrong}">
                                        <Run Text="184" Foreground="{StaticResource T3.Progress.Fill}"/>
                                        <Run Text=" / 245" Foreground="{StaticResource T3.TextSecondary}"/>
                                    </TextBlock>
                                </Grid>

                                <ProgressBar Style="{StaticResource T3.ProgressBar}"
                                             Minimum="0" Maximum="245" Value="184" Margin="0,8,0,4"/>

                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="A-1084 · Pad footing detail M1"
                                               Style="{StaticResource T3.Caption}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="~40s remaining" Style="{StaticResource T3.Caption}"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <TextBlock Text="LOG" Style="{StaticResource T3.Label}" Margin="0,0,0,4"/>
                                <ListBox Style="{StaticResource T3.LogBox}" Height="140">
                                    <ListBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="12:04:31" Style="{StaticResource T3.Log.Time}"/>
                                            <TextBlock Text="Transaction opened" Style="{StaticResource T3.Log.Plain}"/>
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="12:04:31" Style="{StaticResource T3.Log.Time}"/>
                                            <TextBlock Text="Collected 245 sheets" Style="{StaticResource T3.Log.Plain}"/>
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="12:04:32" Style="{StaticResource T3.Log.Time}"/>
                                            <TextBlock Text="A-1001 → A-101   ok" Style="{StaticResource T3.Log.Ok}"/>
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="12:04:33" Style="{StaticResource T3.Log.Time}"/>
                                            <TextBlock Text="A-1003   skipped, already matches"
                                                       Style="{StaticResource T3.Log.Skipped}"/>
                                        </StackPanel>
                                    </ListBoxItem>
                                    <ListBoxItem>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="12:04:34" Style="{StaticResource T3.Log.Time}"/>
                                            <TextBlock Text="A-1005   failed, sheet is checked out by TCB"
                                                       Style="{StaticResource T3.Log.Failed}"/>
                                        </StackPanel>
                                    </ListBoxItem>
                                </ListBox>

                                <Grid Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Ellipse Style="{StaticResource T3.Dot}"
                                                 Fill="{StaticResource T3.Success.Accent}"/>
                                        <TextBlock Text="176 ok" Style="{StaticResource T3.Tally}"/>
                                        <Ellipse Style="{StaticResource T3.Dot}"
                                                 Fill="{StaticResource T3.Warning.Accent}"/>
                                        <TextBlock Text="6 skipped" Style="{StaticResource T3.Tally}"/>
                                        <Ellipse Style="{StaticResource T3.Dot}"
                                                 Fill="{StaticResource T3.Danger.Accent}"/>
                                        <TextBlock Text="2 failed" Style="{StaticResource T3.Tally}"/>
                                    </StackPanel>
                                    <CheckBox Content="Auto-scroll" Style="{StaticResource T3.CheckBox}"
                                              IsChecked="True" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- ─────────── P4 · RESULTS TABLE · size L ─────────── -->
                    <TextBlock Text="P4 · RESULTS TABLE · SIZE L"
                               Style="{StaticResource T3.Label}"/>
                    <TextBlock Text="Summary strip, chip filters, one grid. Exactly one column is Width=&quot;*&quot; (the name); everything else is fixed px. The primary sends the user back to Revit."
                               Style="{StaticResource T3.Caption}" TextWrapping="Wrap" Margin="0,4,0,8"/>

                    <Border Style="{StaticResource T3.Panel}" Padding="0" Margin="0,0,0,32">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource T3.TitleBar}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Compliance Reviewer" Style="{StaticResource T3.Title}"/>
                                    <TextBlock Text="FJX_WH · Revit 2026 · run 12:04"
                                               Style="{StaticResource T3.Body.Secondary}" Margin="12,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border DockPanel.Dock="Bottom" Style="{StaticResource T3.FooterBar}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource T3.Dot}"
                                                 Fill="{StaticResource T3.Warning.Accent}"/>
                                        <TextBlock Text="47 views need attention · 1 selected"
                                                   Style="{StaticResource T3.Body.Secondary}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Copy IDs" Style="{StaticResource T3.Button.Ghost}" Margin="0,0,8,0"/>
                                        <Button Content="Export CSV" Style="{StaticResource T3.Button.Secondary}" Margin="0,0,8,0"/>
                                        <Button Content="Close" Style="{StaticResource T3.Button.Secondary}" Margin="0,0,8,0"/>
                                        <Button Content="Select in Revit" Style="{StaticResource T3.Button.Primary}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="280"/>
                                </Grid.RowDefinitions>

                                <!-- Summary strip: số trên, nhãn dưới, chia bằng rule 1px -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CHECKED" Style="{StaticResource T3.Label}"/>
                                        <TextBlock Text="245" Style="{StaticResource T3.Display}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="1" Margin="24,0"
                                            Background="{StaticResource T3.Border}"/>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="COMPLIANT" Style="{StaticResource T3.Label}"/>
                                        <TextBlock Text="198" Style="{StaticResource T3.Display}"
                                                   Foreground="{StaticResource T3.Success.Text}"/>
                                    </StackPanel>
                                    <Border Grid.Column="3" Width="1" Margin="24,0"
                                            Background="{StaticResource T3.Border}"/>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="NEEDS REVIEW" Style="{StaticResource T3.Label}"/>
                                        <TextBlock Text="18" Style="{StaticResource T3.Display}"
                                                   Foreground="{StaticResource T3.Warning.Text}"/>
                                    </StackPanel>
                                    <Border Grid.Column="5" Width="1" Margin="24,0"
                                            Background="{StaticResource T3.Border}"/>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="FAILED" Style="{StaticResource T3.Label}"/>
                                        <TextBlock Text="29" Style="{StaticResource T3.Display}"
                                                   Foreground="{StaticResource T3.Danger.Text}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="8" VerticalAlignment="Center">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Pass rate" Style="{StaticResource T3.Caption}"
                                                       HorizontalAlignment="Left"/>
                                            <TextBlock Text="81%" Style="{StaticResource T3.BodyStrong}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Style="{StaticResource T3.Meter}"
                                                     Minimum="0" Maximum="100" Value="81"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Chip filter + search -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <RadioButton Content="All 245" GroupName="compliance"
                                                     Style="{StaticResource T3.Chip}" IsChecked="True"/>
                                        <RadioButton Content="Compliant 198" GroupName="compliance"
                                                     Style="{StaticResource T3.Chip}"/>
                                        <RadioButton Content="Review 18" GroupName="compliance"
                                                     Style="{StaticResource T3.Chip}"/>
                                        <RadioButton Content="Failed 29" GroupName="compliance"
                                                     Style="{StaticResource T3.Chip}"/>
                                        <TextBox Style="{StaticResource T3.Search}" Tag="Filter..."
                                                 Text="" Width="200" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Sorted by Status, then Name"
                                               Style="{StaticResource T3.Caption}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Grid thật, nạp dữ liệu từ UIShowcaseDialog.py -->
                                <Grid Grid.Row="2">
                                    <DataGrid x:Name="sample_grid" Height="280" Style="{StaticResource T3.DataGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Width="90" Binding="{Binding id}"
                                                                ElementStyle="{StaticResource T3.Cell.Mono}"/>
                                            <DataGridTextColumn Header="VIEW NAME" Width="*" Binding="{Binding name}"/>
                                            <DataGridTextColumn Header="CATEGORY" Width="140" Binding="{Binding category}"/>
                                            <DataGridTextColumn Header="TEMPLATE" Width="150" Binding="{Binding template}"
                                                                ElementStyle="{StaticResource T3.Cell.Muted}"/>
                                            <DataGridTemplateColumn Header="STATUS" Width="170"
                                                                    CellTemplate="{StaticResource T3.StatusPill}"/>
                                            <DataGridTextColumn Header="ISSUES" Width="70" Binding="{Binding issues}"
                                                                ElementStyle="{StaticResource T3.Cell.Number}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="grid_empty" Style="{StaticResource T3.Empty}"
                                               Visibility="Collapsed"
                                               Text="No views checked yet.&#x0a;Open a model and run the checker first."/>
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- ─────────── P5 · CONFIRMATION · size S ─────────── -->
                    <TextBlock Text="P5 · CONFIRMATION · SIZE S"
                               Style="{StaticResource T3.Label}"/>
                    <TextBlock Text="The headline is a question with a number. The destructive button carries the verb and the count — and it is NOT IsDefault; Cancel is. The success variant reuses the same shell in the past tense."
                               Style="{StaticResource T3.Caption}" TextWrapping="Wrap" Margin="0,4,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">

                        <!-- Destructive -->
                        <Border Style="{StaticResource T3.Panel}" Padding="0" Width="440" Margin="0,0,16,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource T3.TitleBar}">
                                    <Grid>
                                        <TextBlock Text="Delete Unused View Templates"
                                                   Style="{StaticResource T3.Title}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource T3.TextSecondary}"/>
                                    </Grid>
                                </Border>
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource T3.FooterBar}">
                                    <Grid>
                                        <CheckBox Content="Don't ask again this session"
                                                  Style="{StaticResource T3.CheckBox}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Cancel" Style="{StaticResource T3.Button.Secondary}"
                                                    Margin="0,0,8,0"/>
                                            <Button Content="Delete 31" Style="{StaticResource T3.Button.Danger}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="16">
                                    <TextBlock Text="Delete 34 view templates?"
                                               Style="{StaticResource T3.Display}" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource T3.Body.Secondary}" TextWrapping="Wrap"
                                               Margin="0,8,0,12">
                                        <Run Text="None of these are assigned to a view or a sheet. Deletion happens in one transaction and"/>
                                        <Run Text="cannot be undone after the next sync." FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <Border Style="{StaticResource T3.Callout.Danger}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource T3.Callout.Icon}"
                                                       Foreground="{StaticResource T3.Danger.Text}"/>
                                            <TextBlock Text="3 templates are checked out by another user and will be skipped."
                                                       TextWrapping="Wrap" Style="{StaticResource T3.Body}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Success -->
                        <Border Style="{StaticResource T3.Panel}" Padding="0" Width="440">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource T3.TitleBar}">
                                    <Grid>
                                        <TextBlock Text="Renumber Sheets" Style="{StaticResource T3.Title}"
                                                   HorizontalAlignment="Left"/>
                                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource T3.TextSecondary}"/>
                                    </Grid>
                                </Border>
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource T3.FooterBar}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                            <Ellipse Style="{StaticResource T3.Dot}"
                                                     Fill="{StaticResource T3.Success.Accent}"/>
                                            <TextBlock Text="Done in 11.4s" Style="{StaticResource T3.Body.Secondary}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Open log" Style="{StaticResource T3.Button.Ghost}"
                                                    Margin="0,0,8,0"/>
                                            <Button Content="Close" Style="{StaticResource T3.Button.Primary}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="16">
                                    <TextBlock Text="239 sheets renumbered."
                                               Style="{StaticResource T3.Display}" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource T3.Body.Secondary}" TextWrapping="Wrap"
                                               Margin="0,8,0,12">
                                        <Run Text="6 sheets already matched the pattern and were skipped. The rollback log is at"/>
                                        <Run Text="...\FJX_WH\_logs\renumber_1204.csv" FontFamily="Consolas"/>
                                    </TextBlock>
                                    <Border Style="{StaticResource T3.Callout.Success}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE73E;" Style="{StaticResource T3.Callout.Icon}"
                                                       Foreground="{StaticResource T3.Success.Text}"/>
                                            <TextBlock Text="Transaction committed. Sync to central to publish the change."
                                                       TextWrapping="Wrap" Style="{StaticResource T3.Body}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
