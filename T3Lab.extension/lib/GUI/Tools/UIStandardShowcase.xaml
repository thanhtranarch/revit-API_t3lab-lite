                                                <TextBlock Text="T3.Title" Style="{StaticResource T3.Caption}" Margin="0,0,0,12"/>
                                                <TextBlock Text="T3.BodyStrong" Style="{StaticResource T3.Caption}" Margin="0,0,0,8"/>
                                                <TextBlock Text="T3.Body" Style="{StaticResource T3.Caption}" Margin="0,0,0,8"/>
