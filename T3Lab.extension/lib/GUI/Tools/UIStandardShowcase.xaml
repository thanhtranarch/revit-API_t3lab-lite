                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="UTILITY" Style="{StaticResource T3.Label}"/>
                                <Separator Style="{StaticResource T3.Rule}" Margin="0,4,0,8"/>
                                <TextBlock Text="The copyright amber is reserved for the footer line. Progress fill is the only warm accent in the body."
                                           Style="{StaticResource T3.Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <WrapPanel Margin="0,0,0,24">
                                    <StackPanel Width="104" Margin="0,0,8,8">
                                        <Border Height="40" CornerRadius="4"
                                                Background="{StaticResource T3.Copyright.Fg}"
                                                BorderBrush="{StaticResource T3.Border}" BorderThickness="1"/>
                                        <TextBlock Text="T3.Copyright.Fg" Style="{StaticResource T3.Caption}"
                                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Width="104" Margin="0,0,8,8">
                                        <Border Height="40" CornerRadius="4"
                                                Background="{StaticResource T3.Progress.Track}"
