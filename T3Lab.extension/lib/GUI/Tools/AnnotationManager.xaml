<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="T3Lab - Annotation Manager"
        Width="1100" Height="780"
        MinWidth="950" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Background="#E4E4E7"
        FontFamily="Hanken Grotesk">

        <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                       ResizeBorderThickness="5"
                       GlassFrameThickness="0"
                       CornerRadius="22"
                       UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- COLOR TOKENS ALIGNED TO V2 STANDARD -->
        <SolidColorBrush x:Key="PrimaryBlue" Color="#0F172A"/>
        <SolidColorBrush x:Key="LightBlueHighlight" Color="#EBF5FB"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BgLight" Color="#F8FAFC"/>
        <!-- ═══ T3LAB SHARED STYLES v2 — AUTO-SYNCED, DO NOT EDIT (edit lib/GUI/Resources/WPF_styles.xaml, then run dev/sync_wpf_styles.py) ═══ -->
        <!-- Central Color Brushes (Lumina / T3Lab Terra v2 System) -->
        <SolidColorBrush x:Key="T3SlateBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="T3AccentBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="T3SuccessBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="T3DangerBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="T3WarningBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="T3TextDarkBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="T3TextMutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="T3BorderLightBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="T3BgLightBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="T3LightBlueHighlightBrush" Color="#EBF5FB"/>

        <!-- Sleek Modern Input Field -->
        <Style x:Key="T3InputField" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium Modern GroupBox Card -->
        <Style x:Key="T3PremiumCard" TargetType="GroupBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Card Header -->
                                <Border Grid.Row="0" 
                                        Background="White"
                                        Padding="16,12"
                                        BorderBrush="#F1F5F9"
                                        BorderThickness="0,0,0,1">
                                    <ContentPresenter ContentSource="Header"
                                                      TextBlock.FontSize="12"
                                                      TextBlock.FontWeight="Bold"
                                                      TextBlock.Foreground="#0F172A"/>
                                </Border>
                                <!-- Card Content -->
                                <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top Navigation Tab Style -->
        <Style x:Key="T3TopNavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PRIMARY BUTTON - solid deep slate, white text -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#0F172A"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SECONDARY BUTTON - ghost style, border and text deep slate -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#0F172A"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#0F172A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SUCCESS BUTTON - emerald green -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#10B981"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#047857"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DANGER BUTTON - rose red -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EF4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ACCENT BUTTON - refined blue -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- WINDOW CONTROL BUTTON -->
        <Style x:Key="WinCtrlButton" TargetType="Button">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CLOSE BUTTON - rose red on hover, glyph flips to white -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WinCtrlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ═══ END T3LAB SHARED STYLES ═══ -->


        <!-- Action / Orange button (legacy key, now amber AccentButton) -->
        <Style x:Key="OrangeButton" TargetType="Button" BasedOn="{StaticResource AccentButton}"/>



        <!-- SIDEBAR LISTBOX ITEM STYLE -->
        <Style x:Key="SidebarListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="contentPresenter" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F4F8"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource LightBlueHighlight}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DATAGRID STYLES -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FBFD"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F4F8"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource LightBlueHighlight}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    
    <Border BorderBrush="#A1A1AA" BorderThickness="1.5" CornerRadius="22" ClipToBounds="True" Background="#E4E4E7">
<Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="66"/>    <!-- Col 0: Sidebar -->
                <ColumnDefinition Width="*"/>     <!-- Col 1: Content -->
            </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>       <!-- Header -->
            <RowDefinition Height="*"/>        <!-- Content -->
            <RowDefinition Height="28"/>       <!-- Footer status -->
        </Grid.RowDefinitions>
            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- COL 0: LEFT SIDEBAR ICON RAIL (all rows)                    -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0" Grid.RowSpan="99"
                    Background="#F4F4F6" BorderBrush="#DCDCE0" BorderThickness="0,0,1,0">
                <Grid Margin="0,16,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Logo -->
                        <RowDefinition Height="Auto"/> <!-- Tab 1 -->
                        <RowDefinition Height="Auto"/> <!-- Tab 2 -->
                        <RowDefinition Height="Auto"/> <!-- Tab 3 -->
                        <RowDefinition Height="*"/>    <!-- Spacer -->
                    </Grid.RowDefinitions>

                    <!-- Logo icon -->
                    <Border Grid.Row="0" Width="42" Height="42" CornerRadius="13"
                            Background="White" BorderBrush="#DCDCE0" BorderThickness="1"
                            HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Path Data="M4 6 h16 M4 10 h12 M4 14 h8 M4 18 h10"
                              Stroke="#18181B" StrokeThickness="1.6" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Tab: Dimensions -->
                    <ToggleButton x:Name="nav_dim" Grid.Row="1"
                                  Style="{StaticResource T3SidebarToggle}"
                                  Margin="0,0,0,8" IsChecked="True"
                                  ToolTip="Dimensions" Click="True">
                        <Path Data="M3 20 H21 M7 20 V8 M17 20 V8 M7 8 H17 M7 14 H17"
                              Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.8" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="17" Height="17" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>
                    <!-- Tab: Text Notes -->
                    <ToggleButton x:Name="nav_txt" Grid.Row="2"
                                  Style="{StaticResource T3SidebarToggle}"
                                  Margin="0,0,0,8"
                                  ToolTip="Text Notes" Click="nav_textnotes_checked">
                        <Path Data="M4 7 h16 M4 12 h16 M4 17 h10 M12 4 H4 V6"
                              Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.8" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="17" Height="17" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>
                    <!-- Tab: Settings -->
                    <ToggleButton x:Name="nav_settings" Grid.Row="3"
                                  Style="{StaticResource T3SidebarToggle}"
                                  Margin="0,0,0,8"
                                  ToolTip="Settings" Click="nav_settings_checked">
                        <Path Data="M12 15 A3 3 0 1 0 12 9 A3 3 0 0 0 12 15 M12 4 V6 M12 18 V20 M4.2 6.2 L5.6 7.6 M18.4 17.8 L19.8 19.2 M4 12 H6 M18 12 H20"
                              Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.8" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="17" Height="17" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>
                </Grid>
            </Border>


        <!-- ═══ HEADER ═══ -->
        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>       <!-- Logo & Title -->
                <ColumnDefinition Width="*"/>          <!-- Spacer / Middle -->
                <ColumnDefinition Width="Auto"/>       <!-- Navigation Tab Buttons + Avatar + Window controls -->
            </Grid.ColumnDefinitions>

            <!-- Bottom Border -->
            <Border Grid.ColumnSpan="3" Height="1" Background="#E2E8F0" VerticalAlignment="Bottom"/>

            <!-- Left: Logo & Title -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="T3Lab" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,6,0" VerticalAlignment="Bottom"/>
                        <TextBlock Text="Annotation Manager" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                    </StackPanel>
                    <Separator Height="1" Background="#E2E8F0" Margin="0,2,0,2"/>
                    <TextBlock Text="Manage dimension types and text notes across the model" FontSize="10" Foreground="#64748B" FontStyle="Italic"/>
                </StackPanel>
            </StackPanel>

            <!-- Right Controls Panel -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Navigation Tabs (RadioButtons styled as tabs) -->

                <!-- Custom Minimize, Maximize, Close Buttons -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,5,0">
                    <Button x:Name="btn_minimize" Style="{StaticResource WinCtrlButton}" ToolTip="Minimize" Click="minimize_button_clicked">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="btn_maximize" Style="{StaticResource WinCtrlButton}" ToolTip="Maximize" Click="maximize_button_clicked">
                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="btn_close" Style="{StaticResource CloseButton}" ToolTip="Close" Click="close_button_clicked">
                        <TextBlock x:Name="close_text" Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ═══ MAIN TAB CONTAINER ═══ -->
        <TabControl x:Name="main_tabs" Grid.Row="1" BorderThickness="0" Background="Transparent">
            <!-- Hide Default Headers of TabControl since we created custom RadioButtons on top -->
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- 1. DIMENSIONS TAB -->
            <TabItem>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>       <!-- Sidebar -->
                        <ColumnDefinition Width="*"/>          <!-- Main Area -->
                    </Grid.ColumnDefinitions>

                    <!-- DIMENSION SIDEBAR -->
                    <Grid Grid.Column="1" Background="White">
                        <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0"/>
                        <Grid Margin="16,16,16,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>       <!-- Radio Buttons -->
                                <RowDefinition Height="Auto"/>       <!-- Search Label -->
                                <RowDefinition Height="Auto"/>       <!-- Sidebar Search TextBox -->
                                <RowDefinition Height="*"/>          <!-- List of Dimension Types -->
                            </Grid.RowDefinitions>

                            <!-- Radio buttons for sub-mode selection -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <RadioButton x:Name="rb_dim_inst" Content="Find Dimensions (search instances)" IsChecked="True" FontSize="12" Foreground="{StaticResource TextDark}" Margin="0,0,0,8" Checked="dim_submode"/>
                                <RadioButton x:Name="rb_dim_type" Content="Find Types (rename inline)" FontSize="12" Foreground="{StaticResource TextDark}" Checked="dim_submode"/>
                            </StackPanel>

                            <!-- Search input label -->
                            <TextBlock x:Name="dim_lbl" Grid.Row="1" Text="Type name:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,6"/>

                            <!-- Sidebar Search TextBox -->
                            <Border Grid.Row="2" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Height="32" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,6,0"/>
                                    <TextBox x:Name="dim_sidebar_search" Grid.Column="2" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="12"/>
                                    <TextBlock x:Name="dim_sidebar_placeholder" Grid.Column="2" IsHitTestVisible="False" Text="Search" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- List of unique type names -->
                            <ListBox x:Name="lb_dim_types" Grid.Row="3" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </Grid>
                    </Grid>

                    <!-- DIMENSION MAIN CONTENT AREA -->
                    <Grid Grid.Column="2" Margin="20,16,20,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>       <!-- Search Row -->
                            <RowDefinition Height="*"/>          <!-- DataGrid -->
                            <RowDefinition Height="Auto"/>       <!-- Bottom Action Buttons -->
                            <RowDefinition Height="Auto"/>       <!-- Auto-Rename Card -->
                        </Grid.RowDefinitions>

                        <!-- Search and Filter Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Search box -->
                            <Border Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Background="White" Height="36">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Search icon -->
                                    <TextBlock Grid.Column="1" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                    <!-- Keyword TextBox -->
                                    <TextBox x:Name="dim_kw" Grid.Column="2" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13"/>
                                    <!-- Placeholder text -->
                                    <TextBlock x:Name="dim_kw_placeholder" Grid.Column="2" IsHitTestVisible="False" Text="Search annotations..." FontSize="13" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Advanced Filters Button -->
                            <Button x:Name="btn_dim_advanced_filters" Grid.Column="2" Height="36" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Advanced Filters" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="2" Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Quick Refresh -->
                            <Button Grid.Column="3" Content="⟳" ToolTip="Refresh List" Height="36" Width="36" FontSize="14" FontWeight="Bold" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="dim_refresh"/>
                        </Grid>

                        <!-- Results DataGrid (With explicitly declared modern columns) -->
                        <DataGrid x:Name="dg_dim" Grid.Row="1" SelectionMode="Extended" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40" IsReadOnly="False">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <CheckBox Click="dim_header_select_all_clicked"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*" IsReadOnly="False"/>
                                <DataGridTextColumn Header="VIEW / DETAILS" Binding="{Binding Details}" Width="1.8*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="COUNT" Binding="{Binding Count}" Width="70" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="STATUS" Width="90" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Resources>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="Foreground" Value="#117A65"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Unused">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="Background" Value="#E8F8F5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Unused">
                                                                <Setter Property="Background" Value="#FEF5E7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Resources>
                                                <TextBlock Text="{Binding Status}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Parameters Columns (Hidden by default, shown in Find Types mode) -->
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="70" IsReadOnly="True" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="Font" Binding="{Binding Font}" Width="90" IsReadOnly="True" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="Background" Binding="{Binding Background}" Width="90" IsReadOnly="True" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="90" IsReadOnly="True" Visibility="Collapsed"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- DataGrid Action Buttons -->
                        <Grid Grid.Row="2" Margin="0,10,0,12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button x:Name="btn_dim_jump" Content="Jump to View" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="dim_jump" Width="120"/>
                                <Button Content="Delete Selected" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="dim_delete" Width="120"/>
                                <Button Content="Select All" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="dim_select_all" Width="90"/>
                                <Button Content="Clear" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="dim_clear_sel" Width="70"/>
                                <Button x:Name="btn_dim_apply" Content="✔ Apply Changes" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Click="dim_apply" Width="130"/>
                            </StackPanel>
                            <TextBlock x:Name="dim_count" Text="0 found" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Auto-Rename Card -->
                        <Border Grid.Row="3" Background="{StaticResource BgLight}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Auto-Rename All Dimension Types" FontWeight="Bold" Foreground="{StaticResource TextDark}" FontSize="12"/>
                                    <TextBlock FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Generates: LB_[discipline]_[size]_[font]_[factor]_[bg]_[color]_[prefix]_[centerline]_[elevation/top/bottom]_[rounding]"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Rename All" Width="110" Style="{StaticResource OrangeButton}" Click="dim_rename_all" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 2. TEXT NOTES TAB -->
            <TabItem>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>       <!-- Sidebar -->
                        <ColumnDefinition Width="*"/>          <!-- Main Area -->
                    </Grid.ColumnDefinitions>

                    <!-- TEXT NOTES SIDEBAR -->
                    <Grid Grid.Column="1" Background="White">
                        <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0"/>
                        <Grid Margin="16,16,16,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>       <!-- Radio Buttons -->
                                <RowDefinition Height="Auto"/>       <!-- Search Label -->
                                <RowDefinition Height="Auto"/>       <!-- Sidebar Search TextBox -->
                                <RowDefinition Height="*"/>          <!-- List of Text Note Types -->
                            </Grid.RowDefinitions>

                            <!-- Radio buttons for sub-mode selection -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <RadioButton x:Name="rb_notes" Content="Find Notes (search by content)" IsChecked="True" FontSize="12" Foreground="{StaticResource TextDark}" Margin="0,0,0,8" Checked="txt_submode"/>
                                <RadioButton x:Name="rb_types" Content="Find Types (search by type name)" FontSize="12" Foreground="{StaticResource TextDark}" Checked="txt_submode"/>
                            </StackPanel>

                            <!-- Search input label -->
                            <TextBlock x:Name="txt_lbl" Grid.Row="1" Text="Content:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,6"/>

                            <!-- Sidebar Search TextBox -->
                            <Border Grid.Row="2" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Height="32" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,6,0"/>
                                    <TextBox x:Name="txt_sidebar_search" Grid.Column="2" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="12"/>
                                    <TextBlock x:Name="txt_sidebar_placeholder" Grid.Column="2" IsHitTestVisible="False" Text="Search" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- List of unique type names -->
                            <ListBox x:Name="lb_txt_types" Grid.Row="3" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource SidebarListBoxItemStyle}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </Grid>
                    </Grid>

                    <!-- TEXT NOTES MAIN CONTENT AREA -->
                    <Grid Grid.Column="2" Margin="20,16,20,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>       <!-- Search Row -->
                            <RowDefinition Height="*"/>          <!-- DataGrid -->
                            <RowDefinition Height="Auto"/>       <!-- Bottom Action Buttons -->
                            <RowDefinition Height="Auto"/>       <!-- Auto-Rename Card -->
                        </Grid.RowDefinitions>

                        <!-- Search and Filter Row -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Search box -->
                            <Border Grid.Column="1" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Background="White" Height="36">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Search icon -->
                                    <TextBlock Grid.Column="1" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                    <!-- Keyword TextBox -->
                                    <TextBox x:Name="txt_kw" Grid.Column="2" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13"/>
                                    <!-- Placeholder text -->
                                    <TextBlock x:Name="txt_kw_placeholder" Grid.Column="2" IsHitTestVisible="False" Text="Search annotations..." FontSize="13" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Advanced Filters Button -->
                            <Button x:Name="btn_txt_advanced_filters" Grid.Column="2" Height="36" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Advanced Filters" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="2" Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Quick Refresh -->
                            <Button Grid.Column="3" Content="⟳" ToolTip="Refresh List" Height="36" Width="36" FontSize="14" FontWeight="Bold" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="txt_refresh"/>
                        </Grid>

                        <!-- Results DataGrid (With explicitly declared modern columns) -->
                        <DataGrid x:Name="dg_txt" Grid.Row="1" SelectionMode="Extended" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40" IsReadOnly="False">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <CheckBox Click="txt_header_select_all_clicked"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*" IsReadOnly="False"/>
                                <DataGridTextColumn Header="VIEW / DETAILS" Binding="{Binding Details}" Width="1.8*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="140" IsReadOnly="True"/>
                                <DataGridTextColumn Header="COUNT" Binding="{Binding Count}" Width="70" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="STATUS" Width="90" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Resources>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="11"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="Foreground" Value="#117A65"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Unused">
                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="Background" Value="#E8F8F5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Unused">
                                                                <Setter Property="Background" Value="#FEF5E7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Resources>
                                                <TextBlock Text="{Binding Status}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Parameters Columns (Hidden by default, shown in Find Types mode) -->
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="70" IsReadOnly="True" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="Font" Binding="{Binding Font}" Width="90" IsReadOnly="True" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="Background" Binding="{Binding Background}" Width="90" IsReadOnly="True" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="90" IsReadOnly="True" Visibility="Collapsed"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- DataGrid Action Buttons -->
                        <Grid Grid.Row="2" Margin="0,10,0,12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button x:Name="btn_txt_jump" Content="Jump to View" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="txt_jump" Width="120"/>
                                <Button Content="Delete Selected" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="txt_delete" Width="120"/>
                                <Button Content="Select All" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="txt_select_all" Width="90"/>
                                <Button Content="Clear" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="txt_clear_sel" Width="70"/>
                                <Button x:Name="btn_txt_apply" Content="✔ Apply Changes" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Click="txt_apply" Width="130"/>
                            </StackPanel>
                            <TextBlock x:Name="txt_count" Text="0 found" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Auto-Rename Card -->
                        <Border Grid.Row="3" Background="{StaticResource BgLight}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="6" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Auto-Rename All Text Note Types" FontWeight="Bold" Foreground="{StaticResource TextDark}" FontSize="12"/>
                                    <TextBlock FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Generates: LB_[discipline]_[size]_[font]_[factor]_[bg]_[color]_[border]_[B/U/I]"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Rename All" Width="110" Style="{StaticResource OrangeButton}" Click="txt_rename_all" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 3. SETTINGS TAB -->
            <TabItem>
                <Grid Margin="24,24,24,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Card: General Preferences -->
                    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="General Preferences" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                                <TextBlock Text="Configure behavior settings for Annotation Manager" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Setting Toggles -->
                            <CheckBox Grid.Row="2" Content="Auto-select matching elements in view when clicking row" FontSize="13" Foreground="{StaticResource TextDark}" IsChecked="True"/>
                            <CheckBox Grid.Row="4" Content="Include annotations inside groups in search results" FontSize="13" Foreground="{StaticResource TextDark}" IsChecked="False"/>
                            <CheckBox Grid.Row="6" Content="Prompt for confirmation before batch deleting elements" FontSize="13" Foreground="{StaticResource TextDark}" IsChecked="True"/>
                        </Grid>
                    </Border>

                    <!-- Right Card: About & Info -->
                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="12,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="About T3Lab Annotation Suite" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                                <TextBlock Text="Unified management for Revit drafting elements" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Branding Details -->
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Annotation Manager" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                <TextBlock Text="Version 1.0.1" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                <TextBlock Text="Author: Tran Tien Thanh" FontSize="12" Foreground="{StaticResource TextDark}" Margin="0,8,0,0"/>
                                <TextBlock Text="Contact: trantienthanh909@gmail.com" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>

                            <!-- Info Box -->
                            <Border Grid.Row="4" Background="{StaticResource LightBlueHighlight}" CornerRadius="6" Padding="12">
                                <TextBlock Text="This utility combines multiple annotation control panels into a unified tool, optimizing your Revit models by standardizing text, cleaning unused styles, and offering rapid auto-renaming of DimensionTypes and TextNoteTypes based on physical parameters."
                                           TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{StaticResource PrimaryBlue}"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ═══ FOOTER STATUS BAR ═══ -->
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="status" Grid.Column="1" FontSize="11" Foreground="{StaticResource TextMuted}" Text="Ready." VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Mandatory Copyright Compliance Footer (Foreground="#F59E0B", FontSize="11", IsHitTestVisible="False") -->

        <!-- Copyright: T3Lab -->
        <Border CornerRadius="10" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,8">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Right">
                <TextBlock Text="&#169; 2026 T3Lab" FontSize="10" Foreground="#9A9AA2" HorizontalAlignment="Right"/>
                <TextBlock Text="&#169; Copyright by T3Lab" FontSize="10" Foreground="#F59E0B" Margin="0,2,0,0" HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>
</Grid>

    </Border>

</Window>
