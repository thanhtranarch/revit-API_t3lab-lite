<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LLMs Setting" Width="500" Height="720"
        MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Background="#E4E4E7"
        FontFamily="Hanken Grotesk">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                       ResizeBorderThickness="5"
                       GlassFrameThickness="0"
                       CornerRadius="22"
                       UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ═══ T3LAB SHARED STYLES v2 — AUTO-SYNCED, DO NOT EDIT (edit lib/GUI/Resources/WPF_styles.xaml, then run dev/sync_wpf_styles.py) ═══ -->
        <!-- Central Color Brushes (Lumina / T3Lab Standard System) -->
        <SolidColorBrush x:Key="T3PrimaryInkBrush" Color="#18181B"/>
        <SolidColorBrush x:Key="T3PrimaryTextBrush" Color="#27272A"/>
        <SolidColorBrush x:Key="T3SecondaryTextBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="T3TertiaryTextBrush" Color="#71717A"/>
        <SolidColorBrush x:Key="T3DisabledBorderBrush" Color="#9A9AA2"/>
        <SolidColorBrush x:Key="T3MainAppBgBrush" Color="#E4E4E7"/>
        <SolidColorBrush x:Key="T3ComponentBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="T3InputFieldBgBrush" Color="#F4F4F6"/>
        
        <!-- Semantic & Status Brushes -->
        <SolidColorBrush x:Key="T3SuccessBgBrush" Color="#EAF8F0"/>
        <SolidColorBrush x:Key="T3SuccessTextBrush" Color="#157038"/>
        <SolidColorBrush x:Key="T3SuccessBorderBrush" Color="#09734B"/>
        <SolidColorBrush x:Key="T3SuccessAccentBrush" Color="#0B8A5A"/>
        
        <SolidColorBrush x:Key="T3WarningBgBrush" Color="#FFF6E6"/>
        <SolidColorBrush x:Key="T3WarningTextBrush" Color="#8A6308"/>
        <SolidColorBrush x:Key="T3WarningAccentBrush" Color="#F5CE5A"/>
        
        <SolidColorBrush x:Key="T3DangerBgBrush" Color="#FDECEC"/>
        <SolidColorBrush x:Key="T3DangerTextBrush" Color="#D23B3B"/>
        <SolidColorBrush x:Key="T3DangerAccentBrush" Color="#F87171"/>
        
        <SolidColorBrush x:Key="T3ProgressActionBrush" Color="#C2410C"/>

        <!-- TERTIARY BUTTON - soft gray background, dark text -->
        <Style x:Key="TertiaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#ECECEF"/>
            <Setter Property="Foreground"      Value="#27272A"/>
            <Setter Property="Padding"         Value="12,5"/>
            <Setter Property="FontSize"        Value="13.5"/>
            <Setter Property="FontFamily"      Value="Hanken Grotesk"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E2E6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#ECECEF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F4F4F6"/>
                    <Setter Property="Foreground" Value="#9A9AA2"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sleek Modern ComboBox -->
        <Style x:Key="T3ComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#18181B"/>
            <Setter Property="BorderBrush" Value="#E6E6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Hanken Grotesk"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="13">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Content -->
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"/>
                                                      
                                    <!-- Toggle Button (Arrow) -->
                                    <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    
                                    <!-- Arrow Icon -->
                                    <Path Grid.Column="1"
                                          Data="M6 9 L12 15 L18 9"
                                          Stroke="#71717A"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            
                            <!-- Popup -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="true"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder"
                                        Background="White"
                                        BorderBrush="#E6E6EA"
                                        BorderThickness="1"
                                        CornerRadius="13"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="dropDownBorder" Property="Height" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#18181B"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#18181B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium Toggle Switch Style (CheckBox) -->
        <Style x:Key="T3ToggleSwitch" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Hanken Grotesk"/>
            <Setter Property="Foreground" Value="#27272A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <ContentPresenter x:Name="contentPresenter" 
                                              Grid.Column="0" 
                                              Focusable="False" 
                                              HorizontalAlignment="Left" 
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" 
                                              RecognizesAccessKey="True" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                              
                            <!-- Toggle Track -->
                            <Border x:Name="toggleTrack" 
                                    Grid.Column="1"
                                    Width="42" Height="24"
                                    Background="#DCDCE2"
                                    CornerRadius="12"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                <!-- Toggle Knob -->
                                <Ellipse x:Name="toggleKnob"
                                         Width="20" Height="20"
                                         Fill="White"
                                         HorizontalAlignment="Left"
                                         Margin="2,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect ShadowDepth="1" Direction="270" Color="Black" Opacity="0.15" BlurRadius="2"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="toggleTrack" Property="Background" Value="#18181B"/>
                                <Setter TargetName="toggleKnob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="toggleTrack" Property="Background" Value="#F4F4F6"/>
                                <Setter TargetName="toggleKnob" Property="Fill" Value="#9A9AA2"/>
                                <Setter Property="Foreground" Value="#9A9AA2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Modern Slider -->
        <Style x:Key="T3Slider" TargetType="Slider">
            <Setter Property="Background" Value="#E4E4E8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border x:Name="TrackBackground"
                                    Grid.Row="1"
                                    Height="6"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    VerticalAlignment="Center"/>
                                    
                            <!-- Track Fill and Thumb -->
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="#C2410C" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="18" Height="18"
                                                         Fill="White"
                                                         Stroke="#C2410C"
                                                         StrokeThickness="2">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect ShadowDepth="2" Direction="270" Color="#C2410C" Opacity="0.3" BlurRadius="4"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Modern Input Field -->
        <Style x:Key="T3InputField" TargetType="TextBox">
            <Setter Property="Background" Value="#F4F4F6"/>
            <Setter Property="Foreground" Value="#27272A"/>
            <Setter Property="BorderBrush" Value="#E6E6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Hanken Grotesk"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#18181B"/>
                                <Setter Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium Modern GroupBox Card -->
        <Style x:Key="T3PremiumCard" TargetType="GroupBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Card Header -->
                                <Border Grid.Row="0" 
                                        Background="#FFFFFF"
                                        Padding="16,12"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="0,0,0,1">
                                    <ContentPresenter ContentSource="Header"
                                                      TextBlock.FontSize="14"
                                                      TextBlock.FontWeight="Bold"
                                                      TextBlock.Foreground="#18181B"
                                                      TextBlock.FontFamily="Hanken Grotesk"/>
                                </Border>
                                <!-- Card Content -->
                                <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top Navigation Tab Style -->
        <Style x:Key="T3TopNavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#71717A"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontFamily" Value="Hanken Grotesk"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#18181B"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#18181B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#18181B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PRIMARY BUTTON - solid deep slate, white text -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#18181B"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Padding"         Value="12,5"/>
            <Setter Property="FontSize"        Value="13.5"/>
            <Setter Property="FontFamily"      Value="Hanken Grotesk"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#000000"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#18181B"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F4F4F6"/>
                    <Setter Property="Foreground" Value="#9A9AA2"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SECONDARY BUTTON - white background, border and text slate -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="Foreground"      Value="#27272A"/>
            <Setter Property="Padding"         Value="12,5"/>
            <Setter Property="FontSize"        Value="13.5"/>
            <Setter Property="FontFamily"      Value="Hanken Grotesk"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#DEDEE2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FAFAFB"/>
                    <Setter Property="BorderBrush" Value="#CFCFD5"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#EDEDEF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#9A9AA2"/>
                    <Setter Property="BorderBrush" Value="#E6E6EA"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- GHOST BUTTON -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#52525B"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontFamily" Value="Hanken Grotesk"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EDEDEF"/>
                    <Setter Property="Foreground" Value="#18181B"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E2E2E5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SUCCESS BUTTON -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#0B8A5A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#09734B"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0B8A5A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DANGER BUTTON -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#D23B3B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F87171"/>
                    <Setter Property="Foreground" Value="#1F1F23"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D23B3B"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ACCENT BUTTON -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#18181B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar Icon Button Style -->
        <Style x:Key="T3SidebarButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#71717A"/>
            <Setter Property="Width"           Value="42"/>
            <Setter Property="Height"          Value="42"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F4F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E6E6EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- WINDOW CONTROL BUTTON -->
        <Style x:Key="WinCtrlButton" TargetType="Button">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#18181B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E4E4E7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CLOSE BUTTON -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WinCtrlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D23B3B"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Premium CheckBox Style -->
        <Style x:Key="T3CheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Hanken Grotesk"/>
            <Setter Property="Foreground" Value="#27272A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="checkBoxBorder" 
                                    Grid.Column="0"
                                    Width="18" Height="18"
                                    Margin="0,0,8,0"
                                    BorderBrush="#D4D4DA"
                                    BorderThickness="1.5"
                                    Background="White"
                                    CornerRadius="6"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <Path x:Name="optionMark" 
                                      Data="M4,9 L8,13 L14,5" 
                                      Stroke="White" 
                                      StrokeThickness="2" 
                                      StrokeStartLineCap="Round" 
                                      StrokeEndLineCap="Round" 
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter x:Name="contentPresenter" 
                                              Grid.Column="1" 
                                              Focusable="False" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              Margin="{TemplateBinding Padding}" 
                                              RecognizesAccessKey="True" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#18181B"/>
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#18181B"/>
                                <Setter TargetName="optionMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#18181B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#F4F4F6"/>
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#E6E6EA"/>
                                <Setter Property="Foreground" Value="#9A9AA2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium RadioButton Style -->
        <Style x:Key="T3RadioButton" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Hanken Grotesk"/>
            <Setter Property="Foreground" Value="#27272A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="radioBorder" 
                                    Grid.Column="0"
                                    Width="20" Height="20"
                                    Margin="0,0,8,0"
                                    BorderBrush="#D4D4DA"
                                    BorderThickness="2"
                                    Background="White"
                                    CornerRadius="10"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="radioDot"
                                         Width="9" Height="9"
                                         Fill="#18181B"
                                         Visibility="Collapsed"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter x:Name="contentPresenter" 
                                              Grid.Column="1" 
                                              Focusable="False" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              Margin="{TemplateBinding Padding}" 
                                              RecognizesAccessKey="True" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="radioBorder" Property="BorderBrush" Value="#18181B"/>
                                <Setter TargetName="radioDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="radioBorder" Property="BorderBrush" Value="#18181B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="radioBorder" Property="Background" Value="#F4F4F6"/>
                                <Setter TargetName="radioBorder" Property="BorderBrush" Value="#E6E6EA"/>
                                <Setter Property="Foreground" Value="#9A9AA2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Scrollbar Styling -->
        <Style TargetType="{x:Type Thumb}" x:Key="ScrollBarThumbStyle">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBorder" Background="#A1A1AA" CornerRadius="2" Margin="0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#71717A"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="true">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#18181B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="true"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="false"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="4"/>
                    <Setter Property="Height" Value="Auto"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- SIDEBAR TOGGLE BUTTON (for icon-only sidebar filter/nav) -->
        <Style x:Key="T3SidebarToggle" TargetType="ToggleButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#71717A"/>
            <Setter Property="Width"           Value="42"/>
            <Setter Property="Height"          Value="42"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18181B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#E6E6EA"/>
                                <Setter Property="Foreground" Value="#18181B"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#27272A"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Sleek Modern ComboBox Small -->
        <Style x:Key="T3ComboBoxSmall" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#18181B"/>
            <Setter Property="BorderBrush" Value="#E6E6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Hanken Grotesk"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"/>
                                    <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <Path Grid.Column="1"
                                          Data="M6 9 L12 15 L18 9"
                                          Stroke="#71717A"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="10" Height="10"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                    AllowsTransparency="true"
                                    IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                    Placement="Bottom"
                                    PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder"
                                        Background="White"
                                        BorderBrush="#E6E6EA"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="dropDownBorder" Property="Height" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#18181B"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#18181B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Modern ComboBox Small ToggleButton -->
        <Style x:Key="T3ComboBoxSmallToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#18181B"/>
            <Setter Property="BorderBrush" Value="#E6E6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Hanken Grotesk"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  IsHitTestVisible="False"/>
                                <Path Grid.Column="1"
                                      Data="M6 9 L12 15 L18 9"
                                      Stroke="#71717A"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="10" Height="10"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#18181B"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#18181B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sleek Modern Input Field Small -->
        <Style x:Key="T3InputFieldSmall" TargetType="TextBox">
            <Setter Property="Background" Value="#F4F4F6"/>
            <Setter Property="Foreground" Value="#27272A"/>
            <Setter Property="BorderBrush" Value="#E6E6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Hanken Grotesk"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#18181B"/>
                                <Setter Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat ProgressBar Style (Lumina Standard) -->
        <Style x:Key="T3ProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="#ECECEF"/>
            <Setter Property="Foreground" Value="#C2410C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border x:Name="BackgroundBorder" Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Track" ClipToBounds="True" CornerRadius="4" Background="Transparent">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Queue Item ProgressBar Style with complete trigger -->
        <Style x:Key="QueueProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource T3ProgressBar}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Progress}" Value="100">
                    <Setter Property="Foreground" Value="#10B981"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Tab Pill RadioButton Style -->
        <Style x:Key="TabPillRadioButton" TargetType="RadioButton">
            <Setter Property="GroupName" Value="TabPills"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#71717A"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontFamily" Value="Hanken Grotesk"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#18181B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E2E6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ END T3LAB SHARED STYLES ═══ -->

        <!-- Window-local label style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#9A9AA2"/>
            <Setter Property="Margin" Value="1,0,0,6"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#A1A1AA" BorderThickness="1.5" CornerRadius="22" ClipToBounds="True" Background="#E4E4E7">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ ROW 0: TITLE BAR ═══ -->
            <Grid Grid.Row="0" Background="#F4F4F6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="22,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="LLMs Setting" FontSize="15" FontWeight="Bold" Foreground="#18181B"/>
                    <TextBlock Text="Assistant, providers, projects, knowledge &amp; skills" FontSize="12.5" Foreground="#71717A" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,16,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="btn_minimize" Style="{StaticResource WinCtrlButton}"
                            Click="minimize_button_clicked" ToolTip="Minimize">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="btn_maximize" Style="{StaticResource WinCtrlButton}"
                            Click="maximize_button_clicked" ToolTip="Maximize">
                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="btn_close" Style="{StaticResource CloseButton}"
                            Click="close_button_clicked" ToolTip="Close">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>

                <Border Height="1" VerticalAlignment="Bottom" Background="#DCDCE0" Grid.ColumnSpan="3"/>
            </Grid>

            <!-- ═══ ROW 1: TAB STRIP (segmented pills, Claude-style) ═══ -->
            <Border Grid.Row="1" Background="#F4F4F6" Padding="16,10,16,10"
                    BorderBrush="#DCDCE0" BorderThickness="0,0,0,1">
                <Border Background="#E4E4E7" CornerRadius="14" Padding="3"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="tab_general" Content="General"
                                     Style="{StaticResource TabPillRadioButton}"
                                     Tag="general" Checked="tab_changed"/>
                        <RadioButton x:Name="tab_provider" Content="Models"
                                     Style="{StaticResource TabPillRadioButton}"
                                     Tag="provider" IsChecked="True" Checked="tab_changed"/>
                        <RadioButton x:Name="tab_projects" Content="Projects"
                                     Style="{StaticResource TabPillRadioButton}"
                                     Tag="projects" Checked="tab_changed"/>
                        <RadioButton x:Name="tab_knowledge" Content="Knowledge"
                                     Style="{StaticResource TabPillRadioButton}"
                                     Tag="knowledge" Checked="tab_changed"/>
                        <RadioButton x:Name="tab_skills" Content="Skills"
                                     Style="{StaticResource TabPillRadioButton}"
                                     Tag="skills" Checked="tab_changed"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ═══ ROW 2: BODY ═══ -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Border Background="White" BorderThickness="0" CornerRadius="0" Padding="20,18">
                    <Grid>

                    <!-- ════════ TAB: GENERAL ════════ -->
                    <StackPanel x:Name="panel_general" Visibility="Collapsed">

                        <!-- Display name -->
                        <TextBlock Text="DISPLAY NAME" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="Used in the chat greeting and daily activity log."
                                   FontSize="11" Foreground="#71717A" Margin="1,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="username_box" Grid.Column="0"
                                     Style="{StaticResource T3InputField}"/>
                            <Button x:Name="save_username_btn" Grid.Column="2"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Save" Height="34" Width="64"
                                    Click="save_username_clicked"/>
                        </Grid>
                        <TextBlock x:Name="username_saved_hint" Text=""
                                   FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="#10B981" Margin="1,0,0,16"/>

                        <Border Height="1" Background="#E2E8F0" Margin="0,0,0,16"/>

                        <!-- Action mode -->
                        <TextBlock Text="MODEL EDITS" Style="{StaticResource FieldLabel}"/>
                        <CheckBox x:Name="action_mode_toggle"
                                  Style="{StaticResource T3ToggleSwitch}"
                                  Margin="1,4,0,6"
                                  Checked="action_mode_toggled"
                                  Unchecked="action_mode_toggled">
                            <TextBlock Text="Ask before model edits" FontSize="12.5"
                                       Foreground="#27272A"/>
                        </CheckBox>
                        <TextBlock Text="ON: the assistant presents a plan and waits for your confirmation before changing the Revit model. OFF: edits run immediately (deletes still ask)."
                                   FontSize="11" Foreground="#71717A" TextWrapping="Wrap"
                                   Margin="1,0,0,16" LineHeight="15"/>

                        <Border Height="1" Background="#E2E8F0" Margin="0,0,0,16"/>

                        <!-- Deep reasoning -->
                        <TextBlock Text="REASONING" Style="{StaticResource FieldLabel}"/>
                        <CheckBox x:Name="extended_thinking_toggle"
                                  Style="{StaticResource T3ToggleSwitch}"
                                  Margin="1,4,0,6"
                                  Checked="extended_thinking_toggled"
                                  Unchecked="extended_thinking_toggled">
                            <TextBlock Text="Deep reasoning (Claude)" FontSize="12.5"
                                       Foreground="#27272A"/>
                        </CheckBox>
                        <TextBlock Text="ON: Claude thinks through complex multi-step requests before acting — noticeably smarter on hard tasks, but slower per reply. OFF (default): fastest responses. Applies to the agent only; other providers ignore it."
                                   FontSize="11" Foreground="#71717A" TextWrapping="Wrap"
                                   Margin="1,0,0,16" LineHeight="15"/>

                        <Border Height="1" Background="#E2E8F0" Margin="0,0,0,16"/>

                        <!-- Response quality (Opus parity) -->
                        <TextBlock Text="RESPONSE QUALITY" Style="{StaticResource FieldLabel}"/>
                        <CheckBox x:Name="quality_mode_toggle"
                                  Style="{StaticResource T3ToggleSwitch}"
                                  Margin="1,4,0,6"
                                  Checked="quality_mode_toggled"
                                  Unchecked="quality_mode_toggled">
                            <TextBlock Text="Maximum quality (Opus parity)" FontSize="12.5"
                                       Foreground="#27272A"/>
                        </CheckBox>
                        <TextBlock Text="ON: picks the most capable model as the default (Claude → Opus; local → the strongest installed model), turns deep reasoning on, and gives replies more room so answers stay complete. Best-in-class quality, but higher cost/latency per reply. OFF (default): balanced speed and cost. Utility calls always stay on the fast model."
                                   FontSize="11" Foreground="#71717A" TextWrapping="Wrap"
                                   Margin="1,0,0,16" LineHeight="15"/>

                        <Border Height="1" Background="#E2E8F0" Margin="0,0,0,16"/>

                        <!-- Data -->
                        <TextBlock Text="DATA" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="Chat history, projects, attachments and the knowledge index are stored per-user under %APPDATA%\T3LabAI."
                                   FontSize="11" Foreground="#71717A" TextWrapping="Wrap"
                                   Margin="1,0,0,8" LineHeight="15"/>
                        <Button x:Name="open_data_dir_btn"
                                Style="{StaticResource SecondaryButton}" Height="34"
                                HorizontalAlignment="Left" Click="open_data_dir_clicked">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"
                                      Stroke="#52525B" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="13" Height="13" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Open data folder" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#52525B"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- ════════ TAB: MODELS (provider / key / connection) ════════ -->
                    <StackPanel x:Name="panel_provider">

                        <!-- Provider -->
                        <TextBlock Text="PROVIDER" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,16">
                            <ComboBox x:Name="provider_combo" Style="{StaticResource T3ComboBox}"
                                      Padding="26,0,10,0"
                                      SelectionChanged="provider_changed">
                                <ComboBoxItem Tag="claude">Claude (Anthropic)</ComboBoxItem>
                                <ComboBoxItem Tag="openai">GPT (OpenAI)</ComboBoxItem>
                                <ComboBoxItem Tag="deepseek">DeepSeek</ComboBoxItem>
                                <ComboBoxItem Tag="ollama">Local (Ollama)</ComboBoxItem>
                                <ComboBoxItem Tag="lmstudio">LM Studio</ComboBoxItem>
                            </ComboBox>
                            <Ellipse x:Name="provider_brand_dot"
                                     Width="8" Height="8" Fill="#D97757"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="12,0,0,0" IsHitTestVisible="False"/>
                        </Grid>

                        <!-- Model -->
                        <Grid Margin="1,0,0,6">
                            <TextBlock Text="MODEL" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <TextBlock x:Name="model_saved_hint" Text=""
                                       HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="#10B981"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="model_combo" Grid.Column="0" Style="{StaticResource T3ComboBox}"
                                      SelectionChanged="model_changed"/>
                            <Button x:Name="save_model_btn" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                    Content="Save" Height="34" Width="64" Click="save_model_clicked"/>
                        </Grid>

                        <!-- API Key -->
                        <Grid Margin="1,0,0,6">
                            <TextBlock Text="API KEY" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <Button x:Name="get_api_key_link" HorizontalAlignment="Right" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    Click="get_api_key_clicked" ToolTip="Open the API key page">
                                <TextBlock Text="Get API key ↗" FontSize="10.5" FontWeight="SemiBold" Foreground="#3B82F6"/>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="key_label" Text="Anthropic API Key (sk-ant-...)"
                                   FontSize="11" Foreground="#71717A" Margin="1,0,0,6"/>
                        <TextBox x:Name="api_key_box" Style="{StaticResource T3InputField}" Margin="0,0,0,8"/>
                        <Button x:Name="save_key_btn" Style="{StaticResource PrimaryButton}"
                                Content="Save Key" Height="36" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Click="save_key_clicked" Margin="0,0,0,16"/>

                        <!-- Server URL (Ollama / LM Studio only) -->
                        <StackPanel x:Name="host_panel" Visibility="Collapsed" Margin="0,0,0,16">
                            <TextBlock Text="SERVER URL" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="host_label" Text="LM Studio base URL"
                                       FontSize="11" Foreground="#71717A" Margin="1,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="host_box" Grid.Column="0" Style="{StaticResource T3InputField}"/>
                                <Button x:Name="save_host_btn" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                        Content="Save" Height="34" Width="64" Click="save_host_clicked"/>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="#E2E8F0" Margin="0,0,0,16"/>

                        <!-- Status -->
                        <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}" Margin="1,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="1,0,0,7">
                            <Ellipse x:Name="status_dot_claude" Width="7" Height="7" Fill="#E6E6EA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Claude" FontSize="12" Foreground="#18181B" Width="66"/>
                            <TextBlock x:Name="status_text_claude" Text="—" FontSize="12" Foreground="#A1A1AA"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="1,0,0,7">
                            <Ellipse x:Name="status_dot_openai" Width="7" Height="7" Fill="#E6E6EA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="OpenAI" FontSize="12" Foreground="#18181B" Width="66"/>
                            <TextBlock x:Name="status_text_openai" Text="—" FontSize="12" Foreground="#A1A1AA"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="1,0,0,7">
                            <Ellipse x:Name="status_dot_deepseek" Width="7" Height="7" Fill="#E6E6EA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="DeepSeek" FontSize="12" Foreground="#18181B" Width="66"/>
                            <TextBlock x:Name="status_text_deepseek" Text="—" FontSize="12" Foreground="#A1A1AA"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="1,0,0,7">
                            <Ellipse x:Name="status_dot_ollama" Width="7" Height="7" Fill="#E6E6EA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Ollama" FontSize="12" Foreground="#18181B" Width="66"/>
                            <TextBlock x:Name="status_text_ollama" Text="—" FontSize="12" Foreground="#A1A1AA"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="1,0,0,16">
                            <Ellipse x:Name="status_dot_lmstudio" Width="7" Height="7" Fill="#E6E6EA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="LM Studio" FontSize="12" Foreground="#18181B" Width="66"/>
                            <TextBlock x:Name="status_text_lmstudio" Text="—" FontSize="12" Foreground="#A1A1AA"/>
                        </StackPanel>

                        <Border Height="1" Background="#E2E8F0" Margin="0,0,0,16"/>

                        <!-- Test connection -->
                        <Button x:Name="test_btn" Style="{StaticResource SecondaryButton}" Height="36" Click="test_clicked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Test Connection" FontSize="12" FontWeight="SemiBold" Foreground="#52525B"/>
                            </StackPanel>
                        </Button>

                        <Border x:Name="test_result_border" Visibility="Collapsed"
                                CornerRadius="8" Padding="10,8" Margin="0,10,0,0"
                                Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="test_label" Text="Result" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#10B981" Margin="0,0,0,4"/>
                                <TextBlock x:Name="test_result" Text="" TextWrapping="Wrap"
                                           FontSize="11" Foreground="#059669" LineHeight="16"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- ════════ TAB: PROJECTS (workspaces) ════════ -->
                    <StackPanel x:Name="panel_projects" Visibility="Collapsed">

                        <Grid Margin="1,0,0,6">
                            <TextBlock Text="PROJECTS" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <Button x:Name="new_project_btn" HorizontalAlignment="Right" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    Click="new_project_clicked" ToolTip="Create a new project">
                                <TextBlock Text="+ New project" FontSize="10.5" FontWeight="SemiBold" Foreground="#3B82F6"/>
                            </Button>
                        </Grid>
                        <TextBlock Text="A project scopes chat history, custom instructions and its own knowledge folder. Switch the ACTIVE project from the chat composer — here you edit them."
                                   FontSize="11" Foreground="#71717A" TextWrapping="Wrap"
                                   Margin="1,0,0,8" LineHeight="15"/>
                        <ComboBox x:Name="project_combo" Style="{StaticResource T3ComboBox}"
                                  Margin="0,0,0,12" SelectionChanged="project_changed"/>

                        <StackPanel x:Name="project_edit_panel" Visibility="Collapsed">
                            <TextBlock Text="PROJECT NAME" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="project_name_box" Style="{StaticResource T3InputField}"
                                     Margin="0,0,0,12"/>
                            <TextBlock Text="CUSTOM INSTRUCTIONS" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="Applied to every reply while this project is active."
                                       FontSize="11" Foreground="#71717A" Margin="1,0,0,6"/>
                            <TextBox x:Name="project_instructions_box"
                                     Height="110" Margin="0,0,0,12"
                                     FontFamily="Hanken Grotesk" FontSize="12"
                                     Padding="10,8" BorderBrush="#CBD5E1"
                                     BorderThickness="1" Background="White"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>

                            <!-- Default AI provider/model applied on activation -->
                            <TextBlock Text="DEFAULT AI (OPTIONAL)" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="Applied automatically whenever this project is activated. Model id is optional (blank = provider default)."
                                       FontSize="11" Foreground="#71717A" TextWrapping="Wrap"
                                       Margin="1,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="project_provider_combo" Grid.Column="0"
                                          Style="{StaticResource T3ComboBox}">
                                    <ComboBoxItem Content="Follow global setting" Tag=""
                                                  IsSelected="True"/>
                                    <ComboBoxItem Content="Claude — Anthropic" Tag="claude"/>
                                    <ComboBoxItem Content="GPT — OpenAI" Tag="openai"/>
                                    <ComboBoxItem Content="DeepSeek" Tag="deepseek"/>
                                    <ComboBoxItem Content="Ollama — Local" Tag="ollama"/>
                                    <ComboBoxItem Content="LM Studio — Local" Tag="lmstudio"/>
                                </ComboBox>
                                <TextBox x:Name="project_model_box" Grid.Column="2"
                                         Style="{StaticResource T3InputField}"
                                         ToolTip="Optional model id, e.g. claude-sonnet-5"/>
                            </Grid>

                            <!-- Context (knowledge files of this project) -->
                            <TextBlock Text="CONTEXT (KNOWLEDGE FILES)" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="project_files_status" Grid.Column="0"
                                           Text="0 files" FontSize="12" Foreground="#71717A"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="project_add_files_btn" Grid.Column="2"
                                        Style="{StaticResource SecondaryButton}" Height="30"
                                        Content="Add files…" Click="project_add_files_clicked"
                                        ToolTip="Copy PDF/DOCX/TXT/MD into this project's knowledge folder"/>
                                <Button x:Name="project_link_folder_btn" Grid.Column="4"
                                        Style="{StaticResource SecondaryButton}" Height="30"
                                        Content="Link folder" Click="project_link_folder_clicked"
                                        ToolTip="Link an external folder (BEP, standards, network share) as project knowledge — indexed in place, a CONTEXT.md digest is written inside it"/>
                                <Button x:Name="project_rescan_btn" Grid.Column="6"
                                        Style="{StaticResource SecondaryButton}" Height="30"
                                        Content="↻ Rescan" Click="project_rescan_clicked"
                                        ToolTip="Re-read every linked folder, rebuild its CONTEXT.md and refresh the search index — run this after the BEP or standards are updated"/>
                            </Grid>
                            <!-- Linked external knowledge folders -->
                            <StackPanel x:Name="project_dirs_panel" Margin="0,0,0,6"/>
                            <Button x:Name="project_open_folder_btn"
                                    Style="{StaticResource SecondaryButton}" Height="28"
                                    HorizontalAlignment="Left" Margin="0,0,0,0"
                                    Content="Open knowledge folder" Click="project_open_folder_clicked"
                                    ToolTip="Open the project's knowledge folder in Explorer"/>

                            <!-- Scheduled daily prompts -->
                            <TextBlock Text="SCHEDULED (DAILY PROMPTS)" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="Run automatically at the set time while the assistant window is open."
                                       FontSize="11" Foreground="#71717A" TextWrapping="Wrap"
                                       Margin="1,0,0,6"/>
                            <StackPanel x:Name="project_sched_panel" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="project_sched_prompt_box" Grid.Column="0"
                                         Style="{StaticResource T3InputField}"
                                         ToolTip="Prompt to run, e.g. 'get model warnings'"/>
                                <TextBox x:Name="project_sched_time_box" Grid.Column="2"
                                         Style="{StaticResource T3InputField}" Text="09:00"
                                         ToolTip="Daily time (HH:MM)"/>
                                <Button x:Name="project_sched_add_btn" Grid.Column="4"
                                        Style="{StaticResource SecondaryButton}" Height="30"
                                        Content="Add" Click="project_sched_add_clicked"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="project_save_btn" Grid.Column="0"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="Save Project" Height="34"
                                        HorizontalContentAlignment="Center"
                                        Click="project_save_clicked"/>
                                <Button x:Name="project_delete_btn" Grid.Column="2"
                                        Style="{StaticResource DangerButton}"
                                        Content="Delete" Height="34" Width="72"
                                        Click="project_delete_clicked"
                                        ToolTip="Delete this project (index + chat history)"/>
                            </Grid>
                            <TextBlock x:Name="project_saved_hint" Text=""
                                       FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="#10B981" Margin="1,6,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ════════ TAB: KNOWLEDGE (RAG index) ════════ -->
                    <StackPanel x:Name="panel_knowledge" Visibility="Collapsed">

                        <Grid Margin="1,0,0,6">
                            <TextBlock Text="KNOWLEDGE" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <TextBlock x:Name="knowledge_index_status" Text="—"
                                       HorizontalAlignment="Right" FontSize="10.5"
                                       Foreground="#A1A1AA"/>
                        </Grid>
                        <TextBlock Text="Document folders indexed so replies can cite their sources (PDF / TXT / MD)."
                                   FontSize="11" Foreground="#71717A" TextWrapping="Wrap"
                                   Margin="1,0,0,8" LineHeight="15"/>
                        <StackPanel x:Name="knowledge_dirs_panel" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="add_knowledge_btn" Grid.Column="0"
                                    Style="{StaticResource SecondaryButton}" Height="34"
                                    Click="add_knowledge_dir_clicked"
                                    ToolTip="Add a document folder to the index">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M5 12h14 M12 5v14"
                                          Stroke="#52525B" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="12" Height="12" Stretch="Uniform"
                                          VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="Add folder" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#52525B"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="reindex_btn" Grid.Column="2"
                                    Style="{StaticResource SecondaryButton}" Height="34" Width="94"
                                    Click="reindex_clicked" ToolTip="Rescan the whole index">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16 M3 21v-5h5"
                                          Stroke="#52525B" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="12" Height="12" Stretch="Uniform"
                                          VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="Reindex" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#52525B"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Height="1" Background="#E2E8F0" Margin="0,0,0,14"/>

                        <CheckBox x:Name="knowledge_embed_toggle"
                                  Style="{StaticResource T3ToggleSwitch}"
                                  Margin="1,0,0,6"
                                  Checked="knowledge_embed_toggled"
                                  Unchecked="knowledge_embed_toggled">
                            <TextBlock Text="Semantic search (Ollama embeddings)" FontSize="12.5"
                                       Foreground="#27272A"/>
                        </CheckBox>
                        <TextBlock Text="First enable downloads the embedding model (~270 MB) in the background via Ollama. Keyword search (BM25) always works."
                                   FontSize="11" Foreground="#71717A" TextWrapping="Wrap"
                                   Margin="1,0,0,0" LineHeight="15"/>
                    </StackPanel>

                    <!-- ════════ TAB: SKILLS (instruction packs) ════════ -->
                    <StackPanel x:Name="panel_skills" Visibility="Collapsed">

                        <Grid Margin="1,0,0,6">
                            <TextBlock Text="SKILLS" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="install_skills_btn" Cursor="Hand" Margin="0,0,10,0"
                                        Background="Transparent" BorderThickness="0" Padding="0"
                                        Click="install_skills_clicked"
                                        ToolTip="Install Claude skills from a GitHub repo link">
                                    <TextBlock Text="Install from GitHub" FontSize="10.5" FontWeight="SemiBold" Foreground="#3B82F6"/>
                                </Button>
                                <Button x:Name="update_skills_btn" Cursor="Hand" Margin="0,0,10,0"
                                        Background="Transparent" BorderThickness="0" Padding="0"
                                        Click="update_skills_clicked"
                                        ToolTip="Re-pull every skill installed from a repo">
                                    <TextBlock Text="Update" FontSize="10.5" FontWeight="SemiBold" Foreground="#3B82F6"/>
                                </Button>
                                <Button x:Name="refresh_skills_btn" Cursor="Hand" Margin="0,0,10,0"
                                        Background="Transparent" BorderThickness="0" Padding="0"
                                        Click="refresh_skills_clicked" ToolTip="Rescan skill folders">
                                    <TextBlock Text="Refresh" FontSize="10.5" FontWeight="SemiBold" Foreground="#3B82F6"/>
                                </Button>
                                <Button x:Name="open_skills_dir_btn" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0" Padding="0"
                                        Click="open_skills_dir_clicked" ToolTip="Open your skills folder">
                                    <TextBlock Text="Open folder ↗" FontSize="10.5" FontWeight="SemiBold" Foreground="#3B82F6"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Instruction packs that auto-activate based on your request. Toggle to enable/disable, or type /skill-name in the chat to force one."
                                   FontSize="11" Foreground="#71717A" TextWrapping="Wrap"
                                   Margin="1,0,0,4" LineHeight="15"/>
                        <TextBlock Text="Claude skills are supported as-is: paste a GitHub repo link above, or tell the assistant &quot;install skills from &lt;link&gt;&quot;. Update re-pulls them later."
                                   FontSize="11" Foreground="#71717A" TextWrapping="Wrap"
                                   Margin="1,0,0,8" LineHeight="15"/>
                        <StackPanel x:Name="skills_list_panel"/>
                    </StackPanel>

                    </Grid>
                </Border>
            </ScrollViewer>

            <!-- ═══ ROW 3: FOOTER ═══ -->
            <Border Grid.Row="3" Background="#F4F4F6" BorderBrush="#DCDCE0"
                    BorderThickness="0,1,0,0" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="© Copyright by T3Lab"
                                   FontSize="11" Foreground="#F59E0B" VerticalAlignment="Center"/>
                        <Border Width="1" Height="14" Background="#DCDCE0" Margin="12,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="status_text" Text="Ready"
                                   FontSize="13.5" Foreground="#71717A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="btn_footer_close" Style="{StaticResource SecondaryButton}"
                            Content="Close" Width="100" Click="close_button_clicked"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
