<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BatchOut"
        Width="1280" Height="780"
        MinWidth="1200" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Background="{DynamicResource T3.Canvas}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        ContentRendered="window_content_rendered">

        <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                       ResizeBorderThickness="5"
                       GlassFrameThickness="0"
                       CornerRadius="8"
                       UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Nguồn duy nhất của màu/type/style — xem pyRevit UI Design System/.
                     Bản deploy được sinh bằng `python3 dev/sync_t3_styles.py`. -->
                <ResourceDictionary Source="../Resources/T3Lab.Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Chrome cửa sổ + chrome wizard (sidebar rail, step, tab pill, toggle,
                 slider): T3 chưa định nghĩa các component này — xem DESIGN SYSTEM
                 GAP #4 trong docs/ui-governance/PRIORITY_QUEUE.md. Màu/type của
                 chúng đã lấy từ token T3. -->
        

        <!-- TERTIARY BUTTON - soft gray background, dark text -->

        <!-- Sleek Modern ComboBox -->


        <!-- Premium Toggle Switch Style (CheckBox) -->

        <!-- Sleek Modern Slider -->

        <!-- Sleek Modern Input Field -->


        <!-- Premium Modern GroupBox Card -->

        <!-- Top Navigation Tab Style -->

        <!-- PRIMARY BUTTON - solid deep slate, white text -->

        <!-- SECONDARY BUTTON - white background, border and text slate -->

        <!-- GHOST BUTTON -->

        <!-- SUCCESS BUTTON -->

        <!-- DANGER BUTTON -->

        <!-- ACCENT BUTTON -->

        <!-- Sidebar Icon Button Style -->

        <!-- WINDOW CONTROL BUTTON -->

        <!-- CLOSE BUTTON -->

        <!-- Premium CheckBox Style -->


        <!-- Premium RadioButton Style -->


        <!-- Custom Scrollbar Styling -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource T3.ScrollBar.Thumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="true"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="false"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="4"/>
                    <Setter Property="Height" Value="Auto"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- SIDEBAR TOGGLE BUTTON (for icon-only sidebar filter/nav) -->
        <!-- Sleek Modern ComboBox Small -->


        <!-- Sleek Modern ComboBox Small ToggleButton -->

        <!-- Sleek Modern Input Field Small -->


        <!-- Flat ProgressBar Style (Lumina Standard) -->


        <!-- Queue Item ProgressBar Style with complete trigger -->

        <!-- Tab Pill RadioButton Style -->






        </ResourceDictionary>
    </Window.Resources>

    <!-- ═══ Outer Border: CornerRadius + ClipToBounds (Lumina standard) ═══ -->
    <Border BorderBrush="{StaticResource T3.BorderStrong}" BorderThickness="1.5" CornerRadius="8" ClipToBounds="True" Background="{StaticResource T3.Canvas}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="66"/>    <!-- Col 0: Left Sidebar Rail -->
                <ColumnDefinition Width="*"/>     <!-- Col 1: Main content area -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>      <!-- Row 0: Title bar -->
                <RowDefinition Height="*"/>       <!-- Row 1: Content Area -->
                <RowDefinition Height="Auto"/>    <!-- Row 2: Footer / Action bar -->
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- COL 0: LEFT SIDEBAR ICON RAIL (all rows)                    -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0" Grid.RowSpan="3"
                    Background="{StaticResource T3.SurfaceSunken}" BorderBrush="{StaticResource T3.Border}" BorderThickness="0,0,1,0">
                <Grid Margin="0,16,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Logo -->
                        <RowDefinition Height="Auto"/> <!-- Tab Selection -->
                        <RowDefinition Height="Auto"/> <!-- Tab Format -->
                        <RowDefinition Height="Auto"/> <!-- Tab Queue -->
                        <RowDefinition Height="*"/>    <!-- Spacer -->
                    </Grid.RowDefinitions>

                    <!-- Logo: BatchOut Sheets Export logo -->
                    <Border Grid.Row="0" Style="{StaticResource T3.Rail.Logo}"
                            Background="White" BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path Data="M4 4 h16 v14 h-16 z M4 9 h16 M10 9 v10"
                              Stroke="{StaticResource T3.Ink}" StrokeThickness="1.6" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Tab: Selection — stacked sheets/layers -->
                    <ToggleButton x:Name="nav_toggle_selection" Grid.Row="1"
                                  Style="{StaticResource T3.Rail.Tile}"
                                  Margin="0,0,0,8" IsChecked="True"
                                  ToolTip="Selection" Click="nav_toggle_clicked">
                        <Path Data="M12 4 L20 8 L12 12 L4 8 Z M4 12 L12 16 L20 12 M4 16 L12 20 L20 16"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="19" Height="19" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>

                    <!-- Tab: Format — document/file format -->
                    <ToggleButton x:Name="nav_toggle_format" Grid.Row="2"
                                  Style="{StaticResource T3.Rail.Tile}"
                                  Margin="0,0,0,8"
                                  ToolTip="Format" Click="nav_toggle_clicked">
                        <Path Data="M4 2 h10 l5 5 v14 H4 z M14 2 v5 h5 M7 12 h8 M7 16 h5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="19" Height="19" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>

                    <!-- Tab: Queue — list with send arrow -->
                    <ToggleButton x:Name="nav_toggle_queue" Grid.Row="3"
                                  Style="{StaticResource T3.Rail.Tile}"
                                  Margin="0,0,0,8"
                                  ToolTip="Queue &amp; Export" Click="nav_toggle_clicked">
                        <Path Data="M2 4 h10 M2 9 h10 M2 14 h7 M15 9 h6 M18 6 l3 3 l-3 3"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="19" Height="19" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- ROW 0 / COL 1: TITLE BAR (64px, #F4F4F6)                   -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="1" Grid.Row="0" Background="{StaticResource T3.SurfaceSunken}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title & Subtitle -->
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="24,0,0,0" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="BatchOut" FontSize="15" FontWeight="Bold" Foreground="{StaticResource T3.Ink}"/>
                    <TextBlock Text="Batch export sheets &amp; views to multiple formats" FontSize="12.5" Foreground="{StaticResource T3.TextMuted}" Margin="0,0,0,0"/>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="btn_minimize" Style="{StaticResource T3.WinCtrl}"
                            Click="minimize_button_clicked" ToolTip="Minimize">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button x:Name="btn_maximize" Style="{StaticResource T3.WinCtrl}"
                            Click="maximize_button_clicked" ToolTip="Maximize">
                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button x:Name="btn_close" Style="{StaticResource T3.WinClose}" IsCancel="True"
                            Click="close_button_clicked" ToolTip="Close">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                </StackPanel>
                
                <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource T3.Border}" Grid.ColumnSpan="3"/>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- ROW 1 / COL 1: CONTENT AREA (TabControl in white card)      -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="1" Grid.Row="1"
                    Background="White"
                    CornerRadius="0" BorderBrush="{StaticResource T3.Border}" BorderThickness="0"
                    ClipToBounds="True">
                <TabControl Margin="0" x:Name="main_tabs" BorderThickness="0" Background="Transparent">

            <!-- Selection Tab -->
            <TabItem Header="Selection" Style="{StaticResource T3.TabItem.Hidden}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Select Sheets or Views to Export" Style="{StaticResource T3.Label}"/>


                    <!-- Selection Controls -->
                    <Grid Grid.Row="1" Margin="0,4">
                        <!-- Single Row with Sheets/Views Radio Buttons, View/Sheet Set, Save V/S Set, and Search -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <!-- Radio Buttons for Sheets/Views -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="sheets_radio" Content="Sheets" GroupName="selectionMode"
                                             IsChecked="True" Margin="0,0,16,0"
                                             Checked="selection_mode_changed" FontWeight="Medium"/>
                                <RadioButton x:Name="views_radio" Content="Views" GroupName="selectionMode"
                                             Checked="selection_mode_changed" FontWeight="Medium"/>
                            </StackPanel>

                            <!-- View Type Filter (for Views) - Hidden by default -->
                            <ComboBox Grid.Column="1" x:Name="view_type_filter" Height="32"
                                      SelectionChanged="filter_by_size" Visibility="Collapsed"
                                      VerticalAlignment="Center" Width="150" Margin="16,0,0,0"
                                      Style="{StaticResource T3.ComboBox}">
                                <ComboBoxItem Content="All Views" IsSelected="True"/>
                                <ComboBoxItem Content="Floor Plan"/>
                                <ComboBoxItem Content="Ceiling Plan"/>
                                <ComboBoxItem Content="Elevation"/>
                                <ComboBoxItem Content="Section"/>
                                <ComboBoxItem Content="3D View"/>
                                <ComboBoxItem Content="Schedule"/>
                                <ComboBoxItem Content="Drafting"/>
                                <ComboBoxItem Content="Legend"/>
                                <ComboBoxItem Content="Engineering"/>
                                <ComboBoxItem Content="Area Plan"/>
                            </ComboBox>

                            <!-- View/Sheet Set - multi-select dropdown -->
                            <TextBlock Grid.Column="3" Text="View/Sheet Set:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Grid Grid.Column="4">
                                <ToggleButton x:Name="sheet_set_toggle"
                                              Height="32"
                                              HorizontalContentAlignment="Left"
                                              Padding="8,0,24,0"
                                              Style="{StaticResource T3.ComboBox.Toggle}"
                                              Click="sheet_set_toggle_clicked"
                                              ToolTip="Click to select one or more View/Sheet Sets">
                                    <TextBlock x:Name="sheet_set_label" Text="All Sheets/Views"
                                               VerticalAlignment="Center" Foreground="{StaticResource T3.Ink}" FontSize="13"/>
                                </ToggleButton>
                                <Popup x:Name="sheet_set_popup"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade"
                                       PlacementTarget="{Binding ElementName=sheet_set_toggle}"
                                       Placement="Bottom">
                                    <Border BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                                            Background="White" MinWidth="240" MaxHeight="220"
                                            CornerRadius="8">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="sheet_set_checklist" Margin="8,8,8,8"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- Refresh + Save V/S Set Buttons -->
                            <StackPanel Grid.Column="6" Orientation="Horizontal">
                                <Button x:Name="refresh_button"
                                        Content="Refresh"
                                        Height="28"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource T3.Button.Secondary}"
                                        Click="refresh_clicked"
                                        ToolTip="Reload sheets/views from the model — picks up changes made while this window is open"/>
                                <Button x:Name="save_vs_set_button"
                                        Content="Save V/S Set"
                                        Height="28"
                                        Style="{StaticResource T3.Button.Secondary}"
                                        Click="save_vs_set_clicked"
                                        ToolTip="Save current selection as View/Sheet Set"/>
                            </StackPanel>

                            <!-- Search Box (showcase pill style) -->
                            <Border Grid.Column="8" Grid.ColumnSpan="2" Style="{StaticResource T3.Pill}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Data="M11 4 A7 7 0 1 0 11 18 A7 7 0 1 0 11 4 M21 21 L16.7 16.7"
                                          Stroke="{StaticResource T3.TextMuted}" StrokeThickness="1.9"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="14" Height="14" Stretch="Uniform"
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Grid Grid.Column="1">
                                        <TextBox x:Name="search_textbox"
                                                 Background="Transparent" BorderThickness="0" Padding="0"
                                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                 Height="24" FontSize="13" FontFamily="Segoe UI" Foreground="{StaticResource T3.Ink}"
                                                 TextChanged="search_sheets"/>
                                        <TextBlock Text="Search sheets or views…"
                                                   Foreground="{StaticResource T3.TextMuted}" FontSize="13" FontFamily="Segoe UI"
                                                   VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=search_textbox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Sheets List with Selection Status -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="{StaticResource T3.BorderStrong}" BorderThickness="1" Margin="0,4" CornerRadius="8" Background="{StaticResource T3.SurfaceSunken}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="1" x:Name="sheets_empty_state"
                                           Style="{StaticResource T3.Empty}"
                                           Visibility="Collapsed"
                                           Text="No sheets match the current filter.&#x0a;Clear the search box, or pick a different Sheet Set above."/>

                                <ListView VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="1" x:Name="sheets_listview"
                                          SelectionMode="Extended"
                                          BorderThickness="0"
                                          MouseDoubleClick="listview_item_double_clicked"
                                          SizeChanged="on_listview_size_changed">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.View>
                                        <GridView x:Name="items_gridview">
                                            <GridViewColumn Width="40">
                                                <GridViewColumn.Header>
                                                    <CheckBox x:Name="header_checkbox"
                                                              HorizontalAlignment="Center"
                                                              ToolTip="Select All / Deselect All"
                                                              Click="header_checkbox_clicked"/>
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn x:Name="col_number" Header="Sheet Number" Width="150"
                                                            DisplayMemberBinding="{Binding SheetNumber}"/>
                                            <GridViewColumn x:Name="col_name" Header="Sheet Name" Width="250"
                                                            DisplayMemberBinding="{Binding SheetName}"/>
                                            <GridViewColumn x:Name="col_revision" Header="Revision" Width="80"
                                                            DisplayMemberBinding="{Binding Revision}"/>
                                            <GridViewColumn x:Name="col_size" Header="Size" Width="80"
                                                            DisplayMemberBinding="{Binding Size}"/>
                                            <GridViewColumn x:Name="col_orientation" Header="Orientation" Width="90"
                                                            DisplayMemberBinding="{Binding Orientation}"/>
                                            <GridViewColumn x:Name="col_custom_filename" Width="280">
                                                <GridViewColumn.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Custom Filename" VerticalAlignment="Center"/>
                                                        <Button x:Name="btn_edit_filename"
                                                                Content="Edit"
                                                                Height="28"
                                                                Padding="8,0"
                                                                FontSize="11"
                                                                Style="{StaticResource T3.Button.Secondary}"
                                                                Click="edit_filename_clicked"
                                                                ToolTip="Edit filename pattern for all items"
                                                                Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding CustomFilename, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource T3.TextBox}"
                                                                 ToolTip="Custom filename (leave empty to use pattern)"
                                                                 PreviewMouseLeftButtonDown="textbox_prevent_toggle"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- Selection Count Status Bar -->
                        <Border Grid.Row="1" Background="{StaticResource T3.SurfaceSunken}" BorderBrush="{StaticResource T3.Border}" BorderThickness="0,1,0,0"
                                Padding="12,8" Margin="0,4,0,0" CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="selection_count_text"
                                           Grid.Column="0"
                                           Text="0 sheets and 0 views selected. Total: 0"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource T3.Ink}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Format Tab -->
            <TabItem Header="Format" Style="{StaticResource T3.TabItem.Hidden}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" x:Name="format_panels_container">

                        <TextBlock Text="Select Formats &amp; Configure Settings" Style="{StaticResource T3.Label}"/>
                        <TextBlock Text="Check a format to enable it. Click the header bar to expand/collapse its settings."
                                   FontSize="11" Foreground="{StaticResource T3.TextSecondary}" Margin="0,0,0,8"/>

                        <!-- ═══ PDF ═══ -->
                        <Border x:Name="pdf_panel_border" BorderBrush="{StaticResource T3.Ink}" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,0,4">
                            <!-- Header row -->
                            <StackPanel>
                                <Border Background="{StaticResource T3.SurfaceSunken}" CornerRadius="4,4,0,0" Cursor="Hand"
                                        MouseLeftButtonUp="pdf_header_clicked">
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="export_pdf" Grid.Column="0"
                                                  Content="PDF" IsChecked="True"
                                                  FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource T3.Ink}"
                                                  Checked="format_changed" Unchecked="format_changed"/>
                                        <TextBlock Grid.Column="1" Text="Portable Document Format"
                                                   FontSize="11" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock x:Name="pdf_expand_arrow" Grid.Column="2"
                                                   Text="▾" FontSize="13" Foreground="{StaticResource T3.Ink}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <!-- PDF Settings Body -->
                                <Border x:Name="pdf_settings_body" Background="White"
                                        BorderBrush="{StaticResource T3.Border}" BorderThickness="0,1,0,0"
                                        Padding="16,16" CornerRadius="0,0,4,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/> <!-- Spacer -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Column: Page Setup & Zoom -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Page Setup" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                            
                                            <CheckBox x:Name="pdf_auto_detect_size" Content="Auto-detect from Title Block"
                                                      Margin="0,0,0,8" IsChecked="True"
                                                      Checked="pdf_auto_detect_changed" Unchecked="pdf_auto_detect_changed"/>
                                            
                                            <TextBlock Text="Manual Paper Size" FontSize="11" Foreground="{StaticResource T3.TextSecondary}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="pdf_paper_size" Height="32" SelectedIndex="0" IsEnabled="False" 
                                                      Style="{StaticResource T3.ComboBox}" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="Use Sheet Size"/>
                                                <ComboBoxItem Content="A0"/><ComboBoxItem Content="A1"/>
                                                <ComboBoxItem Content="A2"/><ComboBoxItem Content="A3"/>
                                                <ComboBoxItem Content="A4"/>
                                            </ComboBox>
                                            
                                            <TextBlock Text="Orientation" FontSize="11" Foreground="{StaticResource T3.TextSecondary}" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                                <RadioButton x:Name="pdf_landscape" Content="Landscape" GroupName="orientation"
                                                             IsChecked="True" Margin="0,0,16,0" IsEnabled="False"/>
                                                <RadioButton x:Name="pdf_portrait" Content="Portrait" GroupName="orientation" IsEnabled="False"/>
                                            </StackPanel>

                                            <TextBlock Text="Scaling" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <RadioButton x:Name="pdf_fit_to_page" Content="Fit to Page" GroupName="zoom"
                                                             IsChecked="True" Margin="0,0,16,0"/>
                                                <RadioButton x:Name="pdf_zoom_custom" Content="Custom Zoom (100%)" GroupName="zoom"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Vertical Separator -->
                                        <Border Grid.Column="1" Width="1" Background="{StaticResource T3.Border}" HorizontalAlignment="Center" Margin="4,0"/>

                                        <!-- Right Column: Visibility & Output Options -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Visibility Settings" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                            <CheckBox x:Name="pdf_hide_ref_planes" Content="Hide reference/work planes" Margin="0,4"/>
                                            <CheckBox x:Name="pdf_hide_scope_boxes" Content="Hide scope boxes" Margin="0,4"/>
                                            <CheckBox x:Name="pdf_hide_crop_boundaries" Content="Hide crop boundaries" Margin="0,4"/>
                                            <CheckBox x:Name="pdf_hide_unreferenced_tags" Content="Hide unreferenced view tags" Margin="0,4,0,16"/>

                                            <TextBlock Text="Output Settings" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                            <CheckBox x:Name="pdf_view_links_blue" Content="View links in blue" Margin="0,4"/>
                                            <CheckBox x:Name="combine_pdf" Content="Combine all sheets into single PDF"
                                                      FontWeight="SemiBold" Margin="0,4"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ═══ DWG ═══ -->
                        <Border x:Name="dwg_panel_border" BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,0,4">
                            <StackPanel>
                                <Border Background="{StaticResource T3.SurfaceSunken}" CornerRadius="4,4,0,0" Cursor="Hand"
                                        MouseLeftButtonUp="dwg_header_clicked">
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="export_dwg" Grid.Column="0"
                                                  Content="DWG" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource T3.Ink}"
                                                  Checked="format_changed" Unchecked="format_changed"/>
                                        <TextBlock Grid.Column="1" Text="AutoCAD Drawing File"
                                                   FontSize="11" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock x:Name="dwg_expand_arrow" Grid.Column="2"
                                                   Text="▾" FontSize="13" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="dwg_settings_body" Background="White"
                                        BorderBrush="{StaticResource T3.Border}" BorderThickness="0,1,0,0"
                                        Padding="16,16" CornerRadius="0,0,4,4"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/> <!-- Spacer -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Column: Setup -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Export Setup" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                            
                                            <TextBlock Text="AutoCAD Version" FontSize="11" Foreground="{StaticResource T3.TextSecondary}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="dwg_version" Height="32" SelectedIndex="0" Style="{StaticResource T3.ComboBox}" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="AutoCAD 2013"/>
                                                <ComboBoxItem Content="AutoCAD 2010"/>
                                                <ComboBoxItem Content="AutoCAD 2007"/>
                                            </ComboBox>
                                            
                                            <TextBlock Text="DWG Export Setup" FontSize="11" Foreground="{StaticResource T3.TextSecondary}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="cad_export_setup" Height="32" SelectedIndex="0" Style="{StaticResource T3.ComboBox}" Margin="0,0,0,4" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="Use setup from file"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Vertical Separator -->
                                        <Border Grid.Column="1" Width="1" Background="{StaticResource T3.Border}" HorizontalAlignment="Center" Margin="4,0"/>

                                        <!-- Right Column: Options -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Export Options" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                            <CheckBox x:Name="cad_export_views_on_sheets" Content="Export views on sheets" IsChecked="False" Margin="0,4"/>
                                            <CheckBox x:Name="cad_export_links_as_external" Content="Export links as external references" IsChecked="False" Margin="0,4"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ═══ DGN ═══ -->
                        <Border x:Name="dgn_panel_border" BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,0,4">
                            <StackPanel>
                                <Border Background="{StaticResource T3.SurfaceSunken}" CornerRadius="4" Cursor="Hand"
                                        MouseLeftButtonUp="dgn_header_clicked">
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="export_dgn" Grid.Column="0"
                                                  Content="DGN" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource T3.Ink}"
                                                  Checked="format_changed" Unchecked="format_changed"/>
                                        <TextBlock Grid.Column="1" Text="MicroStation Design File"
                                                   FontSize="11" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock x:Name="dgn_expand_arrow" Grid.Column="2"
                                                   Text="▾" FontSize="13" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="dgn_settings_body" Background="White"
                                        BorderBrush="{StaticResource T3.Border}" BorderThickness="0,1,0,0"
                                        Padding="16,8" CornerRadius="0,0,4,4"
                                        Visibility="Collapsed">
                                    <TextBlock Text="Uses Revit's default DGN export settings. No additional configuration required."
                                               FontSize="11" Foreground="{StaticResource T3.TextSecondary}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ═══ DWF ═══ -->
                        <Border x:Name="dwf_panel_border" BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,0,4">
                            <StackPanel>
                                <Border Background="{StaticResource T3.SurfaceSunken}" CornerRadius="4" Cursor="Hand"
                                        MouseLeftButtonUp="dwf_header_clicked">
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="export_dwf" Grid.Column="0"
                                                  Content="DWF" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource T3.Ink}"
                                                  Checked="format_changed" Unchecked="format_changed"/>
                                        <TextBlock Grid.Column="1" Text="Design Web Format"
                                                   FontSize="11" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock x:Name="dwf_expand_arrow" Grid.Column="2"
                                                   Text="▾" FontSize="13" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="dwf_settings_body" Background="White"
                                        BorderBrush="{StaticResource T3.Border}" BorderThickness="0,1,0,0"
                                        Padding="16,8" CornerRadius="0,0,4,4"
                                        Visibility="Collapsed">
                                    <TextBlock Text="Uses Revit's default DWF export settings. No additional configuration required."
                                               FontSize="11" Foreground="{StaticResource T3.TextSecondary}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ═══ NWC ═══ -->
                        <Border x:Name="nwc_panel_border" BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,0,4">
                            <StackPanel>
                                <Border Background="{StaticResource T3.SurfaceSunken}" CornerRadius="4" Cursor="Hand"
                                        MouseLeftButtonUp="nwc_header_clicked">
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="export_nwd" Grid.Column="0"
                                                  Content="NWC" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource T3.Ink}"
                                                  Checked="format_changed" Unchecked="format_changed"
                                                  ToolTip="Requires Navisworks to be installed"/>
                                        <TextBlock Grid.Column="1" Text="Navisworks Cache File"
                                                   FontSize="11" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock x:Name="nwc_expand_arrow" Grid.Column="2"
                                                   Text="▾" FontSize="13" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="nwc_settings_body" Background="White"
                                        BorderBrush="{StaticResource T3.Border}" BorderThickness="0,1,0,0"
                                        Padding="16,8" CornerRadius="0,0,4,4"
                                        Visibility="Collapsed">
                                    <TextBlock Text="Exports each view/sheet as a separate NWC file. Requires Navisworks Exporters to be installed."
                                               FontSize="11" Foreground="{StaticResource T3.TextSecondary}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ═══ IFC ═══ -->
                        <Border x:Name="ifc_panel_border" BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,0,4">
                            <StackPanel>
                                <Border Background="{StaticResource T3.SurfaceSunken}" CornerRadius="4,4,0,0" Cursor="Hand"
                                        MouseLeftButtonUp="ifc_header_clicked">
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="export_ifc" Grid.Column="0"
                                                  Content="IFC" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource T3.Ink}"
                                                  Checked="format_changed" Unchecked="format_changed"/>
                                        <TextBlock Grid.Column="1" Text="Industry Foundation Classes"
                                                   FontSize="11" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock x:Name="ifc_expand_arrow" Grid.Column="2"
                                                   Text="▾" FontSize="13" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="ifc_settings_body" Background="White"
                                        BorderBrush="{StaticResource T3.Border}" BorderThickness="0,1,0,0"
                                        Padding="16,16" CornerRadius="0,0,4,4"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="IFC Export Settings" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="IFC Version:" VerticalAlignment="Center" Foreground="{StaticResource T3.TextSecondary}" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="ifc_version" Height="32" SelectedIndex="1" Style="{StaticResource T3.ComboBox}" Width="160">
                                                <ComboBoxItem Content="IFC 2x2"/>
                                                <ComboBoxItem Content="IFC 2x3"/>
                                                <ComboBoxItem Content="IFC 4"/>
                                            </ComboBox>
                                        </StackPanel>
                                        
                                        <TextBlock Text="Note: IFC exports the entire Revit model — one .ifc file regardless of sheet/view selection."
                                                   FontSize="11" Foreground="{StaticResource T3.TextSecondary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ═══ IMG ═══ -->
                        <Border x:Name="img_panel_border" BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,0,4">
                            <StackPanel>
                                <Border Background="{StaticResource T3.SurfaceSunken}" CornerRadius="4,4,0,0" Cursor="Hand"
                                        MouseLeftButtonUp="img_header_clicked">
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="export_img" Grid.Column="0"
                                                  Content="IMG" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource T3.Ink}"
                                                  Checked="format_changed" Unchecked="format_changed"/>
                                        <TextBlock Grid.Column="1" Text="PNG / JPEG Image"
                                                   FontSize="11" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock x:Name="img_expand_arrow" Grid.Column="2"
                                                   Text="▾" FontSize="13" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="img_settings_body" Background="White"
                                        BorderBrush="{StaticResource T3.Border}" BorderThickness="0,1,0,0"
                                        Padding="16,16" CornerRadius="0,0,4,4"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/> <!-- Spacer -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Column: Sizing & File Mode -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Image Sizing" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                            
                                            <!-- Fit to pixels option -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <RadioButton x:Name="img_fit_to_page" Content="Fit to" GroupName="imgSize"
                                                             IsChecked="True" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBox x:Name="img_fit_pixels" Text="1080" Width="60" Height="32"
                                                         Style="{StaticResource T3.TextBox}" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                                                <TextBlock Text="pixels" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{StaticResource T3.TextSecondary}"/>
                                                
                                                <TextBlock Text="Dir:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource T3.TextSecondary}"/>
                                                <RadioButton x:Name="img_dir_horizontal" Content="H" GroupName="imgDirection"
                                                             IsChecked="True" Margin="0,0,8,0" ToolTip="Horizontal"/>
                                                <RadioButton x:Name="img_dir_vertical" Content="V" GroupName="imgDirection" ToolTip="Vertical"/>
                                            </StackPanel>
                                            
                                            <!-- Zoom to percent option -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                                <RadioButton x:Name="img_zoom_to" Content="Zoom to" GroupName="imgSize"
                                                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBox x:Name="img_zoom_percent" Text="50" Width="55" Height="32"
                                                         Style="{StaticResource T3.TextBox}" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                                                <TextBlock Text="% of actual size" VerticalAlignment="Center" Foreground="{StaticResource T3.TextSecondary}"/>
                                            </StackPanel>

                                            <TextBlock Text="File Options" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                            <RadioButton x:Name="img_separate_files" Content="Create separate images" GroupName="imgFile"
                                                         IsChecked="True" Margin="0,4"/>
                                            <RadioButton x:Name="img_combined_html" Content="Combine into single HTML file" GroupName="imgFile"
                                                         Margin="0,4"/>
                                        </StackPanel>

                                        <!-- Vertical Separator -->
                                        <Border Grid.Column="1" Width="1" Background="{StaticResource T3.Border}" HorizontalAlignment="Center" Margin="4,0"/>

                                        <!-- Right Column: Format & Quality -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Format &amp; Quality" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                            
                                            <TextBlock Text="Shaded Views Format" FontSize="11" Foreground="{StaticResource T3.TextSecondary}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="img_shaded_format" Height="32" SelectedIndex="0" Style="{StaticResource T3.ComboBox}" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="PNG"/>
                                                <ComboBoxItem Content="JPEG"/>
                                            </ComboBox>
                                            
                                            <TextBlock Text="Non-Shaded Views Format" FontSize="11" Foreground="{StaticResource T3.TextSecondary}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="img_nonshaded_format" Height="32" SelectedIndex="0" Style="{StaticResource T3.ComboBox}" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="PNG"/>
                                                <ComboBoxItem Content="JPEG"/>
                                            </ComboBox>
                                            
                                            <TextBlock Text="Raster Quality" FontSize="11" Foreground="{StaticResource T3.TextSecondary}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="img_dpi" Height="32" SelectedIndex="2" Style="{StaticResource T3.ComboBox}" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="72 DPI"/><ComboBoxItem Content="96 DPI"/>
                                                <ComboBoxItem Content="150 DPI"/><ComboBoxItem Content="300 DPI"/>
                                                <ComboBoxItem Content="600 DPI"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Queue Tab -->
            <!-- Queue + Settings (combined) -->
            <TabItem Header="Queue" Style="{StaticResource T3.TabItem.Hidden}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── SETTINGS CARD ── -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                            Padding="12,8" Background="{StaticResource T3.SurfaceSunken}" CornerRadius="4" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Output Folder -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Output Folder:" VerticalAlignment="Center"
                                           FontWeight="Medium" FontSize="13"/>
                                <TextBox x:Name="output_folder" Grid.Column="1" Height="32"
                                         Style="{StaticResource T3.TextBox}" Margin="4,0"/>
                                <Button Grid.Column="2" Content="Browse" Height="28" Padding="12,4" FontSize="13"
                                        Style="{StaticResource T3.Button.Secondary}" Click="browse_output_folder"/>
                            </Grid>

                            <!-- Organize + Reverse on one row -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Organize:" VerticalAlignment="Center"
                                           FontWeight="Medium" FontSize="13" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="save_same_folder" Content="Same folder"
                                                 GroupName="organization" IsChecked="True" Margin="0,0,12,0"/>
                                    <RadioButton x:Name="save_split_by_format" Content="Split by format"
                                                 GroupName="organization"/>
                                </StackPanel>

                                <CheckBox x:Name="reverse_order" Grid.Column="3" Content="Reverse order"
                                          VerticalAlignment="Center"
                                          Checked="reverse_order_changed" Unchecked="reverse_order_changed"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ── QUEUE SECTION ── -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Export Queue" Style="{StaticResource T3.Label}"/>

                        <Border Grid.Row="1" BorderBrush="{StaticResource T3.Border}" BorderThickness="1" Margin="0,4" CornerRadius="4">
                            <ListView VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="export_preview_list"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Sheet Number" Width="250"
                                                        DisplayMemberBinding="{Binding SheetNumber}"/>
                                        <GridViewColumn Header="Sheet Name" Width="280"
                                                        DisplayMemberBinding="{Binding SheetName}"/>
                                        <GridViewColumn Header="Format" Width="80"
                                                        DisplayMemberBinding="{Binding Format}"/>
                                        <GridViewColumn Header="Size" Width="80"
                                                        DisplayMemberBinding="{Binding Size}"/>
                                        <GridViewColumn Header="Orientation" Width="90"
                                                        DisplayMemberBinding="{Binding Orientation}"/>
                                        <GridViewColumn Header="Progress" Width="240">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <ProgressBar Grid.Row="0" Value="{Binding Progress}" Height="8" Minimum="0" Maximum="100" Margin="0,0,0,4" Style="{StaticResource T3.ProgressBar}"/>
                                                        <TextBlock Grid.Row="1" Text="{Binding Status}" FontSize="11" Foreground="{StaticResource T3.Success.Accent}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>

                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <!-- Status row: label left, percentage right (UIStandardShowcase pattern) -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock x:Name="progress_text"
                                           Text="Ready to export"
                                           FontSize="13" Foreground="{StaticResource T3.TextSecondary}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="progress_percent"
                                           Text=""
                                           HorizontalAlignment="Right"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource T3.Progress.Fill}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar x:Name="overall_progress"
                                         Height="8" Minimum="0" Maximum="100" Value="0">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource T3.ProgressBar}">
                                        <Style.Triggers>
                                            <Trigger Property="Value" Value="100">
                                                <Setter Property="Foreground" Value="{StaticResource T3.Success.Accent}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
                </TabControl>
            </Border>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- ROW 2 / COL 1: FOOTER / ACTION BAR                          -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Grid.Column="1"
                    Background="{StaticResource T3.SurfaceSunken}" BorderBrush="{StaticResource T3.Border}" BorderThickness="0,1,0,0" Padding="16,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: copyright + status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource T3.Copyright}"/>
                        <Border Width="1" Height="14" Background="{StaticResource T3.Border}" VerticalAlignment="Center" Margin="12,0,12,0"/>
                        <TextBlock x:Name="status_text"
                                   Text="Ready | 0 sheets | Revit" FontSize="12.5" Foreground="{StaticResource T3.TextMuted}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Action buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="back_button"
                                Content="Back"
                                Style="{StaticResource T3.Button.Secondary}"
                                Click="go_back"
                                Margin="0,0,8,0"
                                Width="100"
                                Visibility="Collapsed"/>

                        <Button x:Name="next_button"
                                Style="{StaticResource T3.Button.Primary}"
                                Click="go_next"
                                IsDefault="True"
                                Width="100">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="next_button_text" Text="Next" FontWeight="Medium"/>
                                <TextBlock x:Name="next_button_icon" Text="→" FontFamily="Segoe UI" FontWeight="Medium" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
