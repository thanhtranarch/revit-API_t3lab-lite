                                <Border Background="{StaticResource T3.SurfaceSunken}" CornerRadius="4,4,0,0" Cursor="Hand"
                                        MouseLeftButtonUp="dwg_header_clicked">
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="export_dwg" Grid.Column="0"
                                                  Content="DWG" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource T3.Ink}"
                                                  Checked="format_changed" Unchecked="format_changed"/>
                                        <TextBlock Grid.Column="1" Text="AutoCAD Drawing File"
                                                   FontSize="11" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock x:Name="dwg_expand_arrow" Grid.Column="2"
                                                   Text="▾" FontSize="13" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="dwg_settings_body" Background="White"
                                        BorderBrush="{StaticResource T3.Border}" BorderThickness="0,1,0,0"
                                        Padding="16,16" CornerRadius="0,0,4,4"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/> <!-- Spacer -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Column: Setup -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Export Setup" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                            
                                            <TextBlock Text="AutoCAD Version" FontSize="11" Foreground="{StaticResource T3.TextSecondary}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="dwg_version" Height="32" SelectedIndex="0" Style="{StaticResource T3.ComboBox}" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="AutoCAD 2013"/>
                                                <ComboBoxItem Content="AutoCAD 2010"/>
                                                <ComboBoxItem Content="AutoCAD 2007"/>
                                            </ComboBox>
                                            
                                            <TextBlock Text="DWG Export Setup" FontSize="11" Foreground="{StaticResource T3.TextSecondary}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="cad_export_setup" Height="32" SelectedIndex="0" Style="{StaticResource T3.ComboBox}" Margin="0,0,0,4" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="Use setup from file"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Vertical Separator -->
                                        <Border Grid.Column="1" Width="1" Background="{StaticResource T3.Border}" HorizontalAlignment="Center" Margin="4,0"/>

                                        <!-- Right Column: Options -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Export Options" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                            <CheckBox x:Name="cad_export_views_on_sheets" Content="Export views on sheets" IsChecked="False" Margin="0,4"/>
                                            <CheckBox x:Name="cad_export_links_as_external" Content="Export links as external references" IsChecked="False" Margin="0,4"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ═══ DGN ═══ -->
                        <Border x:Name="dgn_panel_border" BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,0,4">
                            <StackPanel>
                                <Border Background="{StaticResource T3.SurfaceSunken}" CornerRadius="4" Cursor="Hand"
                                        MouseLeftButtonUp="dgn_header_clicked">
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="export_dgn" Grid.Column="0"
                                                  Content="DGN" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource T3.Ink}"
                                                  Checked="format_changed" Unchecked="format_changed"/>
                                        <TextBlock Grid.Column="1" Text="MicroStation Design File"
                                                   FontSize="11" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock x:Name="dgn_expand_arrow" Grid.Column="2"
                                                   Text="▾" FontSize="13" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="dgn_settings_body" Background="White"
                                        BorderBrush="{StaticResource T3.Border}" BorderThickness="0,1,0,0"
                                        Padding="16,8" CornerRadius="0,0,4,4"
                                        Visibility="Collapsed">
                                    <TextBlock Text="Uses Revit's default DGN export settings. No additional configuration required."
                                               FontSize="11" Foreground="{StaticResource T3.TextSecondary}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ═══ DWF ═══ -->
                        <Border x:Name="dwf_panel_border" BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,0,4">
                            <StackPanel>
                                <Border Background="{StaticResource T3.SurfaceSunken}" CornerRadius="4" Cursor="Hand"
                                        MouseLeftButtonUp="dwf_header_clicked">
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="export_dwf" Grid.Column="0"
                                                  Content="DWF" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource T3.Ink}"
                                                  Checked="format_changed" Unchecked="format_changed"/>
                                        <TextBlock Grid.Column="1" Text="Design Web Format"
                                                   FontSize="11" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock x:Name="dwf_expand_arrow" Grid.Column="2"
                                                   Text="▾" FontSize="13" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="dwf_settings_body" Background="White"
                                        BorderBrush="{StaticResource T3.Border}" BorderThickness="0,1,0,0"
                                        Padding="16,8" CornerRadius="0,0,4,4"
                                        Visibility="Collapsed">
                                    <TextBlock Text="Uses Revit's default DWF export settings. No additional configuration required."
                                               FontSize="11" Foreground="{StaticResource T3.TextSecondary}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ═══ NWC ═══ -->
                        <Border x:Name="nwc_panel_border" BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,0,4">
                            <StackPanel>
                                <Border Background="{StaticResource T3.SurfaceSunken}" CornerRadius="4" Cursor="Hand"
                                        MouseLeftButtonUp="nwc_header_clicked">
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="export_nwd" Grid.Column="0"
                                                  Content="NWC" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource T3.Ink}"
                                                  Checked="format_changed" Unchecked="format_changed"
                                                  ToolTip="Requires Navisworks to be installed"/>
                                        <TextBlock Grid.Column="1" Text="Navisworks Cache File"
                                                   FontSize="11" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock x:Name="nwc_expand_arrow" Grid.Column="2"
                                                   Text="▾" FontSize="13" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="nwc_settings_body" Background="White"
                                        BorderBrush="{StaticResource T3.Border}" BorderThickness="0,1,0,0"
                                        Padding="16,8" CornerRadius="0,0,4,4"
                                        Visibility="Collapsed">
                                    <TextBlock Text="Exports each view/sheet as a separate NWC file. Requires Navisworks Exporters to be installed."
                                               FontSize="11" Foreground="{StaticResource T3.TextSecondary}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ═══ IFC ═══ -->
                        <Border x:Name="ifc_panel_border" BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,0,4">
                            <StackPanel>
                                <Border Background="{StaticResource T3.SurfaceSunken}" CornerRadius="4,4,0,0" Cursor="Hand"
                                        MouseLeftButtonUp="ifc_header_clicked">
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="export_ifc" Grid.Column="0"
                                                  Content="IFC" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource T3.Ink}"
                                                  Checked="format_changed" Unchecked="format_changed"/>
                                        <TextBlock Grid.Column="1" Text="Industry Foundation Classes"
                                                   FontSize="11" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock x:Name="ifc_expand_arrow" Grid.Column="2"
                                                   Text="▾" FontSize="13" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="ifc_settings_body" Background="White"
                                        BorderBrush="{StaticResource T3.Border}" BorderThickness="0,1,0,0"
                                        Padding="16,16" CornerRadius="0,0,4,4"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="IFC Export Settings" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="IFC Version:" VerticalAlignment="Center" Foreground="{StaticResource T3.TextSecondary}" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="ifc_version" Height="32" SelectedIndex="1" Style="{StaticResource T3.ComboBox}" Width="160">
                                                <ComboBoxItem Content="IFC 2x2"/>
                                                <ComboBoxItem Content="IFC 2x3"/>
                                                <ComboBoxItem Content="IFC 4"/>
                                            </ComboBox>
                                        </StackPanel>
                                        
                                        <TextBlock Text="Note: IFC exports the entire Revit model — one .ifc file regardless of sheet/view selection."
                                                   FontSize="11" Foreground="{StaticResource T3.TextSecondary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ═══ IMG ═══ -->
                        <Border x:Name="img_panel_border" BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,0,4">
                            <StackPanel>
                                <Border Background="{StaticResource T3.SurfaceSunken}" CornerRadius="4,4,0,0" Cursor="Hand"
                                        MouseLeftButtonUp="img_header_clicked">
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="export_img" Grid.Column="0"
                                                  Content="IMG" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource T3.Ink}"
                                                  Checked="format_changed" Unchecked="format_changed"/>
                                        <TextBlock Grid.Column="1" Text="PNG / JPEG Image"
                                                   FontSize="11" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock x:Name="img_expand_arrow" Grid.Column="2"
                                                   Text="▾" FontSize="13" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="img_settings_body" Background="White"
                                        BorderBrush="{StaticResource T3.Border}" BorderThickness="0,1,0,0"
                                        Padding="16,16" CornerRadius="0,0,4,4"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/> <!-- Spacer -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Column: Sizing & File Mode -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Image Sizing" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                            
                                            <!-- Fit to pixels option -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <RadioButton x:Name="img_fit_to_page" Content="Fit to" GroupName="imgSize"
                                                             IsChecked="True" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBox x:Name="img_fit_pixels" Text="1080" Width="60" Height="32"
                                                         Style="{StaticResource T3.TextBox}" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                                                <TextBlock Text="pixels" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{StaticResource T3.TextSecondary}"/>
                                                
                                                <TextBlock Text="Dir:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource T3.TextSecondary}"/>
                                                <RadioButton x:Name="img_dir_horizontal" Content="H" GroupName="imgDirection"
                                                             IsChecked="True" Margin="0,0,8,0" ToolTip="Horizontal"/>
                                                <RadioButton x:Name="img_dir_vertical" Content="V" GroupName="imgDirection" ToolTip="Vertical"/>
                                            </StackPanel>
                                            
                                            <!-- Zoom to percent option -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                                <RadioButton x:Name="img_zoom_to" Content="Zoom to" GroupName="imgSize"
                                                             Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBox x:Name="img_zoom_percent" Text="50" Width="55" Height="32"
                                                         Style="{StaticResource T3.TextBox}" Margin="0,0,4,0" VerticalContentAlignment="Center"/>
                                                <TextBlock Text="% of actual size" VerticalAlignment="Center" Foreground="{StaticResource T3.TextSecondary}"/>
                                            </StackPanel>

                                            <TextBlock Text="File Options" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                            <RadioButton x:Name="img_separate_files" Content="Create separate images" GroupName="imgFile"
                                                         IsChecked="True" Margin="0,4"/>
                                            <RadioButton x:Name="img_combined_html" Content="Combine into single HTML file" GroupName="imgFile"
                                                         Margin="0,4"/>
                                        </StackPanel>

                                        <!-- Vertical Separator -->
                                        <Border Grid.Column="1" Width="1" Background="{StaticResource T3.Border}" HorizontalAlignment="Center" Margin="4,0"/>

                                        <!-- Right Column: Format & Quality -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Format &amp; Quality" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                            
                                            <TextBlock Text="Shaded Views Format" FontSize="11" Foreground="{StaticResource T3.TextSecondary}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="img_shaded_format" Height="32" SelectedIndex="0" Style="{StaticResource T3.ComboBox}" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="PNG"/>
                                                <ComboBoxItem Content="JPEG"/>
                                            </ComboBox>
                                            
                                            <TextBlock Text="Non-Shaded Views Format" FontSize="11" Foreground="{StaticResource T3.TextSecondary}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="img_nonshaded_format" Height="32" SelectedIndex="0" Style="{StaticResource T3.ComboBox}" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="PNG"/>
                                                <ComboBoxItem Content="JPEG"/>
                                            </ComboBox>
                                            
                                            <TextBlock Text="Raster Quality" FontSize="11" Foreground="{StaticResource T3.TextSecondary}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="img_dpi" Height="32" SelectedIndex="2" Style="{StaticResource T3.ComboBox}" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="72 DPI"/><ComboBoxItem Content="96 DPI"/>
                                                <ComboBoxItem Content="150 DPI"/><ComboBoxItem Content="300 DPI"/>
                                                <ComboBoxItem Content="600 DPI"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Queue Tab -->
            <!-- Queue + Settings (combined) -->
            <TabItem Header="Queue" Style="{StaticResource T3.TabItem.Hidden}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── SETTINGS CARD ── -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                            Padding="12,8" Background="{StaticResource T3.SurfaceSunken}" CornerRadius="4" Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Output Folder -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Output Folder:" VerticalAlignment="Center"
                                           FontWeight="Medium" FontSize="13"/>
                                <TextBox x:Name="output_folder" Grid.Column="1" Height="32"
                                         Style="{StaticResource T3.TextBox}" Margin="4,0"/>
                                <Button Grid.Column="2" Content="Browse" Height="28" Padding="12,4" FontSize="13"
                                        Style="{StaticResource T3.Button.Secondary}" Click="browse_output_folder"/>
                            </Grid>

                            <!-- Organize + Reverse on one row -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Organize:" VerticalAlignment="Center"
                                           FontWeight="Medium" FontSize="13" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="save_same_folder" Content="Same folder"
                                                 GroupName="organization" IsChecked="True" Margin="0,0,12,0"/>
                                    <RadioButton x:Name="save_split_by_format" Content="Split by format"
                                                 GroupName="organization"/>
                                </StackPanel>

                                <CheckBox x:Name="reverse_order" Grid.Column="3" Content="Reverse order"
                                          VerticalAlignment="Center"
                                          Checked="reverse_order_changed" Unchecked="reverse_order_changed"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ── QUEUE SECTION ── -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Export Queue" Style="{StaticResource T3.Label}"/>

                        <Border Grid.Row="1" BorderBrush="{StaticResource T3.Border}" BorderThickness="1" Margin="0,4" CornerRadius="4">
                            <ListView VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="export_preview_list"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Sheet Number" Width="250"
                                                        DisplayMemberBinding="{Binding SheetNumber}"/>
                                        <GridViewColumn Header="Sheet Name" Width="280"
                                                        DisplayMemberBinding="{Binding SheetName}"/>
                                        <GridViewColumn Header="Format" Width="80"
                                                        DisplayMemberBinding="{Binding Format}"/>
                                        <GridViewColumn Header="Size" Width="80"
                                                        DisplayMemberBinding="{Binding Size}"/>
                                        <GridViewColumn Header="Orientation" Width="90"
                                                        DisplayMemberBinding="{Binding Orientation}"/>
                                        <GridViewColumn Header="Progress" Width="240">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <ProgressBar Grid.Row="0" Value="{Binding Progress}" Height="8" Minimum="0" Maximum="100" Margin="0,0,0,4" Style="{StaticResource T3.ProgressBar}"/>
                                                        <TextBlock Grid.Row="1" Text="{Binding Status}" FontSize="11" Foreground="{StaticResource T3.Success.Accent}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>

                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <!-- Status row: label left, percentage right (UIStandardShowcase pattern) -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock x:Name="progress_text"
                                           Text="Ready to export"
                                           FontSize="13" Foreground="{StaticResource T3.TextSecondary}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="progress_percent"
                                           Text=""
                                           HorizontalAlignment="Right"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource T3.Progress.Fill}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar x:Name="overall_progress"
                                         Height="8" Minimum="0" Maximum="100" Value="0">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource T3.ProgressBar}">
                                        <Style.Triggers>
                                            <Trigger Property="Value" Value="100">
                                                <Setter Property="Foreground" Value="{StaticResource T3.Success.Accent}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
                </TabControl>
            </Border>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- ROW 2 / COL 1: FOOTER / ACTION BAR                          -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Grid.Column="1"
                    Background="{StaticResource T3.SurfaceSunken}" BorderBrush="{StaticResource T3.Border}" BorderThickness="0,1,0,0" Padding="16,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: copyright + status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource T3.Copyright}"/>
                        <Border Width="1" Height="14" Background="{StaticResource T3.Border}" VerticalAlignment="Center" Margin="12,0,12,0"/>
                        <TextBlock x:Name="status_text"
                                   Text="Ready | 0 sheets | Revit" FontSize="12.5" Foreground="{StaticResource T3.TextMuted}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Action buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="back_button"
                                Content="Back"
                                Style="{StaticResource T3.Button.Secondary}"
                                Click="go_back"
                                Margin="0,0,8,0"
                                Width="100"
                                Visibility="Collapsed"/>

                        <Button x:Name="next_button"
                                Style="{StaticResource T3.Button.Primary}"
                                Click="go_next"
                                IsDefault="True"
                                Width="100">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="next_button_text" Text="Next" FontWeight="Medium"/>
                                <TextBlock x:Name="next_button_icon" Text="→" FontFamily="Segoe UI" FontWeight="Medium" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
