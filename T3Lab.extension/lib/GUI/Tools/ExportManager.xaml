<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="BatchOut"
        Width="1280" Height="780"
        MinWidth="1200" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Background="{DynamicResource T3.Canvas}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        ContentRendered="window_content_rendered">

        <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                       ResizeBorderThickness="5"
                       GlassFrameThickness="0"
                       CornerRadius="8"
                       UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
        <!-- ═══ T3 STYLES — SINH TỰ ĐỘNG, ĐỪNG SỬA Ở ĐÂY. Sửa `pyRevit UI Design System/T3Lab.Styles.xaml` rồi chạy `python3 dev/sync_t3_styles.py` ═══ -->
          <!-- ══════════════════ 1 · COLOUR ══════════════════ -->
          <SolidColorBrush x:Key="T3.Ink"            Color="#18181B"/>
          <SolidColorBrush x:Key="T3.Text"           Color="#27272A"/>
          <SolidColorBrush x:Key="T3.TextSecondary"  Color="#52525B"/>
          <SolidColorBrush x:Key="T3.TextMuted"      Color="#71717A"/>
          <SolidColorBrush x:Key="T3.TextDisabled"   Color="#9A9AA2"/>
          <SolidColorBrush x:Key="T3.Border"         Color="#DCDCE0"/>
          <SolidColorBrush x:Key="T3.BorderStrong"   Color="#A1A1AA"/>
          <SolidColorBrush x:Key="T3.SurfaceSunken"  Color="#F4F4F6"/>
          <SolidColorBrush x:Key="T3.Canvas"         Color="#E4E4E7"/>
          <SolidColorBrush x:Key="T3.Surface"        Color="#FFFFFF"/>
          <SolidColorBrush x:Key="T3.RowAlt"         Color="#FAFAFB"/>
          <SolidColorBrush x:Key="T3.RowRule"        Color="#F1F1F4"/>

          <SolidColorBrush x:Key="T3.Success.Fill"   Color="#EAF8F0"/>
          <SolidColorBrush x:Key="T3.Success.Accent" Color="#22A85C"/>
          <SolidColorBrush x:Key="T3.Success.Text"   Color="#157038"/>
          <SolidColorBrush x:Key="T3.Warning.Fill"   Color="#FFF6E6"/>
          <SolidColorBrush x:Key="T3.Warning.Accent" Color="#F5CE5A"/>
          <SolidColorBrush x:Key="T3.Warning.Text"   Color="#8A6308"/>
          <SolidColorBrush x:Key="T3.Danger.Fill"    Color="#FDECEC"/>
          <SolidColorBrush x:Key="T3.Danger.Accent"  Color="#F87171"/>
          <SolidColorBrush x:Key="T3.Danger.Text"    Color="#D23B3B"/>
          <SolidColorBrush x:Key="T3.Danger.Border"  Color="#F6D5D5"/>

          <!-- Amber CHỈ dùng cho dòng copyright ở footer. Không button, không border, không nhãn khác. -->
          <SolidColorBrush x:Key="T3.Copyright.Fg"   Color="#F59E0B"/>

          <!-- Cam CHỈ dùng cho tiến trình đang chạy. Không button, không border, không brand. -->
          <SolidColorBrush x:Key="T3.Progress.Track" Color="#ECECEF"/>
          <SolidColorBrush x:Key="T3.Progress.Fill"  Color="#C2410C"/>

          <!-- ══════════════════ 2 · TYPE ══════════════════ -->
          <FontFamily x:Key="T3.Font">Segoe UI</FontFamily>
          <FontFamily x:Key="T3.Font.Mono">Consolas</FontFamily>
          <sys:Double x:Key="T3.Size.Display">19</sys:Double>
          <sys:Double x:Key="T3.Size.Title">15</sys:Double>
          <sys:Double x:Key="T3.Size.Body">13</sys:Double>
          <sys:Double x:Key="T3.Size.Caption">11.5</sys:Double>
          <sys:Double x:Key="T3.Size.Label">11</sys:Double>
          <sys:Double x:Key="T3.Size.Mono">12.5</sys:Double>

          <!-- ══════════════════ 3 · METRICS ══════════════════ -->
          <sys:Double x:Key="T3.H.Row">26</sys:Double>
          <sys:Double x:Key="T3.H.Control">28</sys:Double>
          <sys:Double x:Key="T3.H.Action">30</sys:Double>
          <sys:Double x:Key="T3.H.TitleBar">40</sys:Double>
          <sys:Double x:Key="T3.H.Footer">48</sys:Double>
          <Thickness x:Key="T3.Pad.Panel">16</Thickness>
          <Thickness x:Key="T3.Pad.Field">8,0</Thickness>
          <CornerRadius x:Key="T3.R.Window">8</CornerRadius>
          <CornerRadius x:Key="T3.R.Control">4</CornerRadius>
          <CornerRadius x:Key="T3.R.Pill">2</CornerRadius>

          <!-- ══════════════════ 4 · TEXT STYLES ══════════════════ -->
          <Style x:Key="T3.Display" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Display}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource T3.Ink}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
          </Style>

          <Style x:Key="T3.Title" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Title}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource T3.Ink}"/>
          </Style>

          <Style x:Key="T3.Body" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource T3.Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
          </Style>

          <Style x:Key="T3.Body.Secondary" TargetType="TextBlock" BasedOn="{StaticResource T3.Body}">
            <Setter Property="Foreground" Value="{StaticResource T3.TextSecondary}"/>
          </Style>

          <Style x:Key="T3.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource T3.Body}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource T3.Ink}"/>
          </Style>

          <Style x:Key="T3.Caption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Caption}"/>
            <Setter Property="Foreground" Value="{StaticResource T3.TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
          </Style>

          <!-- Label uppercase, luôn nằm TRÊN control, cách control 4px -->
          <Style x:Key="T3.Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Label}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource T3.TextDisabled}"/>
          </Style>

          <!-- Dòng copyright BẮT BUỘC ở footer, sát trái, trước câu trạng thái.
               Đúng một dòng mỗi cửa sổ. Ký tự © phải là ký tự thật, không dùng &#169;. -->
          <Style x:Key="T3.Copyright" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Label}"/>
            <Setter Property="Foreground" Value="{StaticResource T3.Copyright.Fg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Text" Value="© Copyright by T3Lab"/>
          </Style>

          <Style x:Key="T3.Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font.Mono}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Mono}"/>
            <Setter Property="Foreground" Value="{StaticResource T3.TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
          </Style>

          <Style x:Key="T3.Empty" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource T3.TextDisabled}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping"  Value="Wrap"/>
          </Style>

          <!-- Cell style cho DataGridTextColumn.ElementStyle -->
          <Style x:Key="T3.Cell.Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font.Mono}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Mono}"/>
            <Setter Property="Foreground" Value="{StaticResource T3.TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
          </Style>

          <Style x:Key="T3.Cell.Number" TargetType="TextBlock" BasedOn="{StaticResource T3.Cell.Mono}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
          </Style>

          <!-- ══════════════════ 5 · SEPARATOR / RULE ══════════════════ -->
          <Style x:Key="T3.Rule" TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource T3.Border}"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Separator">
                  <Border Height="1" Background="{TemplateBinding Background}"/>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <!-- ══════════════════ 6 · BUTTONS ══════════════════
               Chỉ một primary mỗi window, nằm ngoài cùng bên phải footer. -->
          <Style x:Key="T3.Button.Base" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height"     Value="{StaticResource T3.H.Action}"/>
            <Setter Property="MinWidth"   Value="72"/>
            <Setter Property="Padding"    Value="14,0"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="bd"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{StaticResource T3.R.Control}"
                          Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                      <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource T3.Ink}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <Style x:Key="T3.Button.Primary" TargetType="Button" BasedOn="{StaticResource T3.Button.Base}">
            <Setter Property="Background"  Value="{StaticResource T3.Ink}"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource T3.Ink}"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background"  Value="#000000"/>
                <Setter Property="BorderBrush" Value="#000000"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background"  Value="{StaticResource T3.SurfaceSunken}"/>
                <Setter Property="BorderBrush" Value="{StaticResource T3.Border}"/>
                <Setter Property="Foreground"  Value="{StaticResource T3.TextDisabled}"/>
                <Setter Property="Cursor"      Value="Arrow"/>
              </Trigger>
            </Style.Triggers>
          </Style>

          <Style x:Key="T3.Button.Secondary" TargetType="Button" BasedOn="{StaticResource T3.Button.Base}">
            <Setter Property="Background"  Value="{StaticResource T3.Surface}"/>
            <Setter Property="Foreground"  Value="{StaticResource T3.Text}"/>
            <Setter Property="BorderBrush" Value="#DEDEE2"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background"  Value="#FAFAFB"/>
                <Setter Property="BorderBrush" Value="#CFCFD5"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground"  Value="{StaticResource T3.TextDisabled}"/>
                <Setter Property="BorderBrush" Value="{StaticResource T3.Border}"/>
                <Setter Property="Cursor"      Value="Arrow"/>
              </Trigger>
            </Style.Triggers>
          </Style>

          <Style x:Key="T3.Button.Ghost" TargetType="Button" BasedOn="{StaticResource T3.Button.Base}">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="{StaticResource T3.TextSecondary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#EDEDEF"/>
                <Setter Property="Foreground" Value="{StaticResource T3.Ink}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource T3.TextDisabled}"/>
                <Setter Property="Cursor"     Value="Arrow"/>
              </Trigger>
            </Style.Triggers>
          </Style>

          <!-- Nút phá huỷ: thứ duy nhất màu đỏ trong standard. KHÔNG bao giờ IsDefault. -->
          <Style x:Key="T3.Button.Danger" TargetType="Button" BasedOn="{StaticResource T3.Button.Base}">
            <Setter Property="Background"  Value="{StaticResource T3.Danger.Text}"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource T3.Danger.Text}"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background"  Value="#B92E2E"/>
                <Setter Property="BorderBrush" Value="#B92E2E"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background"  Value="{StaticResource T3.SurfaceSunken}"/>
                <Setter Property="BorderBrush" Value="{StaticResource T3.Border}"/>
                <Setter Property="Foreground"  Value="{StaticResource T3.TextDisabled}"/>
              </Trigger>
            </Style.Triggers>
          </Style>

          <!-- ══════════════════ 7 · INPUTS ══════════════════ -->
          <Style x:Key="T3.TextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource T3.Text}"/>
            <Setter Property="Background" Value="{StaticResource T3.SurfaceSunken}"/>
            <Setter Property="BorderBrush" Value="{StaticResource T3.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"  Value="{StaticResource T3.H.Control}"/>
            <Setter Property="Padding" Value="{StaticResource T3.Pad.Field}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                  <Border x:Name="bd"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{StaticResource T3.R.Control}"
                          Padding="{TemplateBinding Padding}">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsFocused" Value="True">
                      <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource T3.Ink}"/>
                      <Setter TargetName="bd" Property="Background"  Value="{StaticResource T3.Surface}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter Property="Foreground" Value="{StaticResource T3.TextDisabled}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <Style x:Key="T3.TextBox.Mono" TargetType="TextBox" BasedOn="{StaticResource T3.TextBox}">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font.Mono}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Mono}"/>
          </Style>

          <Style x:Key="T3.ComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource T3.Text}"/>
            <Setter Property="Height"     Value="{StaticResource T3.H.Row}"/>
            <Setter Property="Padding"    Value="8,0"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="{StaticResource T3.SurfaceSunken}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <Style x:Key="T3.ComboBox" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource T3.Text}"/>
            <Setter Property="Background" Value="{StaticResource T3.Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource T3.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"  Value="{StaticResource T3.H.Control}"/>
            <Setter Property="Padding" Value="{StaticResource T3.Pad.Field}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource T3.ComboBoxItem}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                  <Grid>
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource T3.R.Control}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="24"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False"/>
                        <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                      Background="Transparent" BorderThickness="0"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                          <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                              <Border Background="Transparent"/>
                            </ControlTemplate>
                          </ToggleButton.Template>
                        </ToggleButton>
                        <Path Grid.Column="1"
                              Data="M6 9 L12 15 L18 9"
                              Stroke="{StaticResource T3.TextMuted}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="10" Height="10" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsHitTestVisible="False"/>
                      </Grid>
                    </Border>
                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                           IsOpen="{Binding IsDropDownOpen, Mode=TwoWay,
                                    RelativeSource={RelativeSource TemplatedParent}}">
                      <Border Background="{StaticResource T3.Surface}"
                              BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                              CornerRadius="{StaticResource T3.R.Control}"
                              MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                              MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <ScrollViewer>
                          <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                      </Border>
                    </Popup>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource T3.Ink}"/>
                    </Trigger>
                    <Trigger Property="IsDropDownOpen" Value="True">
                      <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource T3.Ink}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="bd" Property="Background" Value="{StaticResource T3.SurfaceSunken}"/>
                      <Setter Property="Foreground" Value="{StaticResource T3.TextDisabled}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <Style x:Key="T3.CheckBox" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource T3.Text}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="box" Grid.Column="0" Width="15" Height="15" Margin="0,0,8,0"
                            Background="{StaticResource T3.Surface}"
                            BorderBrush="#D4D4DA" BorderThickness="1.5"
                            CornerRadius="3" VerticalAlignment="Center">
                      <Path x:Name="mark" Data="M4,9 L8,13 L14,5"
                            Stroke="White" StrokeThickness="2"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            Visibility="Collapsed"/>
                    </Border>
                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="box"  Property="Background"  Value="{StaticResource T3.Ink}"/>
                      <Setter TargetName="box"  Property="BorderBrush" Value="{StaticResource T3.Ink}"/>
                      <Setter TargetName="mark" Property="Visibility"  Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource T3.Ink}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="box" Property="Background"  Value="{StaticResource T3.SurfaceSunken}"/>
                      <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource T3.Border}"/>
                      <Setter Property="Foreground" Value="{StaticResource T3.TextDisabled}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <Style x:Key="T3.RadioButton" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource T3.Text}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                  <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ring" Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0"
                            Background="{StaticResource T3.Surface}"
                            BorderBrush="#D4D4DA" BorderThickness="1.5"
                            CornerRadius="8" VerticalAlignment="Center">
                      <Ellipse x:Name="dot" Width="8" Height="8"
                               Fill="{StaticResource T3.Ink}" Visibility="Collapsed"/>
                    </Border>
                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource T3.Ink}"/>
                      <Setter TargetName="dot"  Property="Visibility"  Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource T3.Ink}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="ring" Property="Background"  Value="{StaticResource T3.SurfaceSunken}"/>
                      <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource T3.Border}"/>
                      <Setter Property="Foreground" Value="{StaticResource T3.TextDisabled}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <!-- ══════════════════ 8 · PROGRESS ══════════════════ -->
          <Style x:Key="T3.ProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background"  Value="{StaticResource T3.Progress.Track}"/>
            <Setter Property="Foreground"  Value="{StaticResource T3.Progress.Fill}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                  <Border Background="{TemplateBinding Background}"
                          CornerRadius="{StaticResource T3.R.Pill}" ClipToBounds="True">
                    <Grid>
                      <Rectangle x:Name="PART_Track"/>
                      <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                 Fill="{TemplateBinding Foreground}"/>
                    </Grid>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <!-- ══════════════════ 9 · LIST / LOG ══════════════════ -->
          <Style x:Key="T3.ListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="{StaticResource T3.H.Row}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="bd" Background="Transparent"
                          BorderThickness="3,0,0,0" BorderBrush="Transparent"
                          Padding="13,0,16,0">
                    <ContentPresenter VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="{StaticResource T3.SurfaceSunken}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="bd" Property="Background"  Value="{StaticResource T3.Canvas}"/>
                      <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource T3.Ink}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <Style x:Key="T3.ListBox" TargetType="ListBox">
            <Setter Property="Background"  Value="{StaticResource T3.Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource T3.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource T3.ListBoxItem}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
          </Style>

          <Style x:Key="T3.LogBox" TargetType="ListBox" BasedOn="{StaticResource T3.ListBox}">
            <Setter Property="Background" Value="{StaticResource T3.SurfaceSunken}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontFamily" Value="{StaticResource T3.Font.Mono}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Mono}"/>
            <Setter Property="ItemContainerStyle">
              <Setter.Value>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="2,0"/>
                  <Setter Property="Focusable" Value="False"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Setter.Value>
            </Setter>
          </Style>

          <!-- ══════════════════ 10 · DATAGRID ══════════════════ -->
          <Style x:Key="T3.DataGridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Label}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource T3.TextDisabled}"/>
            <Setter Property="Background" Value="{StaticResource T3.Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource T3.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height"  Value="{StaticResource T3.H.Row}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
          </Style>

          <Style x:Key="T3.DataGridRow" TargetType="DataGridRow">
            <Setter Property="Height" Value="{StaticResource T3.H.Row}"/>
            <Setter Property="Background" Value="{StaticResource T3.Surface}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
              <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{StaticResource T3.RowAlt}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource T3.SurfaceSunken}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background"  Value="{StaticResource T3.Canvas}"/>
                <Setter Property="Foreground"  Value="{StaticResource T3.Text}"/>
                <Setter Property="BorderBrush" Value="{StaticResource T3.Ink}"/>
                <Setter Property="BorderThickness" Value="3,0,0,0"/>
              </Trigger>
            </Style.Triggers>
          </Style>

          <Style x:Key="T3.DataGridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                  <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center"/>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <Style x:Key="T3.DataGrid" TargetType="DataGrid">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource T3.Text}"/>
            <Setter Property="Background" Value="{StaticResource T3.Surface}"/>
            <Setter Property="RowBackground" Value="{StaticResource T3.Surface}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource T3.RowAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource T3.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="{StaticResource T3.H.Row}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource T3.RowRule}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource T3.DataGridColumnHeader}"/>
            <Setter Property="RowStyle"          Value="{StaticResource T3.DataGridRow}"/>
            <Setter Property="CellStyle"         Value="{StaticResource T3.DataGridCell}"/>
          </Style>

          <!-- Status pill: nền tint + dot + CHỮ. Không bao giờ chỉ dùng màu.
               Row VM cần 2 property: StatusText (string) và Severity ("Success"/"Warning"/"Danger"). -->
          <DataTemplate x:Key="T3.StatusPill">
            <Border x:Name="pill" CornerRadius="2" Padding="7,2"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="dot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="txt" Text="{Binding StatusText}"
                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Severity}" Value="Success">
                <Setter TargetName="pill" Property="Background" Value="{StaticResource T3.Success.Fill}"/>
                <Setter TargetName="dot"  Property="Fill"       Value="{StaticResource T3.Success.Accent}"/>
                <Setter TargetName="txt"  Property="Foreground" Value="{StaticResource T3.Success.Text}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Severity}" Value="Warning">
                <Setter TargetName="pill" Property="Background" Value="{StaticResource T3.Warning.Fill}"/>
                <Setter TargetName="dot"  Property="Fill"       Value="{StaticResource T3.Warning.Accent}"/>
                <Setter TargetName="txt"  Property="Foreground" Value="{StaticResource T3.Warning.Text}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Severity}" Value="Danger">
                <Setter TargetName="pill" Property="Background" Value="{StaticResource T3.Danger.Fill}"/>
                <Setter TargetName="dot"  Property="Fill"       Value="{StaticResource T3.Danger.Accent}"/>
                <Setter TargetName="txt"  Property="Foreground" Value="{StaticResource T3.Danger.Text}"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>

          <!-- ══════════════════ 11 · EXPANDER ══════════════════ -->
          <Style x:Key="T3.Expander" TargetType="Expander">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource T3.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource T3.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Expander">
                  <Border BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{StaticResource T3.R.Control}">
                    <StackPanel>
                      <ToggleButton x:Name="hdr" Height="{StaticResource T3.H.Control}"
                                    Cursor="Hand" FocusVisualStyle="{x:Null}"
                                    IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                RelativeSource={RelativeSource TemplatedParent}}">
                        <ToggleButton.Template>
                          <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="hb" Background="{StaticResource T3.SurfaceSunken}" Padding="10,0">
                              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="chev" Data="M8 5 L14 11 L8 17"
                                      Stroke="{StaticResource T3.TextMuted}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="8" Height="8" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="0,0,7,0"
                                      RenderTransformOrigin="0.5,0.5"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                              </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chev" Property="RenderTransform">
                                  <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                </Setter>
                              </Trigger>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hb" Property="Background" Value="#EDEDEF"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </ToggleButton.Template>
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                      </ToggleButton>
                      <ContentPresenter x:Name="body" Visibility="Collapsed" Margin="12"/>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsExpanded" Value="True">
                      <Setter TargetName="body" Property="Visibility" Value="Visible"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <!-- ══════════════════ 12 · CHROME: CALLOUT, FOOTER, TITLE BAR ══════════════════ -->
          <Style x:Key="T3.Callout" TargetType="Border">
            <Setter Property="Background"  Value="{StaticResource T3.SurfaceSunken}"/>
            <Setter Property="BorderBrush" Value="{StaticResource T3.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource T3.R.Control}"/>
            <Setter Property="Padding" Value="10,8"/>
          </Style>

          <Style x:Key="T3.Callout.Success" TargetType="Border" BasedOn="{StaticResource T3.Callout}">
            <Setter Property="Background"  Value="{StaticResource T3.Success.Fill}"/>
            <Setter Property="BorderBrush" Value="#CDEBD9"/>
          </Style>

          <Style x:Key="T3.Callout.Warning" TargetType="Border" BasedOn="{StaticResource T3.Callout}">
            <Setter Property="Background"  Value="{StaticResource T3.Warning.Fill}"/>
            <Setter Property="BorderBrush" Value="#F0DCA8"/>
          </Style>

          <Style x:Key="T3.Callout.Danger" TargetType="Border" BasedOn="{StaticResource T3.Callout}">
            <Setter Property="Background"  Value="{StaticResource T3.Danger.Fill}"/>
            <Setter Property="BorderBrush" Value="{StaticResource T3.Danger.Border}"/>
          </Style>

          <!-- Footer: trái = trạng thái, phải = ghost → secondary → secondary → MỘT primary -->
          <Style x:Key="T3.FooterBar" TargetType="Border">
            <Setter Property="Height"      Value="{StaticResource T3.H.Footer}"/>
            <Setter Property="Background"  Value="{StaticResource T3.SurfaceSunken}"/>
            <Setter Property="BorderBrush" Value="{StaticResource T3.Border}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="16,0"/>
          </Style>

          <Style x:Key="T3.TitleBar" TargetType="Border">
            <Setter Property="Height"      Value="{StaticResource T3.H.TitleBar}"/>
            <Setter Property="Background"  Value="{StaticResource T3.SurfaceSunken}"/>
            <Setter Property="BorderBrush" Value="{StaticResource T3.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="16,0,8,0"/>
          </Style>

          <Style x:Key="T3.Panel" TargetType="Border">
            <Setter Property="Background"  Value="{StaticResource T3.Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource T3.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource T3.R.Control}"/>
            <Setter Property="Padding" Value="{StaticResource T3.Pad.Panel}"/>
          </Style>


          <!-- ══════════════════ 14 · CHROME CỬA SỔ & WIZARD ══════════════════
               Thêm 2026-08-28 khi migrate BatchOut. Trước đó Design System không có
               từ vựng cho sidebar rail, tab ẩn của wizard, và 3 nút chrome cửa sổ —
               mỗi tool phải tự định nghĩa, đúng thứ hệ thống này sinh ra để chống.

               Bo góc: các component dưới đây mang giá trị riêng (rail tile 13, pill 18)
               vì hình dạng của chúng đòi hỏi thế. Ngoại lệ sống BÊN TRONG component;
               file tool vẫn chỉ được dùng 0/2/4/8. ══════════════════ -->

          <Style x:Key="T3.WinCtrl" TargetType="Button">
              <Setter Property="Width"           Value="40"/>
              <Setter Property="Height"          Value="32"/>
              <Setter Property="Background"      Value="Transparent"/>
              <Setter Property="Foreground" Value="{StaticResource T3.Ink}"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Cursor"          Value="Hand"/>
              <Setter Property="Template">
                  <Setter.Value>
                      <ControlTemplate TargetType="Button">
                          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                      </ControlTemplate>
                  </Setter.Value>
              </Setter>
              <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="{StaticResource T3.Canvas}"/>
                  </Trigger>
              </Style.Triggers>
          </Style>

          <Style x:Key="T3.WinClose" TargetType="Button" BasedOn="{StaticResource T3.WinCtrl}">
              <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="{StaticResource T3.Danger.Text}"/>
                      <Setter Property="Foreground" Value="{StaticResource T3.Surface}"/>
                  </Trigger>
              </Style.Triggers>
          </Style>

          <Style x:Key="T3.TabItem.Hidden" TargetType="TabItem">
              <Setter Property="Visibility" Value="Collapsed"/>
          </Style>

          <Style x:Key="T3.Rail.Tile" TargetType="ToggleButton">
              <Setter Property="Background"      Value="Transparent"/>
              <Setter Property="Foreground" Value="{StaticResource T3.TextMuted}"/>
              <Setter Property="Width"           Value="42"/>
              <Setter Property="Height"          Value="42"/>
              <Setter Property="Cursor"          Value="Hand"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="HorizontalAlignment" Value="Center"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="Template">
                  <Setter.Value>
                      <ControlTemplate TargetType="ToggleButton">
                          <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="13">
                              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <ControlTemplate.Triggers>
                              <Trigger Property="IsChecked" Value="True">
                                  <Setter TargetName="border" Property="Background" Value="{StaticResource T3.Ink}"/>
                                  <Setter Property="Foreground" Value="{StaticResource T3.Surface}"/>
                              </Trigger>
                              <MultiTrigger>
                                  <MultiTrigger.Conditions>
                                      <Condition Property="IsChecked" Value="False"/>
                                      <Condition Property="IsMouseOver" Value="True"/>
                                  </MultiTrigger.Conditions>
                                  <Setter TargetName="border" Property="Background" Value="{StaticResource T3.Border}"/>
                                  <Setter Property="Foreground" Value="{StaticResource T3.Ink}"/>
                              </MultiTrigger>
                              <MultiTrigger>
                                  <MultiTrigger.Conditions>
                                      <Condition Property="IsChecked" Value="True"/>
                                      <Condition Property="IsMouseOver" Value="True"/>
                                  </MultiTrigger.Conditions>
                                  <Setter TargetName="border" Property="Background" Value="{StaticResource T3.Text}"/>
                              </MultiTrigger>
                          </ControlTemplate.Triggers>
                      </ControlTemplate>
                  </Setter.Value>
              </Setter>
          </Style>

          <Style x:Key="T3.ComboBox.Toggle" TargetType="ToggleButton">
              <Setter Property="Background" Value="{StaticResource T3.Surface}"/>
              <Setter Property="Foreground" Value="{StaticResource T3.Ink}"/>
              <Setter Property="BorderBrush" Value="{StaticResource T3.Border}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="Padding" Value="8,0,8,0"/>
              <Setter Property="FontSize" Value="13"/>
              <Setter Property="FontFamily" Value="Hanken Grotesk"/>
              <Setter Property="Height" Value="32"/>
              <Setter Property="VerticalContentAlignment" Value="Center"/>
              <Setter Property="Template">
                  <Setter.Value>
                      <ControlTemplate TargetType="ToggleButton">
                          <Border x:Name="border"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="8">
                              <Grid>
                                  <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*"/>
                                      <ColumnDefinition Width="28"/>
                                  </Grid.ColumnDefinitions>
                                  <ContentPresenter Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    IsHitTestVisible="False"/>
                                  <Path Grid.Column="1"
                                        Data="M6 9 L12 15 L18 9"
                                        Stroke="{StaticResource T3.TextMuted}"
                                        StrokeThickness="1.5"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round"
                                        StrokeLineJoin="Round"
                                        Width="10" Height="10"
                                        Stretch="Uniform"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"/>
                              </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="true">
                                  <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource T3.Ink}"/>
                              </Trigger>
                              <Trigger Property="IsChecked" Value="true">
                                  <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource T3.Ink}"/>
                              </Trigger>
                          </ControlTemplate.Triggers>
                      </ControlTemplate>
                  </Setter.Value>
              </Setter>
          </Style>

          <Style TargetType="{x:Type Thumb}" x:Key="T3.ScrollBar.Thumb">
              <Setter Property="OverridesDefaultStyle" Value="true"/>
              <Setter Property="IsTabStop" Value="false"/>
              <Setter Property="Template">
                  <Setter.Value>
                      <ControlTemplate TargetType="{x:Type Thumb}">
                          <Border x:Name="thumbBorder" Background="{StaticResource T3.BorderStrong}" CornerRadius="2" Margin="0"/>
                          <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="true">
                                  <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource T3.TextMuted}"/>
                              </Trigger>
                              <Trigger Property="IsDragging" Value="true">
                                  <Setter TargetName="thumbBorder" Property="Background" Value="{StaticResource T3.Ink}"/>
                              </Trigger>
                          </ControlTemplate.Triggers>
                      </ControlTemplate>
                  </Setter.Value>
              </Setter>
          </Style>

          <!-- Rail tile 42×42 — ô logo/biểu tượng ở sidebar rail. Bo góc 13 là giá trị
               riêng của component này; file tool KHÔNG bao giờ tự viết 13. -->
          <Style x:Key="T3.Rail.Logo" TargetType="Border">
            <Setter Property="Width"  Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background"   Value="{StaticResource T3.Ink}"/>
          </Style>

          <!-- Pill 36px — dải trạng thái/đếm nằm ngang. Bo góc 18 = nửa chiều cao. -->
          <Style x:Key="T3.Pill" TargetType="Border">
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background"  Value="{StaticResource T3.SurfaceSunken}"/>
            <Setter Property="BorderBrush" Value="{StaticResource T3.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
          </Style>

          <!-- ══════════════════ 15 · DATA-DENSE UI ══════════════════
               Thêm 2026-08-28 từ 5 mock chuẩn (P1–P5). Trước đó mỗi tool tự dựng chip
               filter, search box, header list, log có severity, dải tally… bằng tay —
               đúng thứ Design System sinh ra để chống. ══════════════════ -->

          <!-- Chip filter: RadioButton cùng GroupName. Chip đang chọn = nền Ink, chữ trắng. -->
          <Style x:Key="T3.Chip" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Caption}"/>
            <Setter Property="Foreground" Value="{StaticResource T3.TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                  <Border x:Name="bd" Background="Transparent"
                          BorderBrush="Transparent" BorderThickness="1"
                          CornerRadius="{StaticResource T3.R.Control}" Padding="10,4">
                    <ContentPresenter VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="{StaticResource T3.SurfaceSunken}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="{StaticResource T3.Ink}"/>
                      <Setter Property="Foreground" Value="{StaticResource T3.Surface}"/>
                      <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <!-- Search box: kính lúp + placeholder lấy từ Tag. Không cần converter. -->
          <Style x:Key="T3.Search" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Body}"/>
            <Setter Property="Foreground" Value="{StaticResource T3.Text}"/>
            <Setter Property="Height"     Value="{StaticResource T3.H.Control}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                  <Border x:Name="bd" Background="{StaticResource T3.Surface}"
                          BorderBrush="{StaticResource T3.BorderStrong}" BorderThickness="1"
                          CornerRadius="{StaticResource T3.R.Control}" Padding="8,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                 FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Foreground="{StaticResource T3.TextDisabled}"/>
                      <Grid Grid.Column="1">
                        <TextBlock x:Name="ph" Text="{TemplateBinding Tag}"
                                   Foreground="{StaticResource T3.TextDisabled}"
                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                      </Grid>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="Text" Value="">
                      <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                      <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource T3.Ink}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <!-- Header của list tự dựng (không phải DataGrid). Nhãn dùng T3.ListHeader.Label. -->
          <Style x:Key="T3.ListHeader" TargetType="Border">
            <Setter Property="Background"  Value="{StaticResource T3.SurfaceSunken}"/>
            <Setter Property="BorderBrush" Value="{StaticResource T3.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height"  Value="{StaticResource T3.H.Row}"/>
            <Setter Property="Padding" Value="16,0"/>
          </Style>

          <Style x:Key="T3.ListHeader.Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Label}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource T3.TextDisabled}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
          </Style>

          <!-- Meter: thanh tỉ lệ TĨNH (pass rate, coverage). KHÁC ProgressBar — không cam,
               vì không có gì đang chạy. -->
          <Style x:Key="T3.Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background"  Value="{StaticResource T3.Border}"/>
            <Setter Property="Foreground"  Value="{StaticResource T3.Ink}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                  <Border Background="{TemplateBinding Background}"
                          CornerRadius="{StaticResource T3.R.Pill}" ClipToBounds="True">
                    <Grid>
                      <Rectangle x:Name="PART_Track"/>
                      <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                 Fill="{TemplateBinding Foreground}"/>
                    </Grid>
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>

          <!-- Ô "không có giá trị": — none — / n/a. Mờ, KHÔNG để trống. -->
          <Style x:Key="T3.Cell.Muted" TargetType="TextBlock" BasedOn="{StaticResource T3.Cell.Mono}">
            <Setter Property="Foreground" Value="{StaticResource T3.TextDisabled}"/>
          </Style>

          <!-- Icon của callout: Segoe MDL2, canh đỉnh dòng chữ đầu. -->
          <Style x:Key="T3.Callout.Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Caption}"/>
            <Setter Property="Margin"     Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
          </Style>

          <!-- Chấm trạng thái 6px. Fill đặt tại chỗ dùng: Success/Warning/Danger/Progress. -->
          <Style x:Key="T3.Dot" TargetType="Ellipse">
            <Setter Property="Width"  Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
          </Style>

          <!-- Dòng log: timestamp mờ + chữ theo severity. Màu KHÔNG BAO GIỜ đứng một mình —
               dòng luôn chứa chữ ok / skipped / failed. -->
          <Style x:Key="T3.Log.Time" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font.Mono}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Mono}"/>
            <Setter Property="Foreground" Value="{StaticResource T3.TextDisabled}"/>
            <Setter Property="Margin"     Value="0,0,12,0"/>
          </Style>

          <Style x:Key="T3.Log.Ok" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font.Mono}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Mono}"/>
            <Setter Property="Foreground" Value="{StaticResource T3.Success.Text}"/>
          </Style>

          <Style x:Key="T3.Log.Skipped" TargetType="TextBlock" BasedOn="{StaticResource T3.Log.Ok}">
            <Setter Property="Foreground" Value="{StaticResource T3.Warning.Text}"/>
          </Style>

          <Style x:Key="T3.Log.Failed" TargetType="TextBlock" BasedOn="{StaticResource T3.Log.Ok}">
            <Setter Property="Foreground" Value="{StaticResource T3.Danger.Text}"/>
          </Style>

          <Style x:Key="T3.Log.Plain" TargetType="TextBlock" BasedOn="{StaticResource T3.Log.Ok}">
            <Setter Property="Foreground" Value="{StaticResource T3.Text}"/>
          </Style>

          <!-- Dải tally dưới log: chấm + "176 ok". -->
          <Style x:Key="T3.Tally" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource T3.Font}"/>
            <Setter Property="FontSize"   Value="{StaticResource T3.Size.Caption}"/>
            <Setter Property="Foreground" Value="{StaticResource T3.TextSecondary}"/>
            <Setter Property="Margin"     Value="0,0,16,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
          </Style>
        <!-- ═══ HẾT T3 STYLES ═══ -->
        

        <!-- TERTIARY BUTTON - soft gray background, dark text -->

        <!-- Sleek Modern ComboBox -->


        <!-- Premium Toggle Switch Style (CheckBox) -->

        <!-- Sleek Modern Slider -->

        <!-- Sleek Modern Input Field -->


        <!-- Premium Modern GroupBox Card -->

        <!-- Top Navigation Tab Style -->

        <!-- PRIMARY BUTTON - solid deep slate, white text -->

        <!-- SECONDARY BUTTON - white background, border and text slate -->

        <!-- GHOST BUTTON -->

        <!-- SUCCESS BUTTON -->

        <!-- DANGER BUTTON -->

        <!-- ACCENT BUTTON -->

        <!-- Sidebar Icon Button Style -->

        <!-- WINDOW CONTROL BUTTON -->

        <!-- CLOSE BUTTON -->

        <!-- Premium CheckBox Style -->


        <!-- Premium RadioButton Style -->


        <!-- Custom Scrollbar Styling -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource T3.ScrollBar.Thumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="true"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="false"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="4"/>
                    <Setter Property="Height" Value="Auto"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- SIDEBAR TOGGLE BUTTON (for icon-only sidebar filter/nav) -->
        <!-- Sleek Modern ComboBox Small -->


        <!-- Sleek Modern ComboBox Small ToggleButton -->

        <!-- Sleek Modern Input Field Small -->


        <!-- Flat ProgressBar Style (Lumina Standard) -->


        <!-- Queue Item ProgressBar Style with complete trigger -->

        <!-- Tab Pill RadioButton Style -->






        </ResourceDictionary>
    </Window.Resources>

    <!-- ═══ Outer Border: CornerRadius + ClipToBounds (Lumina standard) ═══ -->
    <Border BorderBrush="{StaticResource T3.BorderStrong}" BorderThickness="1.5" CornerRadius="8" ClipToBounds="True" Background="{StaticResource T3.Canvas}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="66"/>    <!-- Col 0: Left Sidebar Rail -->
                <ColumnDefinition Width="*"/>     <!-- Col 1: Main content area -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>      <!-- Row 0: Title bar -->
                <RowDefinition Height="*"/>       <!-- Row 1: Content Area -->
                <RowDefinition Height="Auto"/>    <!-- Row 2: Footer / Action bar -->
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- COL 0: LEFT SIDEBAR ICON RAIL (all rows)                    -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0" Grid.RowSpan="3"
                    Background="{StaticResource T3.SurfaceSunken}" BorderBrush="{StaticResource T3.Border}" BorderThickness="0,0,1,0">
                <Grid Margin="0,16,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Logo -->
                        <RowDefinition Height="Auto"/> <!-- Tab Selection -->
                        <RowDefinition Height="Auto"/> <!-- Tab Format -->
                        <RowDefinition Height="Auto"/> <!-- Tab Queue -->
                        <RowDefinition Height="*"/>    <!-- Spacer -->
                    </Grid.RowDefinitions>

                    <!-- Logo: BatchOut Sheets Export logo -->
                    <Border Grid.Row="0" Style="{StaticResource T3.Rail.Logo}"
                            Background="White" BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path Data="M4 4 h16 v14 h-16 z M4 9 h16 M10 9 v10"
                              Stroke="{StaticResource T3.Ink}" StrokeThickness="1.6" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Tab: Selection — stacked sheets/layers -->
                    <ToggleButton x:Name="nav_toggle_selection" Grid.Row="1"
                                  Style="{StaticResource T3.Rail.Tile}"
                                  Margin="0,0,0,8" IsChecked="True"
                                  ToolTip="Selection" Click="nav_toggle_clicked">
                        <Path Data="M12 4 L20 8 L12 12 L4 8 Z M4 12 L12 16 L20 12 M4 16 L12 20 L20 16"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="19" Height="19" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>

                    <!-- Tab: Format — document/file format -->
                    <ToggleButton x:Name="nav_toggle_format" Grid.Row="2"
                                  Style="{StaticResource T3.Rail.Tile}"
                                  Margin="0,0,0,8"
                                  ToolTip="Format" Click="nav_toggle_clicked">
                        <Path Data="M4 2 h10 l5 5 v14 H4 z M14 2 v5 h5 M7 12 h8 M7 16 h5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="19" Height="19" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>

                    <!-- Tab: Queue — list with send arrow -->
                    <ToggleButton x:Name="nav_toggle_queue" Grid.Row="3"
                                  Style="{StaticResource T3.Rail.Tile}"
                                  Margin="0,0,0,8"
                                  ToolTip="Queue &amp; Export" Click="nav_toggle_clicked">
                        <Path Data="M2 4 h10 M2 9 h10 M2 14 h7 M15 9 h6 M18 6 l3 3 l-3 3"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="19" Height="19" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>
                </Grid>
            </Border>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- ROW 0 / COL 1: TITLE BAR (64px, #F4F4F6)                   -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="1" Grid.Row="0" Background="{StaticResource T3.SurfaceSunken}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title & Subtitle -->
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="24,0,0,0" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="BatchOut" FontSize="15" FontWeight="Bold" Foreground="{StaticResource T3.Ink}"/>
                    <TextBlock Text="Batch export sheets &amp; views to multiple formats" FontSize="12.5" Foreground="{StaticResource T3.TextMuted}" Margin="0,0,0,0"/>
                </StackPanel>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="btn_minimize" Style="{StaticResource T3.WinCtrl}"
                            Click="minimize_button_clicked" ToolTip="Minimize">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button x:Name="btn_maximize" Style="{StaticResource T3.WinCtrl}"
                            Click="maximize_button_clicked" ToolTip="Maximize">
                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                    <Button x:Name="btn_close" Style="{StaticResource T3.WinClose}" IsCancel="True"
                            Click="close_button_clicked" ToolTip="Close">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                </StackPanel>
                
                <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource T3.Border}" Grid.ColumnSpan="3"/>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- ROW 1 / COL 1: CONTENT AREA (TabControl in white card)      -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="1" Grid.Row="1"
                    Background="White"
                    CornerRadius="0" BorderBrush="{StaticResource T3.Border}" BorderThickness="0"
                    ClipToBounds="True">
                <TabControl Margin="0" x:Name="main_tabs" BorderThickness="0" Background="Transparent">

            <!-- Selection Tab -->
            <TabItem Header="Selection" Style="{StaticResource T3.TabItem.Hidden}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Select Sheets or Views to Export" Style="{StaticResource T3.Label}"/>


                    <!-- Selection Controls -->
                    <Grid Grid.Row="1" Margin="0,4">
                        <!-- Single Row with Sheets/Views Radio Buttons, View/Sheet Set, Save V/S Set, and Search -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <!-- Radio Buttons for Sheets/Views -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="sheets_radio" Content="Sheets" GroupName="selectionMode"
                                             IsChecked="True" Margin="0,0,16,0"
                                             Checked="selection_mode_changed" FontWeight="Medium"/>
                                <RadioButton x:Name="views_radio" Content="Views" GroupName="selectionMode"
                                             Checked="selection_mode_changed" FontWeight="Medium"/>
                            </StackPanel>

                            <!-- View Type Filter (for Views) - Hidden by default -->
                            <ComboBox Grid.Column="1" x:Name="view_type_filter" Height="32"
                                      SelectionChanged="filter_by_size" Visibility="Collapsed"
                                      VerticalAlignment="Center" Width="150" Margin="16,0,0,0"
                                      Style="{StaticResource T3.ComboBox}">
                                <ComboBoxItem Content="All Views" IsSelected="True"/>
                                <ComboBoxItem Content="Floor Plan"/>
                                <ComboBoxItem Content="Ceiling Plan"/>
                                <ComboBoxItem Content="Elevation"/>
                                <ComboBoxItem Content="Section"/>
                                <ComboBoxItem Content="3D View"/>
                                <ComboBoxItem Content="Schedule"/>
                                <ComboBoxItem Content="Drafting"/>
                                <ComboBoxItem Content="Legend"/>
                                <ComboBoxItem Content="Engineering"/>
                                <ComboBoxItem Content="Area Plan"/>
                            </ComboBox>

                            <!-- View/Sheet Set - multi-select dropdown -->
                            <TextBlock Grid.Column="3" Text="View/Sheet Set:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Grid Grid.Column="4">
                                <ToggleButton x:Name="sheet_set_toggle"
                                              Height="32"
                                              HorizontalContentAlignment="Left"
                                              Padding="8,0,24,0"
                                              Style="{StaticResource T3.ComboBox.Toggle}"
                                              Click="sheet_set_toggle_clicked"
                                              ToolTip="Click to select one or more View/Sheet Sets">
                                    <TextBlock x:Name="sheet_set_label" Text="All Sheets/Views"
                                               VerticalAlignment="Center" Foreground="{StaticResource T3.Ink}" FontSize="13"/>
                                </ToggleButton>
                                <Popup x:Name="sheet_set_popup"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade"
                                       PlacementTarget="{Binding ElementName=sheet_set_toggle}"
                                       Placement="Bottom">
                                    <Border BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                                            Background="White" MinWidth="240" MaxHeight="220"
                                            CornerRadius="8">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="sheet_set_checklist" Margin="8,8,8,8"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- Refresh + Save V/S Set Buttons -->
                            <StackPanel Grid.Column="6" Orientation="Horizontal">
                                <Button x:Name="refresh_button"
                                        Content="Refresh"
                                        Height="28"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource T3.Button.Secondary}"
                                        Click="refresh_clicked"
                                        ToolTip="Reload sheets/views from the model — picks up changes made while this window is open"/>
                                <Button x:Name="save_vs_set_button"
                                        Content="Save V/S Set"
                                        Height="28"
                                        Style="{StaticResource T3.Button.Secondary}"
                                        Click="save_vs_set_clicked"
                                        ToolTip="Save current selection as View/Sheet Set"/>
                            </StackPanel>

                            <!-- Search Box (showcase pill style) -->
                            <Border Grid.Column="8" Grid.ColumnSpan="2" Style="{StaticResource T3.Pill}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Data="M11 4 A7 7 0 1 0 11 18 A7 7 0 1 0 11 4 M21 21 L16.7 16.7"
                                          Stroke="{StaticResource T3.TextMuted}" StrokeThickness="1.9"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="14" Height="14" Stretch="Uniform"
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Grid Grid.Column="1">
                                        <TextBox x:Name="search_textbox"
                                                 Background="Transparent" BorderThickness="0" Padding="0"
                                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                 Height="24" FontSize="13" FontFamily="Segoe UI" Foreground="{StaticResource T3.Ink}"
                                                 TextChanged="search_sheets"/>
                                        <TextBlock Text="Search sheets or views…"
                                                   Foreground="{StaticResource T3.TextMuted}" FontSize="13" FontFamily="Segoe UI"
                                                   VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=search_textbox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Sheets List with Selection Status -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="{StaticResource T3.BorderStrong}" BorderThickness="1" Margin="0,4" CornerRadius="8" Background="{StaticResource T3.SurfaceSunken}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="1" x:Name="sheets_empty_state"
                                           Style="{StaticResource T3.Empty}"
                                           Visibility="Collapsed"
                                           Text="No sheets match the current filter.&#x0a;Clear the search box, or pick a different Sheet Set above."/>

                                <ListView VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="1" x:Name="sheets_listview"
                                          SelectionMode="Extended"
                                          BorderThickness="0"
                                          MouseDoubleClick="listview_item_double_clicked"
                                          SizeChanged="on_listview_size_changed">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.View>
                                        <GridView x:Name="items_gridview">
                                            <GridViewColumn Width="40">
                                                <GridViewColumn.Header>
                                                    <CheckBox x:Name="header_checkbox"
                                                              HorizontalAlignment="Center"
                                                              ToolTip="Select All / Deselect All"
                                                              Click="header_checkbox_clicked"/>
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn x:Name="col_number" Header="Sheet Number" Width="150"
                                                            DisplayMemberBinding="{Binding SheetNumber}"/>
                                            <GridViewColumn x:Name="col_name" Header="Sheet Name" Width="250"
                                                            DisplayMemberBinding="{Binding SheetName}"/>
                                            <GridViewColumn x:Name="col_revision" Header="Revision" Width="80"
                                                            DisplayMemberBinding="{Binding Revision}"/>
                                            <GridViewColumn x:Name="col_size" Header="Size" Width="80"
                                                            DisplayMemberBinding="{Binding Size}"/>
                                            <GridViewColumn x:Name="col_orientation" Header="Orientation" Width="90"
                                                            DisplayMemberBinding="{Binding Orientation}"/>
                                            <GridViewColumn x:Name="col_custom_filename" Width="280">
                                                <GridViewColumn.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Custom Filename" VerticalAlignment="Center"/>
                                                        <Button x:Name="btn_edit_filename"
                                                                Content="Edit"
                                                                Height="28"
                                                                Padding="8,0"
                                                                FontSize="11"
                                                                Style="{StaticResource T3.Button.Secondary}"
                                                                Click="edit_filename_clicked"
                                                                ToolTip="Edit filename pattern for all items"
                                                                Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </GridViewColumn.Header>
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding CustomFilename, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource T3.TextBox}"
                                                                 ToolTip="Custom filename (leave empty to use pattern)"
                                                                 PreviewMouseLeftButtonDown="textbox_prevent_toggle"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- Selection Count Status Bar -->
                        <Border Grid.Row="1" Background="{StaticResource T3.SurfaceSunken}" BorderBrush="{StaticResource T3.Border}" BorderThickness="0,1,0,0"
                                Padding="12,8" Margin="0,4,0,0" CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="selection_count_text"
                                           Grid.Column="0"
                                           Text="0 sheets and 0 views selected. Total: 0"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource T3.Ink}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Format Tab -->
            <TabItem Header="Format" Style="{StaticResource T3.TabItem.Hidden}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" x:Name="format_panels_container">

                        <TextBlock Text="Select Formats &amp; Configure Settings" Style="{StaticResource T3.Label}"/>
                        <TextBlock Text="Check a format to enable it. Click the header bar to expand/collapse its settings."
                                   FontSize="11" Foreground="{StaticResource T3.TextSecondary}" Margin="0,0,0,8"/>

                        <!-- ═══ PDF ═══ -->
                        <Border x:Name="pdf_panel_border" BorderBrush="{StaticResource T3.Ink}" BorderThickness="1"
                                CornerRadius="4" Margin="0,0,0,4">
                            <!-- Header row -->
                            <StackPanel>
                                <Border Background="{StaticResource T3.SurfaceSunken}" CornerRadius="4,4,0,0" Cursor="Hand"
                                        MouseLeftButtonUp="pdf_header_clicked">
                                    <Grid Margin="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="export_pdf" Grid.Column="0"
                                                  Content="PDF" IsChecked="True"
                                                  FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource T3.Ink}"
                                                  Checked="format_changed" Unchecked="format_changed"/>
                                        <TextBlock Grid.Column="1" Text="Portable Document Format"
                                                   FontSize="11" Foreground="{StaticResource T3.TextSecondary}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock x:Name="pdf_expand_arrow" Grid.Column="2"
                                                   Text="▾" FontSize="13" Foreground="{StaticResource T3.Ink}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
