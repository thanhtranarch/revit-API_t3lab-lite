                                            <ColumnDefinition Width="30"/> <!-- Spacer -->
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Column: Page Setup & Zoom -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Page Setup" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                            
                                            <CheckBox x:Name="pdf_auto_detect_size" Content="Auto-detect from Title Block"
                                                      Margin="0,0,0,8" IsChecked="True"
                                                      Checked="pdf_auto_detect_changed" Unchecked="pdf_auto_detect_changed"/>
                                            
                                            <TextBlock Text="Manual Paper Size" FontSize="11" Foreground="{StaticResource T3.TextSecondary}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="pdf_paper_size" Height="32" SelectedIndex="0" IsEnabled="False" 
                                                      Style="{StaticResource T3.ComboBox}" Margin="0,0,0,16" HorizontalAlignment="Stretch">
