                                                <ComboBoxItem Content="A0"/><ComboBoxItem Content="A1"/>
                                                <ComboBoxItem Content="A2"/><ComboBoxItem Content="A3"/>
                                                <ComboBoxItem Content="A4"/>
                                            </ComboBox>
                                            
                                            <TextBlock Text="Orientation" FontSize="11" Foreground="{StaticResource T3.TextSecondary}" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                                <RadioButton x:Name="pdf_landscape" Content="Landscape" GroupName="orientation"
                                                             IsChecked="True" Margin="0,0,16,0" IsEnabled="False"/>
                                                <RadioButton x:Name="pdf_portrait" Content="Portrait" GroupName="orientation" IsEnabled="False"/>
                                            </StackPanel>

                                            <TextBlock Text="Scaling" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <RadioButton x:Name="pdf_fit_to_page" Content="Fit to Page" GroupName="zoom"
                                                             IsChecked="True" Margin="0,0,16,0"/>
                                                <RadioButton x:Name="pdf_zoom_custom" Content="Custom Zoom (100%)" GroupName="zoom"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Vertical Separator -->
                                        <Border Grid.Column="1" Width="1" Background="{StaticResource T3.Border}" HorizontalAlignment="Center" Margin="4,0"/>

                                        <!-- Right Column: Visibility & Output Options -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Visibility Settings" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                            <CheckBox x:Name="pdf_hide_ref_planes" Content="Hide reference/work planes" Margin="0,4"/>
                                            <CheckBox x:Name="pdf_hide_scope_boxes" Content="Hide scope boxes" Margin="0,4"/>
                                            <CheckBox x:Name="pdf_hide_crop_boundaries" Content="Hide crop boundaries" Margin="0,4"/>
                                            <CheckBox x:Name="pdf_hide_unreferenced_tags" Content="Hide unreferenced view tags" Margin="0,4,0,16"/>

                                            <TextBlock Text="Output Settings" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource T3.Ink}" Margin="0,0,0,12"/>
                                            <CheckBox x:Name="pdf_view_links_blue" Content="View links in blue" Margin="0,4"/>
                                            <CheckBox x:Name="combine_pdf" Content="Combine all sheets into single PDF"
                                                      FontWeight="SemiBold" Margin="0,4"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ═══ DWG ═══ -->
                        <Border x:Name="dwg_panel_border" BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
