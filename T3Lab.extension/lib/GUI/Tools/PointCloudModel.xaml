<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="T3Lab - Point Cloud to Model"
        Width="900" Height="740"
        MinWidth="820" MinHeight="620"
        Background="White"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        FontFamily="Inter">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ═══ T3LAB SHARED STYLES v2 — AUTO-SYNCED, DO NOT EDIT (edit lib/GUI/Resources/WPF_styles.xaml, then run dev/sync_wpf_styles.py) ═══ -->
        <!-- PRIMARY BUTTON - teal, white text -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#0F766E"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#115E59"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0B4F4A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AEBFBC"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SECONDARY BUTTON - surface, ink text -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#F6F8F8"/>
            <Setter Property="Foreground"      Value="#1C2B33"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#C7D2D4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6EDEC"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#DDE5E7"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SUCCESS BUTTON - green -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#15803D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#166534"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#14532D"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AEBFBC"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DANGER BUTTON - red -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#991B1B"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AEBFBC"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ACCENT BUTTON - amber highlight -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F59E0B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D97706"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B45309"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AEBFBC"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- WINDOW CONTROL BUTTON -->
        <Style x:Key="WinCtrlButton" TargetType="Button">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#1C2B33"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6EDEC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CLOSE BUTTON - red on hover, glyph flips to white -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WinCtrlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ═══ END T3LAB SHARED STYLES ═══ -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>    <!-- Row 0: Title bar -->
            <RowDefinition Height="52"/>    <!-- Row 1: Step progress bar -->
            <RowDefinition Height="*"/>     <!-- Row 2: Content / TabControl -->
            <RowDefinition Height="Auto"/>  <!-- Row 3: Action bar -->
            <RowDefinition Height="Auto"/>  <!-- Row 4: Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0 — TITLE BAR ═══ -->
        <Grid Grid.Row="0" Height="64" Background="White">
            <StackPanel Orientation="Vertical" Margin="16,0,0,0" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="T3Lab" FontSize="11" FontWeight="Bold" Foreground="#0F766E"
                               VerticalAlignment="Bottom" Margin="0,0,6,3"/>
                    <TextBlock Text="Point Cloud to Model" FontSize="18" FontWeight="Bold"
                               Foreground="#1C2B33"/>
                </StackPanel>
                <Separator Height="1" Background="#DDE5E7" Margin="0,2,0,2"/>
                <TextBlock Text="Detect and create building elements from point cloud data"
                           FontSize="10" Foreground="#64748B" FontStyle="Italic"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="btn_minimize" Style="{StaticResource WinCtrlButton}"
                        Click="minimize_button_clicked" ToolTip="Minimize">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Name="btn_maximize" Style="{StaticResource WinCtrlButton}"
                        Click="maximize_button_clicked" ToolTip="Maximize">
                    <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Name="btn_close" Style="{StaticResource CloseButton}"
                        Click="close_button_clicked" ToolTip="Close">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </StackPanel>

            <Border Height="1" VerticalAlignment="Bottom" Background="#DDE5E7"/>
        </Grid>

        <!-- ═══ ROW 1 — STEP PROGRESS BAR ═══ -->
        <Border Grid.Row="1" Background="#F6F8F8" BorderBrush="#DDE5E7" BorderThickness="0,0,0,1">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Step 1: Cloud Setup -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Width="90">
                        <Border x:Name="step_circle_1" Width="28" Height="28" CornerRadius="14"
                                Background="#0F766E" HorizontalAlignment="Center">
                            <TextBlock x:Name="step_num_1" Text="1" FontSize="12" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="step_label_1" Text="Cloud Setup" FontSize="11"
                                   FontWeight="SemiBold" Foreground="#115E59"
                                   HorizontalAlignment="Center" Margin="0,4,0,2"/>
                        <Border x:Name="step_underline_1" Height="2" Background="#F59E0B"
                                HorizontalAlignment="Center" Width="60" Visibility="Visible"/>
                    </StackPanel>

                    <!-- Connector line 1→2 -->
                    <Border Width="40" Height="2" Background="#DDE5E7" VerticalAlignment="Center"
                            Margin="0,0,0,16"/>

                    <!-- Step 2: Detection -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Width="90">
                        <Border x:Name="step_circle_2" Width="28" Height="28" CornerRadius="14"
                                Background="#E6EDEC" HorizontalAlignment="Center">
                            <TextBlock x:Name="step_num_2" Text="2" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#64748B" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="step_label_2" Text="Detection" FontSize="11"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Center" Margin="0,4,0,2"/>
                        <Border x:Name="step_underline_2" Height="2" Background="#F59E0B"
                                HorizontalAlignment="Center" Width="60" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Connector line 2→3 -->
                    <Border Width="40" Height="2" Background="#DDE5E7" VerticalAlignment="Center"
                            Margin="0,0,0,16"/>

                    <!-- Step 3: Results -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Width="90">
                        <Border x:Name="step_circle_3" Width="28" Height="28" CornerRadius="14"
                                Background="#E6EDEC" HorizontalAlignment="Center">
                            <TextBlock x:Name="step_num_3" Text="3" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#64748B" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="step_label_3" Text="Results" FontSize="11"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Center" Margin="0,4,0,2"/>
                        <Border x:Name="step_underline_3" Height="2" Background="#F59E0B"
                                HorizontalAlignment="Center" Width="60" Visibility="Collapsed"/>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ ROW 2 — CONTENT (TabControl) ═══ -->
        <TabControl x:Name="tab_main" Grid.Row="2" Background="Transparent"
                    BorderThickness="0" TabStripPlacement="Left">

            <!-- ─── TAB 1: Cloud Setup ─── -->
            <TabItem x:Name="tab_step1" Header="" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16,20,16">

                        <!-- Section 1: Point Cloud Instance -->
                        <TextBlock Text="Point Cloud Instance" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#64748B" Margin="0,0,0,6"/>
                        <Border Background="#F6F8F8" BorderBrush="#DDE5E7" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Vertical">
                                    <TextBlock Text="Selected Cloud:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock x:Name="lbl_cloud_name"
                                               Text="No cloud selected — press Select Cloud to continue"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#DC2626"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="btn_pick_cloud" Grid.Column="1"
                                        Content="Select Cloud"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Section 2: Scan Region -->
                        <TextBlock Text="Scan Region" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#64748B" Margin="0,0,0,6"/>
                        <StackPanel Margin="0,0,0,14">
                            <RadioButton x:Name="rb_full_extent" IsChecked="True"
                                         FontFamily="Inter" FontSize="12" Foreground="#1C2B33"
                                         Content="Full Cloud Extent — auto-detect bounding box (recommended)"
                                         Margin="0,0,0,8"/>
                            <RadioButton x:Name="rb_custom_region"
                                         FontFamily="Inter" FontSize="12" Foreground="#1C2B33"
                                         Content="Custom Region — pick 2 corner points"
                                         Margin="0,0,0,8"/>
                            <Button x:Name="btn_pick_region" Content="Pick Region Corners"
                                    Style="{StaticResource SecondaryButton}"
                                    IsEnabled="False" HorizontalAlignment="Left"
                                    Margin="20,4,0,0"/>
                        </StackPanel>

                        <!-- Section 3: Sampling Density -->
                        <TextBlock Text="Point Sampling Density" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#64748B" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cmb_density" FontFamily="Inter" FontSize="12"
                                  Padding="6,4" BorderBrush="#C7D2D4" SelectedIndex="1"
                                  Margin="0,0,0,14">
                            <ComboBoxItem Content="Low — 5,000 pts (quick, large buildings)"/>
                            <ComboBoxItem Content="Medium — 20,000 pts (balanced)"/>
                            <ComboBoxItem Content="High — 50,000 pts (detailed, small areas)"/>
                        </ComboBox>

                        <!-- Tip box -->
                        <Border BorderBrush="#BFDBD7" Background="#EFF6F5" CornerRadius="4"
                                Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Tip:" FontWeight="Bold" Foreground="#115E59"
                                           Margin="0,0,5,0"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#1C2B33"
                                           Text="Start with Full Extent + Medium density for a first pass. Switch to High for small rooms or detailed structural elements."/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─── TAB 2: Detection Settings ─── -->
            <TabItem x:Name="tab_step2" Header="" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16,20,16">

                        <TextBlock Text="Select element types to detect and configure tolerances:"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#64748B"
                                   Margin="0,0,0,10"/>

                        <UniformGrid Columns="2">

                            <!-- Card 1: Wall -->
                            <Border Margin="0,0,8,8" BorderBrush="#DDE5E7" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10" Background="White">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <CheckBox x:Name="chk_detect_wall" IsChecked="True"
                                                  Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Wall" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#1C2B33" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Margin="20,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Snap tolerance (°):"
                                                   FontSize="11" Foreground="#64748B"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt_snap_tol"
                                                 Text="1.0" FontFamily="Inter" FontSize="11"
                                                 Padding="4,3" BorderBrush="#C7D2D4"
                                                 MaxWidth="80" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Min length (mm):"
                                                   FontSize="11" Foreground="#64748B"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txt_wall_min_len"
                                                 Text="500" FontFamily="Inter" FontSize="11"
                                                 Padding="4,3" BorderBrush="#C7D2D4"
                                                 MaxWidth="80" HorizontalAlignment="Left"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Floor / Slab -->
                            <Border Margin="0,0,8,8" BorderBrush="#DDE5E7" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10" Background="White">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <CheckBox x:Name="chk_detect_floor" IsChecked="True"
                                                  Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Floor / Slab" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#1C2B33" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Margin="20,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Z bin size (mm):"
                                                   FontSize="11" Foreground="#64748B"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt_floor_zbin"
                                                 Text="50" FontFamily="Inter" FontSize="11"
                                                 Padding="4,3" BorderBrush="#C7D2D4"
                                                 MaxWidth="80" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Min area (m²):"
                                                   FontSize="11" Foreground="#64748B"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txt_floor_min_area"
                                                 Text="1" FontFamily="Inter" FontSize="11"
                                                 Padding="4,3" BorderBrush="#C7D2D4"
                                                 MaxWidth="80" HorizontalAlignment="Left"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Ceiling -->
                            <Border Margin="0,0,8,8" BorderBrush="#DDE5E7" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10" Background="White">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <CheckBox x:Name="chk_detect_ceiling" IsChecked="True"
                                                  Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Ceiling" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#1C2B33" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Margin="20,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Z bin size (mm):"
                                                   FontSize="11" Foreground="#64748B"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt_ceil_zbin"
                                                 Text="50" FontFamily="Inter" FontSize="11"
                                                 Padding="4,3" BorderBrush="#C7D2D4"
                                                 MaxWidth="80" HorizontalAlignment="Left"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Door -->
                            <Border Margin="0,0,8,8" BorderBrush="#DDE5E7" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10" Background="White">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <CheckBox x:Name="chk_detect_door" IsChecked="False"
                                                  Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Door" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#1C2B33" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Margin="20,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Min width (mm):"
                                                   FontSize="11" Foreground="#64748B"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt_door_min_w"
                                                 Text="600" FontFamily="Inter" FontSize="11"
                                                 Padding="4,3" BorderBrush="#C7D2D4"
                                                 MaxWidth="80" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Min height (mm):"
                                                   FontSize="11" Foreground="#64748B"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txt_door_min_h"
                                                 Text="1800" FontFamily="Inter" FontSize="11"
                                                 Padding="4,3" BorderBrush="#C7D2D4"
                                                 MaxWidth="80" HorizontalAlignment="Left"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 5: Window -->
                            <Border Margin="0,0,8,8" BorderBrush="#DDE5E7" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10" Background="White">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <CheckBox x:Name="chk_detect_window" IsChecked="False"
                                                  Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Window" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#1C2B33" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Margin="20,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Min width (mm):"
                                                   FontSize="11" Foreground="#64748B"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt_win_min_w"
                                                 Text="400" FontFamily="Inter" FontSize="11"
                                                 Padding="4,3" BorderBrush="#C7D2D4"
                                                 MaxWidth="80" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Min height (mm):"
                                                   FontSize="11" Foreground="#64748B"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txt_win_min_h"
                                                 Text="400" FontFamily="Inter" FontSize="11"
                                                 Padding="4,3" BorderBrush="#C7D2D4"
                                                 MaxWidth="80" HorizontalAlignment="Left"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 6: Column -->
                            <Border Margin="0,0,8,8" BorderBrush="#DDE5E7" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10" Background="White">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <CheckBox x:Name="chk_detect_column" IsChecked="False"
                                                  Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Column" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#1C2B33" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Margin="20,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Min size (mm):"
                                                   FontSize="11" Foreground="#64748B"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt_col_min"
                                                 Text="100" FontFamily="Inter" FontSize="11"
                                                 Padding="4,3" BorderBrush="#C7D2D4"
                                                 MaxWidth="80" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Max size (mm):"
                                                   FontSize="11" Foreground="#64748B"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txt_col_max"
                                                 Text="600" FontFamily="Inter" FontSize="11"
                                                 Padding="4,3" BorderBrush="#C7D2D4"
                                                 MaxWidth="80" HorizontalAlignment="Left"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 7: Stair -->
                            <Border Margin="0,0,8,8" BorderBrush="#DDE5E7" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10" Background="White">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <CheckBox x:Name="chk_detect_stair" IsChecked="False"
                                                  Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Stair" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#1C2B33" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Margin="20,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Riser height (mm):"
                                                   FontSize="11" Foreground="#64748B"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt_stair_riser"
                                                 Text="165" FontFamily="Inter" FontSize="11"
                                                 Padding="4,3" BorderBrush="#C7D2D4"
                                                 MaxWidth="80" HorizontalAlignment="Left"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 8: Roof -->
                            <Border Margin="0,0,8,8" BorderBrush="#DDE5E7" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10" Background="White">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <CheckBox x:Name="chk_detect_roof" IsChecked="False"
                                                  Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Roof" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#1C2B33" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Margin="20,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Min slope (°):"
                                                   FontSize="11" Foreground="#64748B"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txt_roof_slope"
                                                 Text="5" FontFamily="Inter" FontSize="11"
                                                 Padding="4,3" BorderBrush="#C7D2D4"
                                                 MaxWidth="80" HorizontalAlignment="Left"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ─── TAB 3: Results ─── -->
            <TabItem x:Name="tab_step3" Header="" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Row 0: summary badges -->
                        <RowDefinition Height="*"/>      <!-- Row 1: DataGrid -->
                        <RowDefinition Height="Auto"/>   <!-- Row 2: warning label -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Summary badges -->
                    <WrapPanel Grid.Row="0" Margin="16,10,16,6">
                        <Border Background="#EFF6F5" BorderBrush="#BFDBD7" BorderThickness="1"
                                CornerRadius="12" Padding="8,4" Margin="0,0,6,6">
                            <TextBlock x:Name="badge_wall" Text="0 Walls" FontSize="11"
                                       FontFamily="Inter" FontWeight="SemiBold" Foreground="#0F766E"/>
                        </Border>
                        <Border Background="#EFF6F5" BorderBrush="#BFDBD7" BorderThickness="1"
                                CornerRadius="12" Padding="8,4" Margin="0,0,6,6">
                            <TextBlock x:Name="badge_floor" Text="0 Floors" FontSize="11"
                                       FontFamily="Inter" FontWeight="SemiBold" Foreground="#0F766E"/>
                        </Border>
                        <Border Background="#EFF6F5" BorderBrush="#BFDBD7" BorderThickness="1"
                                CornerRadius="12" Padding="8,4" Margin="0,0,6,6">
                            <TextBlock x:Name="badge_ceiling" Text="0 Ceilings" FontSize="11"
                                       FontFamily="Inter" FontWeight="SemiBold" Foreground="#0F766E"/>
                        </Border>
                        <Border Background="#EFF6F5" BorderBrush="#BFDBD7" BorderThickness="1"
                                CornerRadius="12" Padding="8,4" Margin="0,0,6,6">
                            <TextBlock x:Name="badge_door" Text="0 Doors" FontSize="11"
                                       FontFamily="Inter" FontWeight="SemiBold" Foreground="#0F766E"/>
                        </Border>
                        <Border Background="#EFF6F5" BorderBrush="#BFDBD7" BorderThickness="1"
                                CornerRadius="12" Padding="8,4" Margin="0,0,6,6">
                            <TextBlock x:Name="badge_window" Text="0 Windows" FontSize="11"
                                       FontFamily="Inter" FontWeight="SemiBold" Foreground="#0F766E"/>
                        </Border>
                        <Border Background="#EFF6F5" BorderBrush="#BFDBD7" BorderThickness="1"
                                CornerRadius="12" Padding="8,4" Margin="0,0,6,6">
                            <TextBlock x:Name="badge_column" Text="0 Columns" FontSize="11"
                                       FontFamily="Inter" FontWeight="SemiBold" Foreground="#0F766E"/>
                        </Border>
                        <Border Background="#EFF6F5" BorderBrush="#BFDBD7" BorderThickness="1"
                                CornerRadius="12" Padding="8,4" Margin="0,0,6,6">
                            <TextBlock x:Name="badge_stair" Text="0 Stairs" FontSize="11"
                                       FontFamily="Inter" FontWeight="SemiBold" Foreground="#0F766E"/>
                        </Border>
                        <Border Background="#EFF6F5" BorderBrush="#BFDBD7" BorderThickness="1"
                                CornerRadius="12" Padding="8,4" Margin="0,0,6,6">
                            <TextBlock x:Name="badge_roof" Text="0 Roofs" FontSize="11"
                                       FontFamily="Inter" FontWeight="SemiBold" Foreground="#0F766E"/>
                        </Border>
                    </WrapPanel>

                    <!-- Row 1: DataGrid -->
                    <DataGrid x:Name="results_grid" Grid.Row="1" Margin="16,0,16,0"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="White" BorderBrush="#DDE5E7" BorderThickness="1"
                              AlternatingRowBackground="#F6F8F8" FontFamily="Inter" FontSize="12"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EFF2F2" SelectionMode="Single"
                              VerticalScrollBarVisibility="Auto">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"      Value="#F6F8F8"/>
                                <Setter Property="Foreground"      Value="#1C2B33"/>
                                <Setter Property="FontWeight"      Value="SemiBold"/>
                                <Setter Property="Padding"         Value="8,6"/>
                                <Setter Property="BorderBrush"     Value="#DDE5E7"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="Height"          Value="34"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EFF6F5"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#D9EBE8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <!-- Include checkbox -->
                            <DataGridTemplateColumn Header="&#x2713;" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Type"       Binding="{Binding Type}"       Width="80"  IsReadOnly="True"/>
                            <DataGridTextColumn Header="Level"      Binding="{Binding LevelName}"  Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Dimensions" Binding="{Binding Dimensions}" Width="*"   IsReadOnly="True"/>

                            <!-- Confidence column -->
                            <DataGridTemplateColumn Header="Confidence" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ConfidenceText}"
                                                   FontFamily="Inter" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Row 2: No-results warning -->
                    <Border Grid.Row="2" Margin="16,6,16,6" BorderBrush="#FCA5A5"
                            Background="#FEF2F2" CornerRadius="4" Padding="10,8"
                            x:Name="pnl_no_results" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x26A0;" Foreground="#DC2626"
                                       Margin="0,0,6,0" FontSize="13"/>
                            <TextBlock x:Name="lbl_no_results"
                                       Text="No elements detected. Try adjusting settings or increasing point density."
                                       Foreground="#DC2626" FontFamily="Inter" FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </TabItem>

        </TabControl>

        <!-- ═══ ROW 3 — ACTION BAR ═══ -->
        <Border Grid.Row="3" Background="White" BorderBrush="#DDE5E7"
                BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <!-- Left: Back button -->
                <Button x:Name="btn_back" Content="&#x2190; Back"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed"/>

                <!-- Right: action buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="btn_cancel" Content="Cancel"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"/>
                    <Button x:Name="btn_analyze" Content="&#x25B6;  Analyze"
                            Style="{StaticResource SuccessButton}"
                            Padding="20,8" FontSize="13"
                            Visibility="Collapsed" Margin="0,0,8,0"/>
                    <Button x:Name="btn_next" Content="Next  &#x2192;"
                            Style="{StaticResource PrimaryButton}"
                            Padding="20,8" FontSize="13"/>
                    <Button x:Name="btn_generate" Content="Generate Selected"
                            Style="{StaticResource SuccessButton}"
                            Padding="20,8" FontSize="13"
                            Visibility="Collapsed" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ ROW 4 — STATUS BAR ═══ -->
        <Border Grid.Row="4" Background="#F6F8F8" BorderBrush="#DDE5E7"
                BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="status_text" Grid.Column="0" FontSize="11"
                           Foreground="#64748B" Text="Ready"/>
                <TextBlock x:Name="status_count" Grid.Column="1" FontSize="11"
                           Foreground="#94A3B8" HorizontalAlignment="Right" Text="Revit"/>
            </Grid>
        </Border>

        <!-- Copyright added automatically -->
        <TextBlock Text="© Copyright by T3Lab" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,8" Foreground="#F59E0B" FontSize="11" IsHitTestVisible="False" Panel.ZIndex="999"/>
    </Grid>
</Window>
