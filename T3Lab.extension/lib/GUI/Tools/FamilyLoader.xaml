<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid.Resources>
        <!-- ═══ T3LAB SHARED STYLES v2 — AUTO-SYNCED, DO NOT EDIT (edit lib/GUI/Resources/WPF_styles.xaml, then run dev/sync_wpf_styles.py) ═══ -->
        <!-- Central Color Brushes (Lumina / T3Lab Terra v2 System) -->
        <SolidColorBrush x:Key="T3SlateBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="T3AccentBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="T3SuccessBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="T3DangerBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="T3WarningBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="T3TextDarkBrush" Color="#0F172A"/>
        <SolidColorBrush x:Key="T3TextMutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="T3BorderLightBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="T3BgLightBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="T3LightBlueHighlightBrush" Color="#EBF5FB"/>

        <!-- Sleek Modern Input Field -->
        <Style x:Key="T3InputField" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium Modern GroupBox Card -->
        <Style x:Key="T3PremiumCard" TargetType="GroupBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Card Header -->
                                <Border Grid.Row="0" 
                                        Background="White"
                                        Padding="16,12"
                                        BorderBrush="#F1F5F9"
                                        BorderThickness="0,0,0,1">
                                    <ContentPresenter ContentSource="Header"
                                                      TextBlock.FontSize="12"
                                                      TextBlock.FontWeight="Bold"
                                                      TextBlock.Foreground="#0F172A"/>
                                </Border>
                                <!-- Card Content -->
                                <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top Navigation Tab Style -->
        <Style x:Key="T3TopNavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="contentPresenter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PRIMARY BUTTON - solid deep slate, white text -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#0F172A"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SECONDARY BUTTON - ghost style, border and text deep slate -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#0F172A"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#0F172A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SUCCESS BUTTON - emerald green -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#10B981"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#047857"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DANGER BUTTON - rose red -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EF4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ACCENT BUTTON - refined blue -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- WINDOW CONTROL BUTTON -->
        <Style x:Key="WinCtrlButton" TargetType="Button">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CLOSE BUTTON - rose red on hover, glyph flips to white -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WinCtrlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ═══ END T3LAB SHARED STYLES ═══ -->


        <!-- Folder / small action button -->
        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary small button (Select None / grey) -->
        <Style x:Key="SmallBtnGrey" TargetType="Button" BasedOn="{StaticResource SmallBtn}">
            <Setter Property="Background" Value="#64748B"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Load button -->
        <Style x:Key="LoadBtn" TargetType="Button">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="3"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cancel button -->
        <Style x:Key="CancelBtn" TargetType="Button">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="3,2"/>
        </Style>

    </Grid.Resources>

    <!-- ════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>   <!-- 0 Title bar -->
            <RowDefinition Height="50"/>   <!-- 1 Search bar -->
            <RowDefinition Height="44"/>   <!-- 2 Folder / source bar -->
            <RowDefinition Height="*"/>    <!-- 3 Main content -->
            <RowDefinition Height="62"/>   <!-- 4 Footer -->
        </Grid.RowDefinitions>

        <!-- ══ ROW 0 — TITLE BAR ══════════════════════ -->
        <Border Grid.Row="0" x:Name="title_bar_grid"
                Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Vertical"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="T3Lab" FontSize="11" FontWeight="Bold"
                                   Foreground="#0F172A" VerticalAlignment="Bottom"
                                   Margin="0,0,6,3"/>
                        <TextBlock Text="Load Family" FontSize="18" FontWeight="Bold"
                                   Foreground="#0F172A"/>
                    </StackPanel>
                    <Separator Height="1" Background="#E2E8F0" Margin="0,2,0,2"/>
                    <TextBlock Text="Load Revit families from local folders or cloud"
                               FontSize="10" Foreground="#64748B" FontStyle="Italic"/>
                </StackPanel>

                <!-- Window control buttons
                     CaptionHeight=0 in Python means these are in normal client area
                     and receive mouse events without IsHitTestVisibleInChrome -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="btn_minimize_fl"
                            Style="{StaticResource WinCtrlButton}"
                            ToolTip="Minimize">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Margin="0,-1,0,0"/>
                    </Button>
                    <Button x:Name="btn_close_x_fl"
                            Style="{StaticResource CloseButton}"
                            ToolTip="Close">
                        <!-- X drawn as a Path so it scales cleanly -->
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ ROW 1 — SEARCH BAR ════════════════════ -->
        <Border Grid.Row="1" Background="White" Padding="14,7"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                    Background="White">
                <DockPanel>
                    <!-- magnifier icon (Unicode circle + line) -->
                    <TextBlock DockPanel.Dock="Left"
                               Text="&#9740;" FontSize="16" Foreground="#64748B"
                               VerticalAlignment="Center" Margin="10,0,2,0"/>
                    <TextBox x:Name="txt_search"
                             BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center"
                             FontSize="13" Foreground="#0F172A"
                             Padding="6,0,8,0" Height="34"/>
                </DockPanel>
            </Border>
        </Border>

        <!-- ══ ROW 2 — FOLDER / SOURCE BAR ══════════ -->
        <Border Grid.Row="2" Background="#F8FAFC" Padding="12,0"
                BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel VerticalAlignment="Center">
                <!-- Source radio buttons on the right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Source:" VerticalAlignment="Center"
                               Margin="0,0,8,0" FontSize="11.5" Foreground="#64748B"/>
                    <RadioButton x:Name="radio_local" Content="Local"
                                 GroupName="DataSource" IsChecked="True"
                                 VerticalAlignment="Center" Margin="0,0,12,0"
                                 FontSize="11.5"/>
                    <RadioButton x:Name="radio_cloud" Content="Cloud (Vercel)"
                                 GroupName="DataSource"
                                 IsEnabled="False"
                                 VerticalAlignment="Center" Margin="0,0,6,0"
                                 FontSize="11.5"
                                 ToolTip="Cloud feature is currently disabled"/>
                </StackPanel>
                <!-- Folder button + path on the left -->
                <Button x:Name="btn_select_folder"
                        Content="Update Folder"
                        Style="{StaticResource SmallBtn}"
                        DockPanel.Dock="Left"/>
                <TextBlock x:Name="txt_current_folder"
                           Text="No folder selected"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" FontSize="11.5"
                           Foreground="#64748B"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ══ ROW 3 — MAIN CONTENT ═════════════════ -->
        <DockPanel Grid.Row="3">

            <!-- Left: Category tree (slim) -->
            <Border DockPanel.Dock="Left" Width="190"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,1,0"
                    Background="#F8FAFC">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F4F6F7"
                            Padding="12,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <TextBlock Text="Categories" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#0F172A"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TreeView x:Name="tree_categories"
                                  BorderThickness="0" Background="Transparent"
                                  Padding="4"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Right: Grid area -->
            <DockPanel>
                <!-- Sub-header: count + select buttons -->
                <Border DockPanel.Dock="Top" Padding="12,6"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock x:Name="txt_result_count"
                                   Text="0 families found"
                                   VerticalAlignment="Center"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#0F172A"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                    HorizontalAlignment="Right">
                            <Button x:Name="btn_select_all"
                                    Content="Select All"
                                    Style="{StaticResource SmallBtn}"
                                    Margin="0,0,6,0"/>
                            <Button x:Name="btn_select_none"
                                    Content="Select None"
                                    Style="{StaticResource SmallBtnGrey}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Family cards — reference-style layout -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Padding="10,10,10,6">
                    <ItemsControl x:Name="items_families">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Per-card container: card border + name below -->
                                <StackPanel Width="155" Margin="5,5,5,2">

                                    <!-- Card — reference style: rounded border, thumbnail fills it -->
                                    <Border Height="148" CornerRadius="8" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Style.Triggers>
                                                    <!-- Blue border + slightly thicker when selected -->
                                                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#0F172A"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#0F172A"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <!-- Grey background so empty thumbnail area looks clean -->
                                            <Border Background="#F8FAFC" CornerRadius="7" Margin="1"/>
                                            <!-- Thumbnail image -->
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="Uniform" Margin="10"/>
                                            <!-- Checkbox overlay — top left -->
                                            <CheckBox IsChecked="{Binding IsChecked}"
                                                      VerticalAlignment="Top"
                                                      HorizontalAlignment="Left"
                                                      Margin="7,7,0,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- Name below the card border (like reference image) -->
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="11" Foreground="#0F172A"
                                               TextWrapping="Wrap" MaxHeight="34"
                                               Margin="3,4,3,0"
                                               ToolTip="{Binding FullPath}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>

        <!-- ══ ROW 4 — FOOTER ═══════════════════════ -->
        <Border Grid.Row="4" Background="White"
                BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                Padding="16,10">
            <DockPanel VerticalAlignment="Center">
                <!-- Buttons right -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock x:Name="txt_selected_count"
                               Text="0 families selected"
                               VerticalAlignment="Center"
                               Margin="0,0,18,0"
                               FontSize="12" Foreground="#64748B"/>
                    <Button x:Name="btn_load"
                            Content="Load"
                            Style="{StaticResource LoadBtn}"
                            Margin="0,0,10,0"
                            IsEnabled="False"/>
                    <Button x:Name="btn_cancel"
                            Content="Cancel"
                            Style="{StaticResource CancelBtn}"/>
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</Grid>
