<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="T3Lab - Family Management"
        Width="1100" Height="700"
        MinWidth="900" MinHeight="600"
        Background="White"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        FontFamily="Inter">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ═══ T3LAB SHARED STYLES v2 — AUTO-SYNCED, DO NOT EDIT (edit lib/GUI/Resources/WPF_styles.xaml, then run dev/sync_wpf_styles.py) ═══ -->
        <!-- PRIMARY BUTTON - solid deep slate, white text -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#0F172A"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0F172A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SECONDARY BUTTON - ghost style, border and text deep slate -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#0F172A"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#0F172A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SUCCESS BUTTON - emerald green -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#10B981"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#047857"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DANGER BUTTON - rose red -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EF4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B91C1C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ACCENT BUTTON - refined blue -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- WINDOW CONTROL BUTTON -->
        <Style x:Key="WinCtrlButton" TargetType="Button">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CLOSE BUTTON - rose red on hover, glyph flips to white -->
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WinCtrlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ═══ END T3LAB SHARED STYLES ═══ -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>       <!-- Title bar -->
            <RowDefinition Height="Auto"/>     <!-- Tab control navigation -->
            <RowDefinition Height="*"/>        <!-- Main content (Sidebar + Content) -->
            <RowDefinition Height="Auto"/>     <!-- Action bar -->
            <RowDefinition Height="Auto"/>     <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══ TITLE BAR ═══ -->
        <Grid Grid.Row="0" Height="64" Background="White">
            <StackPanel Orientation="Vertical" Margin="16,0,0,0" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="T3Lab" FontSize="11" FontWeight="Bold" Foreground="#0F172A"
                               VerticalAlignment="Bottom" Margin="0,0,6,3"/>
                    <TextBlock Text="Family Management" FontSize="18" FontWeight="Bold"
                               Foreground="#0F172A"/>
                </StackPanel>
                <Separator Height="1" Background="#E2E8F0" Margin="0,2,0,2"/>
                <TextBlock Text="Rename families, manage types, customize prefixes/suffixes, change case, and update worksets"
                           FontSize="10" Foreground="#64748B" FontStyle="Italic"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="btn_minimize" Style="{StaticResource WinCtrlButton}"
                        Click="minimize_button_clicked" ToolTip="Minimize">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Name="btn_maximize" Style="{StaticResource WinCtrlButton}"
                        Click="maximize_button_clicked" ToolTip="Maximize">
                    <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button x:Name="btn_close" Style="{StaticResource CloseButton}"
                        Click="close_button_clicked" ToolTip="Close">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </StackPanel>

            <Border Height="1" VerticalAlignment="Bottom" Background="#E2E8F0"/>
        </Grid>

        <!-- ═══ NAVIGATION TABS ═══ -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Height="40">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                <Button x:Name="tab_export" Content="Export" Click="tab_click" Width="80" Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand" FontWeight="Medium" FontSize="12"/>
                <Button x:Name="tab_import" Content="Import" Click="tab_click" Width="80" Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand" FontWeight="Medium" FontSize="12"/>
                <Button x:Name="tab_edit" Content="Edit" Click="tab_click" Width="80" Background="Transparent" Foreground="#3B82F6" BorderThickness="0,0,0,2" BorderBrush="#3B82F6" Cursor="Hand" FontWeight="SemiBold" FontSize="12"/>
                <Button x:Name="tab_worksets" Content="Worksets" Click="tab_click" Width="80" Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand" FontWeight="Medium" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- ═══ MAIN WORKSPACE GRID ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/> <!-- Left Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Right Content area -->
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>      <!-- Scrollable forms -->
                        <RowDefinition Height="Auto"/>   <!-- Clear button footer -->
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <Border Padding="16,12" Margin="0,0,0,10">
                            <StackPanel>
                            <!-- Scope Selector -->
                            <TextBlock Text="SCOPE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                            <StackPanel Margin="0,0,0,14">
                                <RadioButton x:Name="rb_scope_all" Content=" All Loaded Families" IsChecked="True" Checked="scope_changed" Height="24" FontSize="12" FontFamily="Inter" Foreground="#0F172A"/>
                                <RadioButton x:Name="rb_scope_view" Content=" Active View Only" Checked="scope_changed" Height="24" FontSize="12" FontFamily="Inter" Foreground="#0F172A"/>
                                <RadioButton x:Name="rb_scope_selection" Content=" Currently Selected" Checked="scope_changed" Height="24" FontSize="12" FontFamily="Inter" Foreground="#0F172A"/>
                            </StackPanel>
                            <Separator Background="#E2E8F0" Margin="0,0,0,12"/>

                            <!-- Categories Dropdown -->
                            <TextBlock Text="FAMILIES CATEGORY" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cb_category" SelectedIndex="0" SelectionChanged="category_changed" Margin="0,0,0,14" FontFamily="Inter" FontSize="12" Padding="6,4">
                                <ComboBoxItem Content="Loadable Families"/>
                                <ComboBoxItem Content="System Families"/>
                                <ComboBoxItem Content="Model Groups"/>
                                <ComboBoxItem Content="Assemblies"/>
                            </ComboBox>
                            <Separator Background="#E2E8F0" Margin="0,0,0,12"/>

                            <!-- Find and Replace Section -->
                            <TextBlock Text="FIND AND REPLACE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="tb_find" Grid.Column="0" Height="28" Padding="6,4" FontSize="12" BorderBrush="#CBD5E1"/>
                                <ToggleButton x:Name="btn_match_case" Grid.Column="1" Margin="4,0,0,0" ToolTip="Match Case" Click="match_case_click">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Background" Value="#DBEAFE"/>
                                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsChecked" Value="True"/>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter Property="Background" Value="#BFDBFE"/>
                                                </MultiTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <TextBlock Text="Aa" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0F172A"/>
                                </ToggleButton>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Find Next" Click="find_next_click" Height="26" Margin="0,0,4,0" Style="{StaticResource SecondaryButton}" Padding="4,2" FontSize="11"/>
                                <Button Grid.Column="1" Content="Find All" Click="find_all_click" Height="26" Margin="4,0,0,0" Style="{StaticResource SecondaryButton}" Padding="4,2" FontSize="11"/>
                            </Grid>

                            <TextBox x:Name="tb_replace" Height="28" Padding="6,4" FontSize="12" BorderBrush="#CBD5E1" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Replace" Click="replace_click" Height="26" Margin="0,0,4,0" Style="{StaticResource SecondaryButton}" Padding="4,2" FontSize="11"/>
                                <Button Grid.Column="1" Content="Replace All" Click="replace_all_click" Height="26" Margin="4,0,0,0" Style="{StaticResource SecondaryButton}" Padding="4,2" FontSize="11"/>
                            </Grid>
                            <Separator Background="#E2E8F0" Margin="0,0,0,12"/>

                            <!-- Prefix / Suffix Section -->
                            <TextBlock Text="PREFIX / SUFFIX" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                            <TextBlock Text="Prefix" FontSize="11" Foreground="#0F172A" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="tb_prefix" Grid.Column="0" Height="28" Padding="6,4" FontSize="12" BorderBrush="#CBD5E1"/>
                                <Button Content="Sel" Click="prefix_selected_click" Grid.Column="1" Width="36" Height="28" Margin="4,0,0,0" Style="{StaticResource SecondaryButton}" Padding="0" FontSize="11"/>
                                <Button Content="All" Click="prefix_all_click" Grid.Column="2" Width="36" Height="28" Margin="4,0,0,0" Style="{StaticResource SecondaryButton}" Padding="0" FontSize="11"/>
                            </Grid>

                            <TextBlock Text="Suffix" FontSize="11" Foreground="#0F172A" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="tb_suffix" Grid.Column="0" Height="28" Padding="6,4" FontSize="12" BorderBrush="#CBD5E1"/>
                                <Button Content="Sel" Click="suffix_selected_click" Grid.Column="1" Width="36" Height="28" Margin="4,0,0,0" Style="{StaticResource SecondaryButton}" Padding="0" FontSize="11"/>
                                <Button Content="All" Click="suffix_all_click" Grid.Column="2" Width="36" Height="28" Margin="4,0,0,0" Style="{StaticResource SecondaryButton}" Padding="0" FontSize="11"/>
                            </Grid>
                            <Separator Background="#E2E8F0" Margin="0,0,0,12"/>

                            <!-- Change Case Section -->
                            <TextBlock Text="CHANGE CASE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                            <ComboBox x:Name="cb_case_target" SelectedIndex="0" Margin="0,0,0,8" FontFamily="Inter" FontSize="11" Padding="6,4">
                                <ComboBoxItem Content="Both Family &amp; Type"/>
                                <ComboBoxItem Content="Family Name only"/>
                                <ComboBoxItem Content="Type Name only"/>
                            </ComboBox>
                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="UPPER" Click="case_upper_click" Grid.Row="0" Grid.Column="0" Height="26" Margin="0,0,4,0" Style="{StaticResource SecondaryButton}" Padding="4,2" FontSize="11"/>
                                <Button Content="lower" Click="case_lower_click" Grid.Row="0" Grid.Column="1" Height="26" Margin="4,0,0,0" Style="{StaticResource SecondaryButton}" Padding="4,2" FontSize="11"/>
                                <Button Content="Title" Click="case_title_click" Grid.Row="2" Grid.Column="0" Height="26" Margin="0,0,4,0" Style="{StaticResource SecondaryButton}" Padding="4,2" FontSize="11"/>
                                <Button Content="Sentence" Click="case_sentence_click" Grid.Row="2" Grid.Column="1" Height="26" Margin="4,0,0,0" Style="{StaticResource SecondaryButton}" Padding="4,2" FontSize="11"/>
                            </Grid>

                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <!-- Sidebar Footer: Clear Button -->
                    <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,8" Background="White">
                        <Button Content="Clear All Settings" Click="clear_settings_click" Height="32" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT CONTENT AREA -->
            <Grid Grid.Column="1" Background="#F8FAFC">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>   <!-- Toolbar -->
                    <RowDefinition Height="*"/>    <!-- DataGrid -->
                </Grid.RowDefinitions>

                <!-- TOOLBAR -->
                <Grid Grid.Row="0" Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="tb_search" Width="250" Height="28" Padding="6,2" FontSize="12" BorderBrush="#CBD5E1" VerticalAlignment="Center" ToolTip="Filter rows..." TextChanged="search_changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0">
                        <Button x:Name="btn_refresh" Click="refresh_click" Width="32" Height="28" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" ToolTip="Refresh DataGrid" Padding="0">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="btn_export_list" Content="Export List" Click="export_list_click" Height="28" Style="{StaticResource SecondaryButton}" Padding="10,2" FontSize="11"/>
                    </StackPanel>

                    <Border Height="1" VerticalAlignment="Bottom" Background="#E2E8F0" Grid.ColumnSpan="3"/>
                </Grid>

                <!-- DATAGRID -->
                <DataGrid x:Name="dg_families" Grid.Row="1" Margin="16,12"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                          AlternatingRowBackground="#F8FAFC" FontFamily="Inter" FontSize="12"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EFF2F2" SelectionMode="Extended"
                          VerticalScrollBarVisibility="Auto">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"      Value="#F8FAFC"/>
                            <Setter Property="Foreground"      Value="#0F172A"/>
                            <Setter Property="FontWeight"      Value="SemiBold"/>
                            <Setter Property="Padding"         Value="8,6"/>
                            <Setter Property="BorderBrush"     Value="#E2E8F0"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Height"          Value="34"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- Checkbox Select -->
                        <DataGridTemplateColumn Header="&#x2713;" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Family Name (Editable but shows staged name) -->
                        <DataGridTextColumn Header="Family Name" Binding="{Binding FamilyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>

                        <!-- Type Name (Editable) -->
                        <DataGridTextColumn Header="Type Name" Binding="{Binding TypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>

                        <!-- Category -->
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="150" IsReadOnly="True"/>

                        <!-- Workset (Combo editable) -->
                        <DataGridTemplateColumn Header="Workset" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Path=DataContext.Worksets}"
                                              SelectedValue="{Binding WorksetId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="Name" SelectedValuePath="Id"
                                              FontFamily="Inter" FontSize="11" Padding="4,2" Height="24"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Delete action -->
                        <DataGridTemplateColumn Header="Action" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Click="delete_row_click" Style="{StaticResource WinCtrlButton}" Width="28" Height="24" ToolTip="Remove from list" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#EF4444"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- ═══ ACTION BAR ═══ -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Select All" Click="select_all_click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="Deselect All" Click="deselect_all_click" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Undo" Click="undo_click" Style="{StaticResource SecondaryButton}" Width="80" Margin="0,0,8,0"/>
                    <Button Content="Apply" Click="apply_click" Style="{StaticResource SuccessButton}" Width="100"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ STATUS BAR ═══ -->
        <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="status_text" Grid.Column="0" FontSize="11" Foreground="#64748B" Text="Ready"/>
                <TextBlock x:Name="count_text" Grid.Column="1" FontSize="11" Foreground="#64748B" Text="Total number of elements found 0 | Selected 0"/>
            </Grid>
        </Border>

        <!-- Copyright added automatically -->
        <TextBlock Text="© Copyright by T3Lab" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,8" Foreground="#F59E0B" FontSize="11" IsHitTestVisible="False" Panel.ZIndex="999"/>
    </Grid>
</Window>
