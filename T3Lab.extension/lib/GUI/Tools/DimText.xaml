<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="T3Lab - Dim Text"
        Width="460" Height="580"
        MinWidth="400" MinHeight="500"
        Background="White"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        FontFamily="Inter">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#083D56"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#062A3C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#546E7A"/>
                    <Setter Property="Cursor"     Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#F8F9FA"/>
            <Setter Property="Foreground"      Value="#2C3E50"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#546E7A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E6EA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#27AE60"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E8449"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#546E7A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#D32F2F"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B71C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WinCtrlButton" TargetType="Button">
            <Setter Property="Width"           Value="40"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8F9FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WinCtrlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D32F2F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetButton" TargetType="Button">
            <Setter Property="Background"      Value="#F8F9FA"/>
            <Setter Property="Foreground"      Value="#2C3E50"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#546E7A"/>
            <Setter Property="Margin"          Value="0,0,6,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E6EA"/>
                    <Setter Property="BorderBrush" Value="#083D56"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="#2C3E50"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width"           Value="90"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="FontFamily"      Value="Inter"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#2C3E50"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#546E7A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#083D56"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="#083D56"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ TITLE BAR ═══ -->
        <Grid Grid.Row="0" Height="64" Background="White">
            <StackPanel Orientation="Vertical" Margin="16,0,0,0" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="T3Lab" FontSize="11" FontWeight="Bold" Foreground="#083D56"
                               VerticalAlignment="Bottom" Margin="0,0,6,3"/>
                    <TextBlock Text="Dim Text" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>
                <Separator Height="1" Background="#546E7A" Margin="0,2,0,2"/>
                <TextBlock Text="Edit dimension text overrides on selected dimensions"
                           FontSize="10" Foreground="#7F8C8D" FontStyle="Italic"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="btn_minimize" Style="{StaticResource WinCtrlButton}"
                        Click="minimize_button_clicked" ToolTip="Minimize">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#083D56"/>
                </Button>
                <Button x:Name="btn_maximize" Style="{StaticResource WinCtrlButton}"
                        Click="maximize_button_clicked" ToolTip="Maximize">
                    <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#083D56"/>
                </Button>
                <Button x:Name="btn_close" Style="{StaticResource CloseButton}"
                        Click="close_button_clicked" ToolTip="Close">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#083D56"/>
                </Button>
            </StackPanel>

            <Border Height="1" VerticalAlignment="Bottom" Background="#546E7A"/>
        </Grid>

        <!-- ═══ CONTENT ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,14,16,0">
            <StackPanel>

                <!-- Text Fields -->
                <TextBlock Text="TEXT FIELDS" Style="{StaticResource SectionHeader}"/>
                <Border Background="#F8F9FA" BorderBrush="#546E7A" BorderThickness="1"
                        CornerRadius="3" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Prefix -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Prefix:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txt_prefix" Style="{StaticResource InputBox}" Width="280"/>
                        </StackPanel>
                        <!-- Suffix -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Suffix:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txt_suffix" Style="{StaticResource InputBox}" Width="280"/>
                        </StackPanel>
                        <!-- Above -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Above:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txt_above" Style="{StaticResource InputBox}" Width="280"/>
                        </StackPanel>
                        <!-- Below -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Below:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txt_below" Style="{StaticResource InputBox}" Width="280"/>
                        </StackPanel>
                        <!-- Value Override -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Override:" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txt_override" Style="{StaticResource InputBox}" Width="280"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Presets -->
                <TextBlock Text="PRESETS — BELOW" Style="{StaticResource SectionHeader}"/>
                <Border Background="#F8F9FA" BorderBrush="#546E7A" BorderThickness="1"
                        CornerRadius="3" Padding="12,10" Margin="0,0,0,12">
                    <WrapPanel x:Name="wrap_presets">
                        <Button Content="CEILING HEIGHT"    Style="{StaticResource PresetButton}" Tag="CEILING HEIGHT"    Click="preset_below_clicked"/>
                        <Button Content="CLEAR"             Style="{StaticResource PresetButton}" Tag="CLEAR"             Click="preset_below_clicked"/>
                        <Button Content="V.I.F"             Style="{StaticResource PresetButton}" Tag="V.I.F"             Click="preset_below_clicked"/>
                        <Button Content="(E)"               Style="{StaticResource PresetButton}" Tag="(E)"               Click="preset_below_clicked"/>
                        <Button Content="M&amp;E SPACE"     Style="{StaticResource PresetButton}" Tag="M&amp;E SPACE"     Click="preset_below_clicked"/>
                        <Button Content="CANOPY TO SLAB"    Style="{StaticResource PresetButton}" Tag="CANOPY TO SLAB"    Click="preset_below_clicked"/>
                        <Button Content="CLEAR HEIGHT"      Style="{StaticResource PresetButton}" Tag="CLEAR HEIGHT"      Click="preset_below_clicked"/>
                    </WrapPanel>
                </Border>

                <!-- Options -->
                <TextBlock Text="OPTIONS" Style="{StaticResource SectionHeader}"/>
                <Border Background="#F8F9FA" BorderBrush="#546E7A" BorderThickness="1"
                        CornerRadius="3" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Leader toggle -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="chk_leader" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Turn off leader" FontSize="12" Foreground="#2C3E50" FontWeight="SemiBold"/>
                                <TextBlock Text="Removes leader lines from selected dimensions"
                                           FontSize="10" Foreground="#7F8C8D"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Scope -->
                        <TextBlock Text="Apply to:" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#2C3E50" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="rb_selection" Content="Selection only" IsChecked="True"
                                         FontSize="12" Foreground="#2C3E50" Margin="0,0,20,0"
                                         VerticalAlignment="Center"/>
                            <RadioButton x:Name="rb_view" Content="All dims in active view"
                                         FontSize="12" Foreground="#2C3E50"
                                         VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Filter by Segment Length -->
                <TextBlock Text="FILTER BY LENGTH" Style="{StaticResource SectionHeader}"/>
                <Border Background="#F8F9FA" BorderBrush="#546E7A" BorderThickness="1"
                        CornerRadius="3" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Enable toggle -->
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="chk_filter_enable" VerticalAlignment="Center" Margin="0,0,8,0"
                                      Checked="filter_toggle" Unchecked="filter_toggle"/>
                            <StackPanel>
                                <TextBlock Text="Enable segment length filter" FontSize="12"
                                           Foreground="#2C3E50" FontWeight="SemiBold"/>
                                <TextBlock Text="Apply text only to segments that match the rules below"
                                           FontSize="10" Foreground="#7F8C8D"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Filter config (shown when enabled) -->
                        <StackPanel x:Name="sp_filter_config" Visibility="Collapsed" Margin="0,10,0,0">
                            <!-- AND / OR operator + Add Rule button -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ComboBox x:Name="combo_combine" Width="230" Height="28"
                                          FontFamily="Inter" FontSize="12">
                                    <ComboBoxItem Content="AND (All rules must be true)" IsSelected="True"/>
                                    <ComboBoxItem Content="OR (Any rule may be true)"/>
                                </ComboBox>
                                <Button Content="+ Add Rule" Style="{StaticResource SecondaryButton}"
                                        Click="add_rule_clicked" Margin="8,0,0,0" Height="28" Padding="10,4"/>
                            </StackPanel>
                            <!-- Dynamic rule rows injected here from Python -->
                            <StackPanel x:Name="sp_rules"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Clear shortcut -->
                <Border BorderBrush="#083D56" Background="#F8F9FA" CornerRadius="2" Padding="10" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tip: " FontWeight="Bold" Foreground="#062A3C" FontSize="11"/>
                        <TextBlock FontSize="11" Foreground="#2C3E50" TextWrapping="Wrap"
                                   Text="Leave all fields empty and click Apply to clear all text overrides on selected dimensions."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ ACTION BAR ═══ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#546E7A" BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="btn_clear_fields" Content="Clear Fields"
                            Style="{StaticResource SecondaryButton}"
                            Click="clear_fields_clicked" Margin="0,0,8,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_cancel" Content="Cancel"
                            Style="{StaticResource SecondaryButton}"
                            Click="close_button_clicked" Margin="0,0,8,0"/>
                    <Button x:Name="btn_apply" Content="Apply"
                            Style="{StaticResource SuccessButton}"
                            Click="apply_clicked" MinWidth="90"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ STATUS BAR ═══ -->
        <Border Grid.Row="3" Background="#F8F9FA" BorderBrush="#546E7A" BorderThickness="0,1,0,0"
                Padding="14,8">
            <TextBlock x:Name="lbl_status" Text="Ready — select dimensions in Revit then click Apply"
                       FontSize="11" Foreground="#7F8C8D"/>
        </Border>

        <!-- Copyright -->
        <TextBlock Text="© Copyright by T3Lab" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,8" Foreground="#3498DB" FontSize="11" IsHitTestVisible="False" Panel.ZIndex="999"/>
    </Grid>
</Window>
